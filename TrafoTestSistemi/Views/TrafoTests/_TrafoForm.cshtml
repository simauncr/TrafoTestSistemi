<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57) && charCode != 44 && charCode != 46) return false;
        return true;
    }

    function applyColorWarning(inputElement, val) {
        const input = $(inputElement);
        if (val > 0) {
            input.removeClass("out-ht-warning out-ht-green").addClass("out-ht-red");
        } else if (val < 0) {
            input.removeClass("out-ht-red out-ht-green").addClass("out-ht-warning");
        } else {
            input.removeClass("out-ht-red out-ht-warning out-ht-green");
        }
    }

    function calculateGeneral() {
        $(".sargi-row").each(function() {
            const row = $(this);
            const prefix = row.data("prefix");
            const getVal = (id) => {
                let v = row.find(`[name$='${prefix}_${id}']`).val();
                return (v && v.trim() !== "") ? parseFloat(v.toString().replace(',', '.')) : null;
            };

            const setVal = (selector, h, t) => {
                const el = row.find(selector);
                if (h !== null && t !== null) {
                    const diff = (t - h).toFixed(2);
                    el.val(diff);
                    applyColorWarning(el, parseFloat(diff));
                } else {
                    el.val("").removeClass("out-ht-red out-ht-warning out-ht-green");
                }
            };

            setVal("[name$='Sapma_IcCap_K']", getVal("IcCap_K_Hesap"), getVal("IcCap_K_Test"));
            setVal("[name$='Sapma_IcCap_U']", getVal("IcCap_U_Hesap"), getVal("IcCap_U_Test"));
            setVal("[name$='Sapma_DisCap_K']", getVal("DisCap_K_Hesap"), getVal("DisCap_K_Test"));
            setVal("[name$='Sapma_DisCap_U']", getVal("DisCap_U_Hesap"), getVal("DisCap_U_Test"));

            const vHhK = getVal("DisCap_K_Hesap"); const vHiK = getVal("IcCap_K_Hesap");
            const vThK = getVal("DisCap_K_Test");  const vTiK = getVal("IcCap_K_Test");
            const radKEl = row.find("[name$='Sapma_Radyal_K']");
            if(vHhK !== null && vHiK !== null && vThK !== null && vTiK !== null) {
                const diff = ((vThK - vTiK) - (vHhK - vHiK)).toFixed(2);
                radKEl.val(diff);
                applyColorWarning(radKEl, parseFloat(diff));
            } else { radKEl.val("").removeClass("out-ht-red out-ht-warning out-ht-green"); }

            const vHhU = getVal("DisCap_U_Hesap"); const vHiU = getVal("IcCap_U_Hesap");
            const vThU = getVal("DisCap_U_Test");  const vTiU = getVal("IcCap_U_Test");
            const radUEl = row.find("[name$='Sapma_Radyal_U']");
            if(vHhU !== null && vHiU !== null && vThU !== null && vTiU !== null) {
                const diff = ((vThU - vTiU) - (vHhU - vHiU)).toFixed(2);
                radUEl.val(diff);
                applyColorWarning(radUEl, parseFloat(diff));
            } else { radUEl.val("").removeClass("out-ht-red out-ht-warning out-ht-green"); }
        });

        $(".weight-row").each(function() {
            const row = $(this);
            const h = parseFloat(row.find(".val-h").val()?.toString().replace(',', '.')) || null;
            const t = parseFloat(row.find(".val-t").val()?.toString().replace(',', '.')) || null;
            const out = row.find(".out-w-sapma");
            if (h !== null && t !== null) {
                const diff = (t - h).toFixed(2);
                out.val(diff);
                applyColorWarning(out, parseFloat(diff));
            } else {
                out.val("").removeClass("out-ht-red out-ht-warning out-ht-green");
            }
        });

        $(".calc-row").each(function () {
            const row = $(this);
            const getVal = (sel) => {
                let v = row.find(sel).val();
                return (v && v.trim() !== "") ? parseFloat(v.toString().replace(',', '.')) : null;
            };
            const gar = getVal(".val-garanti");
            const hes = getVal(".val-hesap");
            const tst = getVal(".val-test");
            const tolInput = row.find(".val-tolerans");
            let tolPercent = tolInput.length > 0 ? (parseFloat(tolInput.val()?.toString().replace(',', '.')) || 0) : null;

            if (gar !== null && gar !== 0) {
                if(hes !== null) row.find(".out-gh").val(((hes - gar) / gar * 100).toFixed(2));
                if(tst !== null) row.find(".out-gt").val(((tst - gar) / gar * 100).toFixed(2));
            }

            const htInput = row.find(".out-ht");
            if (hes !== null && tst !== null && hes !== 0) {
                const ht = ((tst - hes) / hes * 100).toFixed(2);
                htInput.val(ht);

                if (tolPercent !== null) {
                    const limitMiktari = Math.abs(hes * (tolPercent / 100));
                    const farkMiktari = Math.abs(tst - hes);
                    if (farkMiktari > limitMiktari) {
                        htInput.removeClass("out-ht-green").addClass("out-ht-red");
                    } else {
                        htInput.removeClass("out-ht-red").addClass("out-ht-green");
                    }
                } else {
                    if (gar !== null && tst > gar) {
                        htInput.removeClass("out-ht-green").addClass("out-ht-red");
                    } else {
                        htInput.removeClass("out-ht-red").addClass("out-ht-green");
                    }
                }
            } else {
                htInput.removeClass("out-ht-red out-ht-green").val("");
            }
        });
    }

    $(document).on("keypress", ".numeric-input", function (evt) { if (!isNumberKey(evt)) evt.preventDefault(); });
    $(document).on("input", "input", calculateGeneral);
    $(document).ready(calculateGeneral);
</script>