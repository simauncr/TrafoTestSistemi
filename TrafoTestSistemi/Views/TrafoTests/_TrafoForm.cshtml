                <td class="d-flex border-0"><input asp-for="Pk_Garanti" class="form-control me-1 val-garanti numeric-input" /><input asp-for="Pk_Tolerans" class="form-control val-tolerans numeric-input" /></td>
                <td><input asp-for="Pk_Hesap" class="form-control val-hesap numeric-input" /></td>
                <td><input asp-for="Pk_Test" class="form-control val-test numeric-input" /></td>
                <td><input asp-for="Pk_Sapma_GH" class="form-control out-gh" readonly /></td>
