@model TrafoTestSistemi.Models.TrafoTest
@{
    var muhendisSecenekleri = new List<string>();
    var seciliElektrikMuhendisi = Model?.ElektrikMuhendisiAdSoyad ?? string.Empty;
    var seciliMekanikMuhendisi = Model?.MekanikMuhendisiAdSoyad ?? string.Empty;

    if (ViewBag.MuhendisListesi is IEnumerable<string> stringList)
    {
        muhendisSecenekleri = stringList.ToList();
    }
    else if (ViewBag.MuhendisListesi is IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> selectList)
    {
        muhendisSecenekleri = selectList
            .Select(x => x.Value ?? x.Text)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .ToList();
    }
}

<style>
    .required-label::after {
        content: " *";
        color: #ea5455;
        font-weight: bold;
    }

    .table-xs {
        font-size: 0.72rem;
    }

        .table-xs input, .table-xs select {
            font-size: 0.72rem !important;
            padding: 0.28rem 0.45rem !important;
            min-height: 34px !important;
            text-align: center;
        }

    .trafo-form-shell {
        display: block;
    }

    .trafo-form-shell .table-responsive {
        border: 1px solid var(--app-border);
        border-top: 0;
        border-bottom-left-radius: 0.9rem;
        border-bottom-right-radius: 0.9rem;
        background: var(--app-surface);
        box-shadow: 0 0.35rem 1rem rgba(161, 172, 184, 0.12);
        overflow: hidden;
    }

    .trafo-panel {
        margin-bottom: 1.25rem;
    }

    .trafo-panel summary {
        list-style: none;
        cursor: pointer;
    }

    .trafo-panel summary::-webkit-details-marker {
        display: none;
    }

    .bg-sapma {
        background-color: var(--app-surface-muted);
        font-weight: bold;
    }

    .section-title {
        font-size: 0.76rem;
        font-weight: bold;
        text-transform: uppercase;
        margin-bottom: 0px;
        padding: 0.75rem 1rem;
        background: linear-gradient(180deg, rgba(var(--app-primary-rgb), 0.12), rgba(var(--app-primary-rgb), 0.06));
        color: var(--app-heading);
        border: 1px solid var(--app-border);
        border-bottom: none;
        border-top-left-radius: 0.9rem;
        border-top-right-radius: 0.9rem;
        letter-spacing: 0.08em;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .section-title::after {
        content: "\f107";
        font-family: "Font Awesome 6 Free";
        font-weight: 900;
        font-size: 0.9rem;
        color: var(--app-primary);
        transition: transform .18s ease;
    }

    .trafo-panel[open] .section-title::after {
        transform: rotate(180deg);
    }

    .trafo-panel:not([open]) .section-title {
        border-bottom: 1px solid var(--app-border);
        border-radius: 0.9rem;
    }

    .trafo-panel:not([open]) .table-responsive {
        display: none;
    }

    .table-bordered td, .table-bordered th {
        border: 1px solid var(--app-border) !important;
    }

    .table-xs thead th {
        background: rgba(var(--app-primary-rgb), 0.05);
    }

    .table-xs tbody td:first-child {
        background: rgba(var(--app-primary-rgb), 0.028);
    }

    .trafo-form-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 1.1rem;
        border: 1px solid var(--app-border);
        border-radius: 0.9rem;
        background: rgba(var(--app-primary-rgb), 0.035);
        box-shadow: 0 0.35rem 1rem rgba(161, 172, 184, 0.08);
    }

    .trafo-form-actions__meta {
        color: var(--app-muted);
        font-size: 0.84rem;
        max-width: 520px;
    }

    .out-ht-warning {
        background-color: rgba(var(--bs-warning-rgb), 0.25) !important;
        color: var(--app-heading) !important;
        font-weight: bold;
    }

    .out-ht-green {
        background-color: rgba(var(--bs-success-rgb), 0.85) !important;
        color: var(--bs-white) !important;
        font-weight: bold;
    }

    .out-ht-red {
        background-color: rgba(var(--bs-danger-rgb), 0.85) !important;
        color: var(--bs-white) !important;
        font-weight: bold;
    }

    @@media (max-width: 991.98px) {
        .trafo-form-actions {
            flex-direction: column;
            align-items: stretch;
        }
    }
</style>

<details class="trafo-panel" open>
<summary class="section-title">1. Genel Bilgiler</summary>
<div class="table-responsive">
    <table class="table table-sm table-bordered table-xs mb-0">
        <thead>
            <tr>
                <th class="required-label">Proje Adı</th>
                <th class="required-label">Tasarım No</th>
                <th class="required-label">Müşteri</th>
                <th>Dizayn Id</th>
                <th class="required-label">Elek. Müh.</th>
                <th class="required-label">Mek. Müh.</th>
                <th class="required-label">Dizayn Tarihi</th>
                <th class="required-label">Test Tarihi</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><input asp-for="ProjeAdi" id="ProjeAdi" class="form-control" required /></td>
                <td><input asp-for="TasarimNo" class="form-control" required /></td>
                <td><input asp-for="Musteri" class="form-control" required /></td>
                <td><input asp-for="DizaynId" class="form-control" /></td>
                <td>
                    <select asp-for="ElektrikMuhendisiAdSoyad" class="form-control" required>
                        <option value="">-- Seçiniz --</option>
                        @foreach (var ad in muhendisSecenekleri)
                        {
                            if (seciliElektrikMuhendisi == ad)
                            {
                                <option value="@ad" selected>@ad</option>
                            }
                            else
                            {
                                <option value="@ad">@ad</option>
                            }
                        }
                    </select>
                </td>
                <td>
                    <select asp-for="MekanikMuhendisiAdSoyad" class="form-control" required>
                        <option value="">-- Seçiniz --</option>
                        @foreach (var ad in muhendisSecenekleri)
                        {
                            if (seciliMekanikMuhendisi == ad)
                            {
                                <option value="@ad" selected>@ad</option>
                            }
                            else
                            {
                                <option value="@ad">@ad</option>
                            }
                        }
                    </select>
                </td>
                <td><input asp-for="DizaynTarihi" type="date" class="form-control" required /></td>
                <td><input asp-for="TestTarihi" type="date" class="form-control" required /></td>
            </tr>
        </tbody>
    </table>
</div>
</details>

<details class="trafo-panel" open>
<summary class="section-title">2. Dizayn Bilgileri</summary>
<div class="table-responsive">
    <table class="table table-sm table-bordered table-xs mb-0">
        <thead>
            <tr>
                <th class="required-label">Güç (kVA)</th>
                <th class="required-label">YG Gerilim</th>
                <th class="required-label">AG Gerilim</th>
                <th class="required-label">Bağlantı Grubu</th>
                <th class="required-label">Çekirdek Tipi</th>
                <th class="required-label">Sac Cinsi</th>
                <th class="required-label">Kazan Cinsi</th>
                <th class="required-label">Yağ Cinsi</th>
                <th class="required-label">Frekans</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><input asp-for="Guc" class="form-control numeric-input" required /></td>
                <td><input asp-for="GerilimYG" class="form-control numeric-input" required /></td>
                <td><input asp-for="GerilimAG" class="form-control numeric-input" required /></td>
                <td><input asp-for="BaglantiGrubu" class="form-control" required /></td>
                <td>
                    <select asp-for="CekirdekTipiId" asp-items="ViewBag.CekirdekTipleri" class="form-control" required>
                        <option value="">-- Seçiniz --</option>
                    </select>
                </td>
                <td>
                    <select asp-for="SacCinsiId" asp-items="ViewBag.SacCinsleri" class="form-control" required>
                        <option value="">-- Seçiniz --</option>
                    </select>
                </td>
                <td>
                    <select asp-for="KazanCinsiId" asp-items="ViewBag.KazanCinsleri" class="form-control" required>
                        <option value="">-- Seçiniz --</option>
                    </select>
                </td>
                <td>
                    <select asp-for="YagCinsiId" asp-items="ViewBag.YagCinsleri" class="form-control" required>
                        <option value="">-- Seçiniz --</option>
                    </select>
                </td>
                <td>
                    <select id="FrekansSelect" class="form-control">
                        <option value="50">50</option>
                        <option value="60">60</option>
                    </select>
                </td>
            </tr>
        </tbody>
    </table>
</div>
</details>

<details class="trafo-panel">
<summary class="section-title">3. Sargı Geometrisi</summary>
<div class="table-responsive">
    <table class="table table-sm table-bordered text-center table-xs mb-0" id="sargiTable">
        <thead>
            <tr>
                <th rowspan="3" class="align-middle">Bölüm</th>
                <th data-colspan-oval="4" data-colspan-yuvarlak="2" colspan="4">Hesap (mm)</th>
                <th data-colspan-oval="4" data-colspan-yuvarlak="2" colspan="4">Test (mm)</th>
                <th data-colspan-oval="6" data-colspan-yuvarlak="3" colspan="6">Sapma Değerleri (mm)</th>
            </tr>
            <tr>
                <th data-colspan-oval="2" data-colspan-yuvarlak="1" colspan="2">İç Çap</th>
                <th data-colspan-oval="2" data-colspan-yuvarlak="1" colspan="2">Dış Çap</th>
                <th data-colspan-oval="2" data-colspan-yuvarlak="1" colspan="2">İç Çap</th>
                <th data-colspan-oval="2" data-colspan-yuvarlak="1" colspan="2">Dış Çap</th>
                <th data-colspan-oval="2" data-colspan-yuvarlak="1" colspan="2">İç Çap</th>
                <th data-colspan-oval="2" data-colspan-yuvarlak="1" colspan="2" class="align-middle bg-warning bg-opacity-10">Radyal</th>
                <th data-colspan-oval="2" data-colspan-yuvarlak="1" colspan="2">Dış Çap</th>
            </tr>
            <tr>
                <th>K</th>
                <th class="col-u-sargi">U</th>
                <th>K</th>
                <th class="col-u-sargi">U</th>
                <th>K</th>
                <th class="col-u-sargi">U</th>
                <th>K</th>
                <th class="col-u-sargi">U</th>
                <th class="bg-sapma">K</th>
                <th class="bg-sapma col-u-sargi">U</th>
                <th class="bg-warning bg-opacity-10">K</th>
                <th class="bg-warning bg-opacity-10 col-u-sargi">U</th>
                <th class="bg-sapma">K</th>
                <th class="bg-sapma col-u-sargi">U</th>
            </tr>
        </thead>
        <tbody>
            <tr class="sargi-row" data-prefix="AG">
                <td class="fw-bold">AG</td>
                <td><input asp-for="AG_IcCap_K_Hesap" class="form-control numeric-input" /></td>
                <td class="col-u-sargi"><input asp-for="AG_IcCap_U_Hesap" class="form-control numeric-input u-sargi-input" /></td>
                <td><input asp-for="AG_DisCap_K_Hesap" class="form-control numeric-input" /></td>
                <td class="col-u-sargi"><input asp-for="AG_DisCap_U_Hesap" class="form-control numeric-input u-sargi-input" /></td>
                <td><input asp-for="AG_IcCap_K_Test" class="form-control numeric-input" /></td>
                <td class="col-u-sargi"><input asp-for="AG_IcCap_U_Test" class="form-control numeric-input u-sargi-input" /></td>
                <td><input asp-for="AG_DisCap_K_Test" class="form-control numeric-input" /></td>
                <td class="col-u-sargi"><input asp-for="AG_DisCap_U_Test" class="form-control numeric-input u-sargi-input" /></td>
                <td><input asp-for="AG_Sapma_IcCap_K" class="form-control bg-sapma out-s-val" readonly /></td>
                <td class="col-u-sargi"><input asp-for="AG_Sapma_IcCap_U" class="form-control bg-sapma out-s-val u-sargi-input" readonly /></td>
                <td><input asp-for="AG_Sapma_Radyal_K" class="form-control bg-warning bg-opacity-10 out-s-val" readonly /></td>
                <td class="col-u-sargi"><input asp-for="AG_Sapma_Radyal_U" class="form-control bg-warning bg-opacity-10 out-s-val u-sargi-input" readonly /></td>
                <td><input asp-for="AG_Sapma_DisCap_K" class="form-control bg-sapma out-s-val" readonly /></td>
                <td class="col-u-sargi"><input asp-for="AG_Sapma_DisCap_U" class="form-control bg-sapma out-s-val u-sargi-input" readonly /></td>
            </tr>
            <tr class="sargi-row" data-prefix="YG">
                <td class="fw-bold">YG</td>
                <td><input asp-for="YG_IcCap_K_Hesap" class="form-control numeric-input" /></td>
                <td class="col-u-sargi"><input asp-for="YG_IcCap_U_Hesap" class="form-control numeric-input u-sargi-input" /></td>
                <td><input asp-for="YG_DisCap_K_Hesap" class="form-control numeric-input" /></td>
                <td class="col-u-sargi"><input asp-for="YG_DisCap_U_Hesap" class="form-control numeric-input u-sargi-input" /></td>
                <td><input asp-for="YG_IcCap_K_Test" class="form-control numeric-input" /></td>
                <td class="col-u-sargi"><input asp-for="YG_IcCap_U_Test" class="form-control numeric-input u-sargi-input" /></td>
                <td><input asp-for="YG_DisCap_K_Test" class="form-control numeric-input" /></td>
                <td class="col-u-sargi"><input asp-for="YG_DisCap_U_Test" class="form-control numeric-input u-sargi-input" /></td>
                <td><input asp-for="YG_Sapma_IcCap_K" class="form-control bg-sapma out-s-val" readonly /></td>
                <td class="col-u-sargi"><input asp-for="YG_Sapma_IcCap_U" class="form-control bg-sapma out-s-val u-sargi-input" readonly /></td>
                <td><input asp-for="YG_Sapma_Radyal_K" class="form-control bg-warning bg-opacity-10 out-s-val" readonly /></td>
                <td class="col-u-sargi"><input asp-for="YG_Sapma_Radyal_U" class="form-control bg-warning bg-opacity-10 out-s-val u-sargi-input" readonly /></td>
                <td><input asp-for="YG_Sapma_DisCap_K" class="form-control bg-sapma out-s-val" readonly /></td>
                <td class="col-u-sargi"><input asp-for="YG_Sapma_DisCap_U" class="form-control bg-sapma out-s-val u-sargi-input" readonly /></td>
            </tr>
        </tbody>
    </table>
</div>
</details>

<details class="trafo-panel">
<summary class="section-title">4. Ağırlık Bilgileri (kg)</summary>
<div class="table-responsive">
    <table class="table table-sm table-bordered text-center table-xs mb-0">
        <thead>
            <tr>
                <th style="width: 25%;">Açıklama</th>
                <th style="width: 25%;">Hesap</th>
                <th style="width: 25%;">Test</th>
                <th style="width: 25%;" class="bg-sapma">Sapma Değerleri (kg)</th>
            </tr>
        </thead>
        <tbody>
            <tr class="weight-row">
                <td class="fw-bold text-start ps-3">Çekirdek</td>
                <td><input asp-for="Cekirdek_Hesap" class="form-control numeric-input val-h" /></td>
                <td><input asp-for="Cekirdek_Test" class="form-control numeric-input val-t" /></td>
                <td><input asp-for="Cekirdek_Sapma" class="form-control bg-sapma out-w-sapma" readonly /></td>
            </tr>
            <tr class="weight-row">
                <td class="fw-bold text-start ps-3">AG İletken</td>
                <td><input asp-for="AGIletken_Hesap" class="form-control numeric-input val-h" /></td>
                <td><input asp-for="AGIletken_Test" class="form-control numeric-input val-t" /></td>
                <td><input asp-for="AGIletken_Sapma" class="form-control bg-sapma out-w-sapma" readonly /></td>
            </tr>
            <tr class="weight-row">
                <td class="fw-bold text-start ps-3">YG İletken</td>
                <td><input asp-for="YGIletken_Hesap" class="form-control numeric-input val-h" /></td>
                <td><input asp-for="YGIletken_Test" class="form-control numeric-input val-t" /></td>
                <td><input asp-for="YGIletken_Sapma" class="form-control bg-sapma out-w-sapma" readonly /></td>
            </tr>
            <tr class="weight-row">
                <td class="fw-bold text-start ps-3">Yağ</td>
                <td><input asp-for="Yag_Hesap" class="form-control numeric-input val-h" /></td>
                <td><input asp-for="Yag_Test" class="form-control numeric-input val-t" /></td>
                <td><input asp-for="Yag_Sapma" class="form-control bg-sapma out-w-sapma" readonly /></td>
            </tr>
        </tbody>
    </table>
</div>
</details>

