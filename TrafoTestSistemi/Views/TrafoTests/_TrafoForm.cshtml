</details>

<details class="trafo-panel">
<summary class="section-title">6. Sıcaklık Değerleri</summary>
<div class="table-responsive">
    <table class="table table-sm table-bordered text-center table-xs mb-0">
        <thead>
            <tr><th>Kategori</th><th>Garanti</th><th>Hesap</th><th>Test</th><th>Sapma GH</th><th>Sapma GT</th><th>Sapma HT</th></tr>
        </thead>
        <tbody>
            <tr class="calc-row">
                <td class="fw-bold bg-body-tertiary text-start">AG Gradient</td>
                <td><input asp-for="AG_Grad_Garanti" class="form-control val-garanti numeric-input" /></td>
                <td><input asp-for="AG_Grad_Hesap" class="form-control val-hesap numeric-input" /></td>
                <td><input asp-for="AG_Grad_Test" class="form-control val-test numeric-input" /></td>
                <td><input asp-for="AG_Grad_Sapma_GH" class="form-control out-gh" readonly /></td>
                <td><input asp-for="AG_Grad_Sapma_GT" class="form-control out-gt" readonly /></td>
                <td><input asp-for="AG_Grad_Sapma_HT" class="form-control out-ht" readonly /></td>
            </tr>
            <tr class="calc-row">
                <td class="fw-bold bg-body-tertiary text-start">YG Gradient</td>
                <td><input asp-for="YG_Grad_Garanti" class="form-control val-garanti numeric-input" /></td>
                <td><input asp-for="YG_Grad_Hesap" class="form-control val-hesap numeric-input" /></td>
                <td><input asp-for="YG_Grad_Test" class="form-control val-test numeric-input" /></td>
                <td><input asp-for="YG_Grad_Sapma_GH" class="form-control out-gh" readonly /></td>
                <td><input asp-for="YG_Grad_Sapma_GT" class="form-control out-gt" readonly /></td>
                <td><input asp-for="YG_Grad_Sapma_HT" class="form-control out-ht" readonly /></td>
            </tr>
            <tr class="calc-row">
                <td class="fw-bold bg-body-tertiary text-start">AG Sargı Isınması</td>
                <td><input asp-for="AG_SargiIsinma_Garanti" class="form-control val-garanti numeric-input" /></td>
                <td><input asp-for="AG_SargiIsinma_Hesap" class="form-control val-hesap numeric-input" /></td>
                <td><input asp-for="AG_SargiIsinma_Test" class="form-control val-test numeric-input" /></td>
                <td><input asp-for="AG_SargiIsinma_Sapma_GH" class="form-control out-gh" readonly /></td>
                <td><input asp-for="AG_SargiIsinma_Sapma_GT" class="form-control out-gt" readonly /></td>
                <td><input asp-for="AG_SargiIsinma_Sapma_HT" class="form-control out-ht" readonly /></td>
            </tr>
            <tr class="calc-row">
                <td class="fw-bold bg-body-tertiary text-start">YG Sargı Isınması</td>
                <td><input asp-for="YG_SargiIsinma_Garanti" class="form-control val-garanti numeric-input" /></td>
                <td><input asp-for="YG_SargiIsinma_Hesap" class="form-control val-hesap numeric-input" /></td>
                <td><input asp-for="YG_SargiIsinma_Test" class="form-control val-test numeric-input" /></td>
                <td><input asp-for="YG_SargiIsinma_Sapma_GH" class="form-control out-gh" readonly /></td>
                <td><input asp-for="YG_SargiIsinma_Sapma_GT" class="form-control out-gt" readonly /></td>
                <td><input asp-for="YG_SargiIsinma_Sapma_HT" class="form-control out-ht" readonly /></td>
            </tr>
        </tbody>
    </table>
</div>
</details>

<details class="trafo-panel">
<summary class="section-title">7. Kazan Değerleri</summary>
<div class="table-responsive">
    <table class="table table-sm table-bordered text-center table-xs mb-0">
        <thead>
            <tr><th>Kategori</th><th>Elektrik Garan.</th><th>Mek. Hesap</th><th>Test</th><th>Sapma EG.H</th><th>Sapma MG.T</th><th>Sapma MH.T</th></tr>
        </thead>
        <tbody>
            <tr class="calc-row">
                <td class="fw-bold bg-body-tertiary text-start">P55 Bilgisi</td>
                <td><input asp-for="P55_ElekGaran" class="form-control val-garanti numeric-input" /></td>
                <td><input asp-for="P55_MekHesap" class="form-control val-hesap numeric-input" /></td>
                <td><input asp-for="P55_Test" class="form-control val-test numeric-input" /></td>
                <td><input asp-for="P55_Sapma_EGH" class="form-control out-gh" readonly /></td>
                <td><input asp-for="P55_Sapma_MGT" class="form-control out-gt" readonly /></td>
                <td><input asp-for="P55_Sapma_MHT" class="form-control out-ht" readonly /></td>
            </tr>
        </tbody>
    </table>
</div>
</details>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57) && charCode != 44 && charCode != 46) return false;
        return true;
    }

    function applyColorWarning(inputElement, val) {
        const input = $(inputElement);
        if (val > 0) {
            input.removeClass("out-ht-warning out-ht-green").addClass("out-ht-red");
        } else if (val < 0) {
            input.removeClass("out-ht-red out-ht-green").addClass("out-ht-warning");
        } else {
            input.removeClass("out-ht-red out-ht-warning out-ht-green");
        }
    }

    function calculateGeneral() {
        $(".sargi-row").each(function() {
            const row = $(this);
            const prefix = row.data("prefix");
            const getVal = (id) => {
                let v = row.find(`[name$='${prefix}_${id}']`).val();
                return (v && v.trim() !== "") ? parseFloat(v.toString().replace(',', '.')) : null;
            };

            const setVal = (selector, h, t) => {
                const el = row.find(selector);
                if (h !== null && t !== null) {
                    const diff = (t - h).toFixed(2);
                    el.val(diff);
                    applyColorWarning(el, parseFloat(diff));
                } else {
                    el.val("").removeClass("out-ht-red out-ht-warning out-ht-green");
                }
            };

            setVal("[name$='Sapma_IcCap_K']", getVal("IcCap_K_Hesap"), getVal("IcCap_K_Test"));
            setVal("[name$='Sapma_IcCap_U']", getVal("IcCap_U_Hesap"), getVal("IcCap_U_Test"));
            setVal("[name$='Sapma_DisCap_K']", getVal("DisCap_K_Hesap"), getVal("DisCap_K_Test"));
            setVal("[name$='Sapma_DisCap_U']", getVal("DisCap_U_Hesap"), getVal("DisCap_U_Test"));

            const vHhK = getVal("DisCap_K_Hesap"); const vHiK = getVal("IcCap_K_Hesap");
            const vThK = getVal("DisCap_K_Test");  const vTiK = getVal("IcCap_K_Test");
            const radKEl = row.find("[name$='Sapma_Radyal_K']");
            if(vHhK !== null && vHiK !== null && vThK !== null && vTiK !== null) {
                const diff = ((vThK - vTiK) - (vHhK - vHiK)).toFixed(2);
                radKEl.val(diff);
                applyColorWarning(radKEl, parseFloat(diff));
            } else { radKEl.val("").removeClass("out-ht-red out-ht-warning out-ht-green"); }

            const vHhU = getVal("DisCap_U_Hesap"); const vHiU = getVal("IcCap_U_Hesap");
            const vThU = getVal("DisCap_U_Test");  const vTiU = getVal("IcCap_U_Test");
            const radUEl = row.find("[name$='Sapma_Radyal_U']");
            if(vHhU !== null && vHiU !== null && vThU !== null && vTiU !== null) {
                const diff = ((vThU - vTiU) - (vHhU - vHiU)).toFixed(2);
                radUEl.val(diff);
                applyColorWarning(radUEl, parseFloat(diff));
            } else { radUEl.val("").removeClass("out-ht-red out-ht-warning out-ht-green"); }
        });

        $(".weight-row").each(function() {
            const row = $(this);
            const h = parseFloat(row.find(".val-h").val()?.toString().replace(',', '.')) || null;
            const t = parseFloat(row.find(".val-t").val()?.toString().replace(',', '.')) || null;
            const out = row.find(".out-w-sapma");
            if (h !== null && t !== null) {
                const diff = (t - h).toFixed(2);
                out.val(diff);
                applyColorWarning(out, parseFloat(diff));
            } else {
                out.val("").removeClass("out-ht-red out-ht-warning out-ht-green");
            }
        });

        $(".calc-row").each(function () {
            const row = $(this);
            const getVal = (sel) => {
                let v = row.find(sel).val();
                return (v && v.trim() !== "") ? parseFloat(v.toString().replace(',', '.')) : null;
            };
            const gar = getVal(".val-garanti");
            const hes = getVal(".val-hesap");
            const tst = getVal(".val-test");
            const testVar = tst !== null && tst > 0;
            const tolInput = row.find(".val-tolerans");
            let tolPercent = tolInput.length > 0 ? (parseFloat(tolInput.val()?.toString().replace(',', '.')) || 0) : null;

            if (gar !== null && gar !== 0) {
                if(hes !== null) row.find(".out-gh").val(((hes - gar) / gar * 100).toFixed(2));
                if(testVar) {
                    row.find(".out-gt").val(((tst - gar) / gar * 100).toFixed(2));
                } else {
                    row.find(".out-gt").val("0.00");
                }
            }

            const htInput = row.find(".out-ht");
            if (hes !== null && hes !== 0) {
                const ht = testVar
                    ? ((tst - hes) / hes * 100).toFixed(2)
                    : (gar !== null && gar !== 0 ? ((hes - gar) / gar * 100).toFixed(2) : "0.00");
                htInput.val(ht);

                if (tolPercent !== null) {
                    const sapmaDegeri = Math.abs(parseFloat(ht) || 0);
                    if (sapmaDegeri > Math.abs(tolPercent)) {
                        htInput.removeClass("out-ht-green").addClass("out-ht-red");
                    } else {
                        htInput.removeClass("out-ht-red").addClass("out-ht-green");
                    }
                } else {
                    if (gar !== null && testVar && tst > gar) {
                        htInput.removeClass("out-ht-green").addClass("out-ht-red");
                    } else {
                        htInput.removeClass("out-ht-red").addClass("out-ht-green");
                    }
                }
            } else {
                htInput.removeClass("out-ht-red out-ht-green").val("");
            }
        });
    }

    $(document).on("keypress", ".numeric-input", function (evt) { if (!isNumberKey(evt)) evt.preventDefault(); });
    $(document).on("input", "input", calculateGeneral);

    function updateSargiLayout() {
        const select = document.getElementById('CekirdekTipiId');
        if (!select) return;
        const selectedText = (select.options[select.selectedIndex]?.text ?? '').trim().toLowerCase();
        const isYuvarlak = selectedText === 'yuvarlak';

        document.querySelectorAll('.col-u-sargi').forEach(el => {
            el.style.display = isYuvarlak ? 'none' : '';
        });

        document.querySelectorAll('[data-colspan-yuvarlak]').forEach(el => {
            el.colSpan = isYuvarlak
                ? parseInt(el.dataset.colspanYuvarlak)
                : parseInt(el.dataset.colspanOval);
        });

        if (isYuvarlak) {
            document.querySelectorAll('.u-sargi-input:not([readonly])').forEach(input => {
                input.value = '';
            });
            calculateGeneral();
        }
    }

    $('#CekirdekTipiId').on('change', updateSargiLayout);

    $(document).ready(function () {
        updateSargiLayout();
        calculateGeneral();
    });
</script>