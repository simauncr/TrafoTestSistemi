@model TrafoTestSistemi.Models.TrafoTest

<style>
    .required-label::after {
        content: " *";
        color: red;
        font-weight: bold;
    }

    .table-xs {
        font-size: 0.7rem;
    }

        .table-xs input, .table-xs select {
            font-size: 0.7rem !important;
            padding: 2px 4px !important;
            height: auto !important;
            text-align: center;
        }

    .bg-sapma {
        background-color: #f8f9fa;
        font-weight: bold;
    }

    .section-title {
        font-size: 0.75rem;
        font-weight: bold;
        text-transform: uppercase;
        margin-bottom: 0px;
        padding: 6px;
        background-color: #343a40;
        color: #fff;
        border: 1px solid #dee2e6;
        border-bottom: none;
    }

    .table-bordered td, .table-bordered th {
        border: 1px solid #dee2e6 !important;
    }

    .mb-custom {
        margin-bottom: 1rem;
    }

    .out-ht-warning {
        background-color: #ffc107 !important;
        color: black !important;
        font-weight: bold;
    }

    .out-ht-green {
        background-color: #28a745 !important;
        color: white !important;
        font-weight: bold;
    }

    .out-ht-red {
        background-color: #dc3545 !important;
        color: white !important;
        font-weight: bold;
    }
</style>

<div class="section-title">1. Genel Bilgiler</div>
<div class="table-responsive mb-custom">
    <table class="table table-sm table-bordered table-xs bg-white mb-0">
        <thead class="table-light">
            <tr>
                <th class="required-label">Proje Adı</th>
                <th class="required-label">Tasarım No</th>
                <th class="required-label">Müşteri</th>
                <th>Dizayn Id</th>
                <th class="required-label">Elek. Müh.</th>
                <th class="required-label">Mek. Müh.</th>
                <th class="required-label">Dizayn Tarihi</th>
                <th class="required-label">Test Tarihi</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><input asp-for="ProjeAdi" id="ProjeAdi" class="form-control" required /></td>
                <td><input asp-for="TasarimNo" class="form-control" required /></td>
                <td><input asp-for="Musteri" class="form-control" required /></td>
                <td><input asp-for="DizaynId" class="form-control" /></td>
                <td><input asp-for="ElektrikMuhendisi" class="form-control" required /></td>
                <td><input asp-for="MekanikMuhendisi" class="form-control" required /></td>
                <td><input asp-for="DizaynTarihi" type="date" class="form-control" required /></td>
                <td><input asp-for="TestTarihi" type="date" class="form-control" required /></td>
            </tr>
