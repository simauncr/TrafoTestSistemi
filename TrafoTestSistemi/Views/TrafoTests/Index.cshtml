@model IEnumerable<TrafoTestSistemi.Models.TrafoTest>

@{
    ViewData["Title"] = "Trafo Test Analiz Takip";
    var aramaMetni = (ViewBag.SearchQuery as string) ?? string.Empty;
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

@section Styles {
    <style>
        .muaf-liste-bant {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            border-radius: 10px;
            padding: 0.75rem 0.95rem;
            background: rgba(var(--app-primary-rgb), 0.12);
            color: var(--app-heading);
            border: 1px solid rgba(var(--app-primary-rgb), 0.3);
        }

        .muaf-liste-bant__text {
            display: inline-flex;
            align-items: center;
            font-size: 0.875rem;
            font-weight: 600;
        }

        .muaf-liste-btn {
            border-radius: 10px;
            font-weight: 700;
            border: 1px solid rgba(var(--app-primary-rgb), 0.35);
            background: transparent;
            color: var(--app-heading);
            padding-inline: 0.75rem;
        }

        .muaf-liste-btn:hover {
            background: rgba(var(--app-primary-rgb), 0.34);
            color: var(--app-heading);
            border-color: rgba(var(--app-primary-rgb), 0.66);
        }
    </style>
}

<div class="container-fluid mt-3">
    @Html.AntiForgeryToken()
    <div class="app-page-header mb-3">
        <div>
            <span class="app-page-header__eyebrow">Trafo Test Analiz Takip</span>
        </div>
        <div>
            <a asp-action="ExcelIndir" class="btn btn-outline-success shadow-sm me-2 fw-bold">
                <i class="fa-solid fa-file-excel me-1"></i> Excel Raporu Al
            </a>
            <a asp-action="Create" class="btn btn-primary shadow-sm fw-bold px-4">
                <i class="fa-solid fa-plus me-1"></i> Yeni Test Kaydı Ekle
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="px-3 pt-3 pb-0 d-none" id="muafListeBilgiAlani">
                <div class="muaf-liste-bant" role="status">
                    <span class="muaf-liste-bant__text"><i class="fa-solid fa-ban me-2"></i>Analizden muaf tutulan test kayıtları listeleniyor.</span>
                    <button type="button" class="btn btn-sm muaf-liste-btn" id="muafListeKapatBtn">Normal listeye dön</button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 w-100" id="trafoTable">
                <thead>
                    <tr>
                        <th class="ps-4">Proje / Müşteri</th>
                        <th>Tasarım No</th>
                        <th class="text-center">Güç (kVA)</th>
                        <th class="text-center">P0 Sapma (HT)</th>
                        <th class="text-center">Pk Sapma (HT)</th>
                        <th class="text-center">Uk Sapma (HT)</th>
                        <th class="text-center">Durum</th>
                        <th class="text-center pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            const aramaMetni = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(aramaMetni));
            const deleteAnimationMs = 230;
            const muafButonHtml = `
                <button type="button" class="btn btn-sm muaf-liste-btn" id="muafKayitlarBtn">
                    <i class="fa-solid fa-ban me-1"></i>Analizden Muaf Tutulan Projeler
                </button>
            `;
            let sadeceMuafKayitlar = false;

            function muafListeDurumunuUygula() {
                const $filter = $('.dataTables_filter');
                const bilgiAlani = document.getElementById('muafListeBilgiAlani');

                $filter.addClass('d-flex justify-content-end align-items-center');
                $filter.html(sadeceMuafKayitlar ? '' : muafButonHtml);

                if (bilgiAlani) {
                    bilgiAlani.classList.toggle('d-none', !sadeceMuafKayitlar);
                }
            }

            const table = $('#trafoTable').DataTable({
                "ajax": {
                    "url": "/TrafoTests/GetTrafolar",
                    "type": "GET",
                    "data": function (d) {
                        if (aramaMetni) {
                            d.q = aramaMetni;
                        }
                        d.excludedOnly = sadeceMuafKayitlar;
                    },
                    "datatype": "json"
                },
                "columns": [
                    {
                        "data": null,
                        "render": function (data) {
                            return `<div>
                                        <div class="fw-bold">${data.projeAdi}</div>
                                        <div class="text-muted small">${data.musteri}</div>
                                    </div>`;
                        }
                    },
                    {
                        "data": "tasarimNo",
                        "render": function (data) {
                            return `<span class="badge bg-body-tertiary text-body border">${data}</span>`;
                        }
                    },
                    { "data": "guc", "className": "text-center fw-bold" },
                    {
                        "data": null,
                        "className": "text-center",
                        "render": function (data) {
                            let tol = data.p0_Tolerans > 0 ? data.p0_Tolerans : 15;
                            let color = Math.abs(data.p0_Sapma_HT) > tol ? "text-danger" : "text-success";
                            return `<span class="fw-bold ${color}">%${data.p0_Sapma_HT.toFixed(2)}</span>`;
                        }
                    },
                    {
                        "data": null,
                        "className": "text-center",
                        "render": function (data) {
                            let tol = data.pk_Tolerans > 0 ? data.pk_Tolerans : 15;
                            let color = Math.abs(data.pk_Sapma_HT) > tol ? "text-danger" : "text-success";
                            return `<span class="fw-bold ${color}">%${data.pk_Sapma_HT.toFixed(2)}</span>`;
                        }
                    },
                    {
                        "data": "uk_Sapma_HT",
                        "className": "text-center",
                        "render": function (data) {
                            return `<span class="text-muted small">%${data.toFixed(2)}</span>`;
                        }
                    },
                    {
                        "data": "sonuc",
                        "className": "text-center",
                        "render": function (data) {
                            let color = (data === "UYGUN") ? "success" : "danger";
                            return `<span class="badge rounded-pill bg-${color} px-3">${data}</span>`;
                        }
                    },
                    {
                        "data": "id",
                        "className": "text-center pe-4",
                        "render": function (data) {
                            return `
                                <div class="btn-group shadow-sm">
                                    <a href="/TrafoTests/Edit/${data}" class="btn btn-sm btn-outline-primary" title="Düzenle">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger js-delete-trafo" title="Sil" data-id="${data}">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>`;
                        },
                        "orderable": false
                    }
                ],
                "language": {
                    "decimal": ",",
                    "thousands": ".",
                    "emptyTable": "Tabloda veri bulunmuyor",
                    "info": "_TOTAL_ kaydın _START_ - _END_ arası gösteriliyor",
                    "infoEmpty": "0 kaydın 0 - 0 arası gösteriliyor",
                    "infoFiltered": "(_MAX_ kayıt içinden filtrelendi)",
                    "infoPostFix": "",
                    "lengthMenu": "Sayfada _MENU_ kayıt göster",
                    "loadingRecords": "Yükleniyor...",
                    "processing": "İşleniyor...",
                    "search": "Ara:",
                    "zeroRecords": "Eşleşen kayıt bulunamadı",
                    "paginate": {
                        "first": "İlk",
                        "last": "Son",
                        "next": "Sonraki",
                        "previous": "Önceki"
                    },
                    "aria": {
                        "sortAscending": ": artan sıralama için etkinleştir",
                        "sortDescending": ": azalan sıralama için etkinleştir"
                    }
                },
                "pageLength": 10,
                "order": [[0, "desc"]],
                "drawCallback": function() {
                    $(".dataTables_paginate > .pagination").addClass("pagination-sm");
                    muafListeDurumunuUygula();
                }
            });

            $(document).on('click', '#muafKayitlarBtn, #muafListeKapatBtn', function () {
                sadeceMuafKayitlar = !sadeceMuafKayitlar;
                table.ajax.reload(null, true);
            });

            $('#trafoTable').on('click', '.js-delete-trafo', async function () {
                const $button = $(this);
                const id = $(this).data('id');
                const token = $('input[name="__RequestVerificationToken"]').first().val();

                const result = await Swal.fire({
                    icon: 'warning',
                    title: 'Kaydı sil?',
                    text: 'Bu işlem geri alınamaz.',
                    showCancelButton: true,
                    confirmButtonText: 'Sil',
                    cancelButtonText: 'Vazgeç',
                    didRender(modal) {
                        const confirmBtn = modal.querySelector('.swal2-confirm');
                        if (confirmBtn) {
                            confirmBtn.classList.add('btn-swal-danger');
                        }
                        
                        const cancelBtn = modal.querySelector('.swal2-cancel');
                        if (cancelBtn) {
                            cancelBtn.style.background = '#ffffff';
                            cancelBtn.style.color = '#5a607b';
                            cancelBtn.style.border = '1.5px solid rgba(115, 103, 240, 0.4)';
                            cancelBtn.style.borderRadius = '12px';
                            cancelBtn.style.padding = '0.65rem 1.5rem';
                            cancelBtn.style.fontFamily = '"Public Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif';
                            cancelBtn.style.fontSize = '0.95rem';
                            cancelBtn.style.fontWeight = '600';
                            cancelBtn.style.cursor = 'pointer';
                            cancelBtn.style.transition = 'all 0.24s cubic-bezier(0.4, 0, 0.2, 1)';
                            cancelBtn.style.lineHeight = '1.4';
                            cancelBtn.style.boxShadow = 'none';
                        }
                    }
                });

                if (!result.isConfirmed) {
                    return;
                }

                try {
                    const response = await fetch(`/TrafoTests/Delete/${id}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                            'RequestVerificationToken': token,
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: `__RequestVerificationToken=${encodeURIComponent(token)}`
                    });

                    const payload = await response.json();
                    if (!response.ok || !payload.success) {
                        throw new Error(payload.message || 'Silme işlemi sırasında hata oluştu.');
                    }

                    await Swal.fire({
                        icon: 'success',
                        title: 'Silindi',
                        text: payload.message,
                        timer: 1400,
                        showConfirmButton: false
                    });

                    const $row = $button.closest('tr');
                    $row.addClass('app-row-removing');
                    await new Promise(resolve => setTimeout(resolve, deleteAnimationMs));

                    table.ajax.reload(null, false);
                } catch (error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Hata',
                        text: error.message || 'Silme işlemi sırasında hata oluştu.'
                    });
                }
            });
        });
    </script>
}