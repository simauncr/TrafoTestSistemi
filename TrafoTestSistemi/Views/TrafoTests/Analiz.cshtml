}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jspdf-autotable@3.8.2/dist/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const analysisRecords = @Html.Raw(analysisJson);
            const forcePivotReset = @Html.Raw(forcePivotResetJson);
            const masterDimensionValues = @Html.Raw(masterDimensionValuesJson);

            const fieldMeta = {
                Musteri: { label: "Müşteri", type: "dimension" },
                ProjeAdi: { label: "Proje Adı", type: "dimension" },
                TasarimNo: { label: "Tasarım No", type: "dimension" },
                DizaynId: { label: "Dizayn Id", type: "dimension" },
                MusteriProje: { label: "Müşteri / Proje", type: "dimension" },
                ElektrikMuhendisi: { label: "Elektrik Mühendisi", type: "dimension" },
                MekanikMuhendisi: { label: "Mekanik Mühendisi", type: "dimension" },
                Muhendis: { label: "Sorumlu Mühendis", type: "dimension" },
                BaglantiGrubu: { label: "Bağlantı Grubu", type: "dimension" },
                CekirdekTipi: { label: "Çekirdek Tipi", type: "dimension" },
                SacCinsi: { label: "Sac Cinsi", type: "dimension" },
                KazanCinsi: { label: "Kazan Cinsi", type: "dimension" },
                YagCinsi: { label: "Yağ Cinsi", type: "dimension" },
                Sonuc: { label: "Sonuç", type: "dimension" },
                TestTarihi: { label: "Test Tarihi", type: "dimension" },
                DizaynTarihi: { label: "Dizayn Tarihi", type: "dimension" },
                GucKVA: { label: "Güç (kVA)", type: "measure", dataType: "number" },
                GerilimYG: { label: "YG Gerilim", type: "measure", dataType: "number" },
                GerilimAG: { label: "AG Gerilim", type: "measure", dataType: "number" },
                Frekans: { label: "Frekans", type: "measure", dataType: "number" },
                // Grouped sapma fields (P0 / Pk / Uk) - numeric measures
                P0SapmaGH: { label: "P0 Sapma GH", type: "measure", dataType: "number" },
                P0SapmaGT: { label: "P0 Sapma GT", type: "measure", dataType: "number" },
                P0SapmaHT: { label: "P0 Sapma HT", type: "measure", dataType: "number" },

                PkSapmaGH: { label: "Pk Sapma GH", type: "measure", dataType: "number" },
                PkSapmaGT: { label: "Pk Sapma GT", type: "measure", dataType: "number" },
                PkSapmaHT: { label: "Pk Sapma HT", type: "measure", dataType: "number" },

                UkSapmaGH: { label: "Uk Sapma GH", type: "measure", dataType: "number" },
                UkSapmaGT: { label: "Uk Sapma GT", type: "measure", dataType: "number" },
                UkSapmaHT: { label: "Uk Sapma HT", type: "measure", dataType: "number" }
            };

            const aggLabel = {
                sum: "Toplam",
                avg: "Ortalama",
                count: "Adet",
                min: "En Küçük",
                max: "En Büyük"
            };

            function toNumber(value) {
                const n = Number(value);
                return Number.isFinite(n) ? n : 0;
            }

            function normalizeSonuc(value) {
                const raw = String(value || "").trim();
                if (!raw) {
                    return "BEKLEMEDE";
                }

                const upper = raw.toLocaleUpperCase("tr-TR");
                const normalized = upper
                    .replace(/Ç/g, "C")
                    .replace(/Ğ/g, "G")
                    .replace(/İ/g, "I")
                    .replace(/I/g, "I")
                    .replace(/Ö/g, "O")
                    .replace(/Ş/g, "S")
                    .replace(/Ü/g, "U");

                if (normalized.includes("UYGUN DEGIL") || normalized.includes("DEGIL") || normalized.includes("HATALI") || normalized.includes("KALDI") || normalized.includes("FAIL")) {
                    return "UYGUN DEĞİL";
                }

                if (normalized.includes("UYGUN") || normalized.includes("GECTI") || normalized.includes("PASS")) {
                    return "UYGUN";
                }

                return upper;
            }

            const data = analysisRecords.map(r => ({
                Id: toNumber(r.Id),
                Musteri: r.Musteri || "Tanımsız",
                ProjeAdi: r.ProjeAdi || "Tanımsız",
                TasarimNo: r.TasarimNo || "Tanımsız",
                DizaynId: r.DizaynId || "Tanımsız",
                MusteriProje: r.MusteriProje || "Tanımsız / Tanımsız",
                ElektrikMuhendisi: r.ElektrikMuhendisi || "Tanımsız",
                MekanikMuhendisi: r.MekanikMuhendisi || "Tanımsız",
                Muhendis: r.Muhendis || "Tanımsız",
                BaglantiGrubu: r.BaglantiGrubu || "Tanımsız",
                CekirdekTipi: r.CekirdekTipi || "Tanımsız",
                SacCinsi: r.SacCinsi || "Tanımsız",
                KazanCinsi: r.KazanCinsi || "Tanımsız",
                YagCinsi: r.YagCinsi || "Tanımsız",
                Sonuc: normalizeSonuc(r.Sonuc),
                TestTarihi: r.TestTarihi || "-",
                DizaynTarihi: r.DizaynTarihi || "-",
                GucKVA: toNumber(r.Guc),
                GerilimYG: toNumber(r.GerilimYG),
                GerilimAG: toNumber(r.GerilimAG),
                Frekans: toNumber(r.Frekans),
                // Individual grouped sapma values from model (decimal/number)
                P0SapmaGH: toNumber(r.P0_Sapma_GH),
                P0SapmaGT: toNumber(r.P0_Sapma_GT),
                P0SapmaHT: toNumber(r.P0_Sapma_HT),

                PkSapmaGH: toNumber(r.Pk_Sapma_GH),
                PkSapmaGT: toNumber(r.Pk_Sapma_GT),
                PkSapmaHT: toNumber(r.Pk_Sapma_HT),

                UkSapmaGH: toNumber(r.Uk_Sapma_GH),
                UkSapmaGT: toNumber(r.Uk_Sapma_GT),
                UkSapmaHT: toNumber(r.Uk_Sapma_HT)
            }));

            const state = {
                targetZone: "rows",
                rows: [],
                columns: [],
                filters: [],
                values: [],
                filterValues: {},
                chartModel: null,
                chartInstance: null,
                activeChartType: null,
                options: {
                    showGrandTotals: true,
                    compactRows: false,
                    decimalPlaces: 2
                }
            };
            let kullaniciElleDegisiklikYapti = false;
            let aktifKayitAdi = "Yeni Rapor Tasarımı";
            const aktifKayitAdiLabel = document.getElementById("aktifKayitAdiLabel");

            function setActivePivotAdi(ad) {
                aktifKayitAdi = (ad || "").trim() || "Yeni Rapor Tasarımı";
                if (!aktifKayitAdiLabel) {
                    return;
                }
                aktifKayitAdiLabel.textContent = `Görüntülenen tablo: ${aktifKayitAdi}`;
                aktifKayitAdiLabel.style.display = "inline-block";
            }

            function setActivePivotState(id, ad) {
                aktifKayitId = Number(id) > 0 ? Number(id) : null;
                setActivePivotAdi(ad);
                if (aktifKayitId) {
                    kayitliTabloOdakModuAyarla(true);
                }
            }

            function kullaniciEtkilesiminiIsaretle() {
                kullaniciElleDegisiklikYapti = true;
            }

            function isValidZoneForField(fieldKey, zone) {
                const meta = fieldMeta[fieldKey];
                if (!meta) {
                    return false;
                }
                return true;
            }

            const zones = {
                rows: document.getElementById("zone-rows"),
                columns: document.getElementById("zone-columns"),
                values: document.getElementById("zone-values"),
                filters: document.getElementById("zone-filters")
            };

            const emptyState = document.getElementById("pivotEmptyState");
            const tableHolder = document.getElementById("pivotTableHolder");
            const table = document.getElementById("pivotResultTable");
            const filterInputs = document.getElementById("dynamicFilterInputs");
            const filtreDropdownWrap = document.getElementById("aktifFiltreDropdownWrap");
            const filtreBadge = document.getElementById("aktifFiltreBadge");
            const reportWrap = document.getElementById("pivotReportWrap");
            const viewStage = document.getElementById("pivotViewStage");
            const tablePanel = document.getElementById("pivotTablePanel");
            const chartPanel = document.getElementById("pivotChartPanel");
            const chartCanvas = document.getElementById("pivotChartCanvas");
            const tabloyaDonBtn = document.getElementById("tabloyaDonBtn");
            const analizCalismaAlani = document.getElementById("analizCalismaAlani");
            const kayitliTablolarBtn = document.getElementById("kayitliTablolarBtn");
            const kayitliTablolarSayfasi = document.getElementById("kayitliTablolarSayfasi");
            const kayitliTablolarListe = document.getElementById("kayitliTablolarListe");
            const analizeDonBtn = document.getElementById("analizeDonBtn");
            const pivotKaydetBtn = document.getElementById("pivotKaydetBtn");
            const pivotDraftStorageKey = "trafo:pivot:draft";
            const pivotDuzenleBtn = document.getElementById("pivotDuzenleBtn");
            const pivotGuncelleBtn = document.getElementById("pivotGuncelleBtn");
            let aktifKayitId = null;
            const editPivotId = Number(new URLSearchParams(location.search).get("editPivot"));
            const viewPivotId = Number(new URLSearchParams(location.search).get("viewPivot"));
            const sayfadaEditModu = Number.isFinite(editPivotId) && editPivotId > 0;
            let activeDimensionPicker = null;

            function kayitliTablolarButonunuAyarla(geriDonModu) {
                if (geriDonModu) {
                    kayitliTablolarBtn.dataset.mode = "geri-don";
                    kayitliTablolarBtn.innerHTML = "<i class='fa-solid fa-arrow-left me-1'></i>Geri Dön";
                    return;
                }

                kayitliTablolarBtn.dataset.mode = "liste";
                kayitliTablolarBtn.innerHTML = "<i class='fa-solid fa-bookmark me-1'></i>Kayıtlı Tablolarım";
            }

            function escapeHtml(text) {
                return String(text || "")
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/\"/g, "&quot;")
                    .replace(/'/g, "&#39;");
            }

            async function parseJsonResponseSafe(response) {
                const raw = await response.text();
                if (!raw || !raw.trim()) {
                    return {};
                }

                try {
                    return JSON.parse(raw);
                } catch {
                    const preview = raw.slice(0, 120);
                    throw new Error(`Sunucu geçersiz yanıt döndürdü (${response.status}). ${preview}`);
                }
            }

            function mevcutKonfigOlustur() {
                const konfig = {
                    rows: [...state.rows],
                    columns: [...state.columns],
                    filters: [...state.filters],
                    values: state.values.map(v => ({ key: v.key, agg: v.agg })),
                    filterValues: { ...state.filterValues },
                    options: {
                        showGrandTotals: !!state.options.showGrandTotals,
                        compactRows: !!state.options.compactRows,
                        decimalPlaces: Number(state.options.decimalPlaces)
                    }
                };
                console.log("[Pivot] Konfig oluşturuldu:", konfig);
                return konfig;
            }

            function pivotTaslakKaydet() {
                try {
                    sessionStorage.setItem(pivotDraftStorageKey, JSON.stringify(mevcutKonfigOlustur()));
                } catch {
                }
            }

            function pivotTaslakTemizle() {
                try {
                    sessionStorage.removeItem(pivotDraftStorageKey);
                } catch {
                }
            }

            function pivotTaslakYukle() {
                try {
                    const raw = sessionStorage.getItem(pivotDraftStorageKey);
                    if (!raw) {
                        return false;
                    }

                    const konfig = JSON.parse(raw);
                    konfigUygula(konfig);
                    return true;
                } catch {
                    return false;
                }
            }

            function pivotDurumunuSifirla() {
                state.rows = [];
                state.columns = [];
                state.values = [];
                state.filters = [];
                state.filterValues = {};
                aktifKayitId = null;
                setActivePivotAdi("");
                kayitliTabloOdakModuAyarla(false);
                renderZoneTags();
                renderFilterInputs();
                buildPivot();
                pivotTaslakTemizle();
            }

            function konfigUygula(konfig) {
                if (!konfig) {
                    console.warn("[Pivot] Konfig boş veya tanımsız");
                    return;
                }

                console.log("[Pivot] Konfig uygulanıyor:", konfig);
                console.log("[Pivot] Mevcut fieldMeta anahtarları:", Object.keys(fieldMeta).sort());

                const diziTemizle = (dizi, tur) => {
                    if (!Array.isArray(dizi)) {
                        return [];
                    }
                    const sonuc = dizi.filter(k => {
                        const mevcuMu = !!fieldMeta[k];
                        const turUygunMu = !tur || (fieldMeta[k] && fieldMeta[k].type === tur);
                        if (!mevcuMu) {
                            console.warn(`[Pivot] Alan bulunmadı: "${k}" (tip: ${tur || "any"})`);
                        }
                        return mevcuMu && turUygunMu;
                    });
                    console.log(`[Pivot] Temizlenmiş dizi (${tur || "mixed"}): ${dizi.length} → ${sonuc.length}`);
                    return sonuc;
                };

                state.rows = diziTemizle(konfig.rows, "dimension");
                state.columns = diziTemizle(konfig.columns, "dimension");
                state.filters = diziTemizle(konfig.filters, "dimension");

                state.values = (Array.isArray(konfig.values) ? konfig.values : [])
                    .filter(v => {
                        const mevcuMu = v && !!fieldMeta[v.key];
                        const aggValidMi = v && ["sum", "avg", "count", "min", "max"].includes(v.agg);
                        if (!mevcuMu) {
                            console.warn(`[Pivot] Ölçü alanı bulunmadı: "${v?.key}" (agg: ${v?.agg})`);
                        }
                        return mevcuMu && aggValidMi;
                    })
                    .map(v => ({ key: v.key, agg: v.agg }));

                state.filterValues = {};
                if (konfig.filterValues && typeof konfig.filterValues === "object") {
                    Object.keys(konfig.filterValues).forEach(key => {
                        if (state.filters.includes(key)) {
                            const current = konfig.filterValues[key];
                            if (Array.isArray(current)) {
                                setSelectedFilterValues(key, current);
                            } else if (typeof current === "string") {
                                if (current.trim()) {
                                    setSelectedFilterValues(key, [current]);
                                } else {
                                    clearSelectedFilterValues(key);
                                }
                            } else {
                                clearSelectedFilterValues(key);
                            }
                        }
                    });
                }

                if (konfig.options && typeof konfig.options === "object") {
                    state.options.showGrandTotals = konfig.options.showGrandTotals !== false;
                    state.options.compactRows = !!konfig.options.compactRows;
                    state.options.decimalPlaces = Number.isFinite(Number(konfig.options.decimalPlaces))
                        ? Number(konfig.options.decimalPlaces)
                        : 2;
                }

                document.getElementById("showGrandTotals").checked = state.options.showGrandTotals;
                document.getElementById("compactRows").checked = state.options.compactRows;
                document.getElementById("decimalPlaces").value = String(state.options.decimalPlaces);

                console.log("[Pivot] Konfigürasyon uygulandı:", {
                    rows: state.rows.length,
                    columns: state.columns.length,
                    filters: state.filters.length,
                    values: state.values.length
                });

                renderZoneTags();
                renderFilterInputs();
                setView("table");
                buildPivot();
            }

            function kayitliTabloOdakModuAyarla(aktif) {
                const duzenlemeModuAktif = !!aktif && !!aktifKayitId && sayfadaEditModu;
                const odakModu = !!aktif && !duzenlemeModuAktif;
                analizCalismaAlani.classList.toggle("pivot-kayit-odak", odakModu);
                kayitliTablolarButonunuAyarla(!!aktif);
                if (pivotDuzenleBtn) {
                    pivotDuzenleBtn.style.display = (!!aktif && aktifKayitId && !sayfadaEditModu) ? "inline-flex" : "none";
                }
                if (pivotGuncelleBtn) {
                    pivotGuncelleBtn.style.display = duzenlemeModuAktif ? "inline-flex" : "none";
                }
                syncStageHeight();
            }

            function analizGorunumunuAc(sadeceKayitliTablo = false) {
                analizCalismaAlani.style.display = "flex";
                kayitliTablolarSayfasi.style.display = "none";
                kayitliTabloOdakModuAyarla(!!sadeceKayitliTablo);
            }

            function kayitliTablolarGorunumunuAc() {
                analizCalismaAlani.style.display = "none";
                kayitliTablolarSayfasi.style.display = "block";
                kayitliTabloOdakModuAyarla(false);
            }

            async function kayitliTablolariGetir() {
                const response = await fetch("/TrafoTests/KayitliPivotTablolar", {
                    method: "GET",
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });

                const payload = await response.json();
                if (!response.ok || !payload.success) {
                    throw new Error(payload.message || "Kayıtlı tablolar alınamadı.");
                }

                return payload.data || [];
            }

            async function kayitliTablolariListele() {
                kayitliTablolarListe.innerHTML = "<div class='text-muted small'>Yükleniyor...</div>";

                try {
                    const liste = await kayitliTablolariGetir();
                    if (!liste.length) {
                        kayitliTablolarListe.innerHTML = "<div class='text-muted small'>Henüz kayıtlı pivot tablo bulunmuyor.</div>";
                        return;
                    }

                    kayitliTablolarListe.innerHTML = liste.map(item => `
                        <div class="pivot-saved-item" data-kayit-id="${item.id}">
                            <div>
                                <div class="pivot-saved-item__title">${escapeHtml(item.ad)}</div>
                                <div class="pivot-saved-item__meta">${escapeHtml(item.olusturan || "Sistem")} • ${escapeHtml(item.olusturmaTarihi || "")}</div>
                            </div>
                            <div class="pivot-saved-item__actions">
                                <button type="button" class="btn btn-sm pivot-action-btn pivot-action-btn--lila js-pivot-yukle">Görüntüle</button>
                                <button type="button" class="btn btn-sm btn-outline-danger js-pivot-sil">Sil</button>
                            </div>
                        </div>
                    `).join("");

                    kayitliTablolarListe.querySelectorAll(".js-pivot-yukle").forEach(btn => {
                        btn.addEventListener("click", async function () {
                            const kayitId = Number(btn.closest("[data-kayit-id]").dataset.kayitId);
                            if (!Number.isFinite(kayitId) || kayitId <= 0) {
                                return;
                            }
                            window.open(`/TrafoTests/Analiz?viewPivot=${kayitId}`, "_blank");
                        });
                    });

                    kayitliTablolarListe.querySelectorAll(".js-pivot-sil").forEach(btn => {
                        btn.addEventListener("click", async function () {
                            const kayitId = Number(btn.closest("[data-kayit-id]").dataset.kayitId);
                            try {
                                await pivotTabloSil(kayitId);
                            } catch (error) {
                                await Swal.fire({
                                    icon: "error",
                                    title: "Hata",
                                    text: error.message || "Kayıt silinemedi."
                                });
                            }
                        });
                    });
                } catch (error) {
                    kayitliTablolarListe.innerHTML = `<div class='text-danger small'>${escapeHtml(error.message || "Kayıtlar alınamadı.")}</div>`;
                }
            }

            async function pivotTabloYukle(id) {
                emptyState.style.display = "block";
                emptyState.querySelector("h6").textContent = "Tablo yükleniyor...";
                tableHolder.style.display = "none";
                pivotKaydetBtn.style.display = "none";

                const response = await fetch(`/TrafoTests/PivotTabloDetay?id=${id}`, {
                    method: "GET",
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });

                const payload = await response.json();
                if (!response.ok || !payload.success) {
                    throw new Error(payload.message || "Kayıt yüklenemedi.");
                }

                const detay = payload.data || {};
                const konfigJson = detay.konfigJson || detay.KonfigJson;
                if (!konfigJson) {
                    throw new Error("Kayıtlı tablo içeriği bulunamadı.");
                }

                const konfig = JSON.parse(konfigJson);
                setActivePivotState(id, detay.ad || detay.Ad || "");
                konfigUygula(konfig);
                analizGorunumunuAc(true);
            }

            async function pivotTabloSil(id) {
                const onay = await Swal.fire({
                    icon: "warning",
                    title: "Kayıt silinsin mi?",
                    text: "Bu işlem geri alınamaz.",
                    showCancelButton: true,
                    confirmButtonText: "Sil",
                    cancelButtonText: "Vazgeç",
                    didRender(modal) {
                        const confirmBtn = modal.querySelector('.swal2-confirm');
                        if (confirmBtn) {
                            confirmBtn.classList.add('btn-swal-danger');
                        }
                        
                        const cancelBtn = modal.querySelector('.swal2-cancel');
                        if (cancelBtn) {
                            cancelBtn.style.background = '#ffffff';
                            cancelBtn.style.color = '#5a607b';
                            cancelBtn.style.border = '1.5px solid rgba(115, 103, 240, 0.4)';
                            cancelBtn.style.borderRadius = '12px';
                            cancelBtn.style.padding = '0.65rem 1.5rem';
                            cancelBtn.style.fontFamily = '"Public Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif';
                            cancelBtn.style.fontSize = '0.95rem';
                            cancelBtn.style.fontWeight = '600';
                            cancelBtn.style.cursor = 'pointer';
                            cancelBtn.style.transition = 'all 0.24s cubic-bezier(0.4, 0, 0.2, 1)';
                            cancelBtn.style.lineHeight = '1.4';
                            cancelBtn.style.boxShadow = 'none';
                        }
                    }
                });

                if (!onay.isConfirmed) {
                    return;
                }

                const response = await fetch("/TrafoTests/PivotTabloSil", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    body: JSON.stringify({ Id: id })
                });

                const payload = await response.json();
                if (!response.ok || !payload.success) {
                    throw new Error(payload.message || "Silme işlemi başarısız.");
                }

                await kayitliTablolariListele();
            }

            function syncStageHeight() {
                const activePanel = viewStage.classList.contains("is-chart") ? chartPanel : tablePanel;
                const contentHeight = activePanel ? activePanel.scrollHeight : 0;
                viewStage.style.height = `${contentHeight}px`;
            }

            function setView(mode) {
                if (mode === "chart") {
                    viewStage.classList.add("is-chart");
                    syncStageHeight();
                    return;
                }
                viewStage.classList.remove("is-chart");
                syncStageHeight();
            }

            function hexToRgba(hex, alpha) {
                const value = (hex || "").replace("#", "");
                const normalized = value.length === 3
                    ? value.split("").map(c => c + c).join("")
                    : value;
                const int = parseInt(normalized, 16);
                const r = (int >> 16) & 255;
                const g = (int >> 8) & 255;
                const b = int & 255;
                return `rgba(${r}, ${g}, ${b}, ${alpha})`;
            }

            function adjustHex(hex, amount) {
                const value = (hex || "").replace("#", "");
                const normalized = value.length === 3
                    ? value.split("").map(c => c + c).join("")
                    : value;
                const int = parseInt(normalized, 16);
                const r = Math.max(0, Math.min(255, ((int >> 16) & 255) + amount));
                const g = Math.max(0, Math.min(255, ((int >> 8) & 255) + amount));
                const b = Math.max(0, Math.min(255, (int & 255) + amount));
                return `rgb(${r}, ${g}, ${b})`;
            }

            function createVerticalGradient(chart, colorHex) {
                const { ctx, chartArea } = chart;
                if (!chartArea) {
                    return hexToRgba(colorHex, 0.55);
                }

                const gradient = ctx.createLinearGradient(0, chartArea.top, 0, chartArea.bottom);
                gradient.addColorStop(0, hexToRgba(colorHex, 0.82));
                gradient.addColorStop(1, hexToRgba(colorHex, 0.09));
                return gradient;
            }

            function createPremiumShadowPlugin() {
                return {
                    id: "premiumShadowPlugin",
                    beforeDatasetDraw(chart) {
                        const { ctx } = chart;
                        ctx.save();
                        ctx.shadowColor = "rgba(115, 103, 240, 0.2)";
                        ctx.shadowBlur = 12;
                        ctx.shadowOffsetX = 0;
                        ctx.shadowOffsetY = 4;
                    },
                    afterDatasetDraw(chart) {
                        chart.ctx.restore();
                    }
                };
            }

            function renderChart(chartType) {
                if (!state.chartModel || !state.chartModel.labels.length || !chartCanvas) {
                    return false;
                }

                state.activeChartType = chartType;

                const palette = ["#7367F0", "#00CFE8", "#28C76F", "#FF6B6B", "#A66BFF", "#1E9EF7", "#00B894", "#FF9F43"];
                const base = idx => palette[idx % palette.length];

                let labels = state.chartModel.labels;
                let datasets;

                if (chartType === "pie" || chartType === "doughnut") {
                    const first = state.chartModel.series[0];
                    datasets = [{
                        label: first.name,
                        data: first.data,
                        backgroundColor: labels.map((_, i) => hexToRgba(base(i), 0.82)),
                        borderColor: labels.map(() => "rgba(255,255,255,0.96)"),
                        hoverBackgroundColor: labels.map((_, i) => adjustHex(base(i), 20)),
                        borderWidth: 2,
                        hoverOffset: 14,
                        spacing: 2
                    }];
                } else if (chartType === "radar") {
                    datasets = state.chartModel.series.map((s, i) => ({
                        label: s.name,
                        data: s.data,
                        borderColor: base(i),
                        backgroundColor: hexToRgba(base(i), 0.18),
                        pointBackgroundColor: adjustHex(base(i), 28),
                        pointBorderColor: "#ffffff",
                        pointHoverBackgroundColor: "#ffffff",
                        pointHoverBorderColor: base(i),
                        pointRadius: 3.5,
                        pointHoverRadius: 6,
                        borderWidth: 2.2,
                        fill: true,
                        tension: 0.38
                    }));
                } else {
                    datasets = state.chartModel.series.map((s, i) => ({
                        label: s.name,
                        data: s.data,
                        borderColor: base(i),
                        backgroundColor: context => createVerticalGradient(context.chart, base(i)),
                        hoverBackgroundColor: adjustHex(base(i), 20),
                        hoverBorderColor: adjustHex(base(i), 25),
                        hoverBorderWidth: 2,
                        pointBackgroundColor: base(i),
                        pointBorderColor: "#ffffff",
                        pointRadius: chartType === "line" ? 3 : 0,
                        pointHoverRadius: chartType === "line" ? 7 : 4,
                        pointHitRadius: 14,
                        fill: chartType === "line",
                        tension: chartType === "line" ? 0.44 : 0.26,
                        cubicInterpolationMode: "monotone",
                        borderWidth: chartType === "line" ? 3 : 1.6,
                        borderSkipped: false,
                        borderRadius: chartType === "bar" ? 8 : 0
                    }));
                }

                const chartOptions = {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: {
                        duration: 950,
                        easing: "easeInOutQuart"
                    },
                    interaction: {
                        mode: "nearest",
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            position: "bottom",
                            labels: {
                                usePointStyle: true,
                                pointStyle: "circle",
                                padding: 14,
                                boxWidth: 10,
                                color: "#4b4f64",
                                font: {
                                    family: "Public Sans",
                                    size: 12,
                                    weight: "600"
                                }
                            }
                        },
                        tooltip: {
                            backgroundColor: "rgba(115, 103, 240, 0.94)",
                            titleColor: "#ffffff",
                            bodyColor: "#f7f7ff",
                            borderColor: "rgba(255,255,255,0.36)",
                            borderWidth: 1,
                            cornerRadius: 10,
                            padding: 11,
                            displayColors: true,
                            titleFont: {
                                family: "Public Sans",
                                size: 12,
                                weight: "700"
                            },
                            bodyFont: {
                                family: "Public Sans",
                                size: 12,
                                weight: "500"
                            },
                            callbacks: {
                                title(items) {
                                    return `Kategori: ${items[0].label}`;
                                },
                                label(context) {
                                    const rawVal = (typeof context.parsed === "number")
                                        ? context.parsed
                                        : (context.parsed && typeof context.parsed.y === "number" ? context.parsed.y : 0);
                                    return `${context.dataset.label}: ${Number(rawVal).toLocaleString("tr-TR", {
                                        minimumFractionDigits: state.options.decimalPlaces,
                                        maximumFractionDigits: state.options.decimalPlaces
                                    })}`;
                                }
                            }
                        }
                    },
                    scales: (chartType === "pie" || chartType === "doughnut")
                        ? {}
                        : (chartType === "radar"
                            ? {
                                r: {
                                    angleLines: { color: "rgba(115,103,240,0.15)" },
                                    grid: { color: "rgba(115,103,240,0.14)" },
                                    pointLabels: {
                                        color: "#5a607b",
                                        font: {
                                            family: "Public Sans",
                                            size: 11,
                                            weight: "600"
                                        }
                                    },
                                    ticks: {
                                        backdropColor: "transparent",
                                        color: "#7a809c",
                                        showLabelBackdrop: false
                                    }
                                }
                            }
                            : {
                                x: {
                                    title: {
                                        display: true,
                                        text: "Kırılım",
                                        color: "#5a607b",
                                        font: {
                                            family: "Public Sans",
                                            size: 12,
                                            weight: "700"
                                        }
                                    },
                                    ticks: {
                                        maxRotation: 35,
                                        minRotation: 0,
                                        color: "#666f8d",
                                        font: {
                                            family: "Public Sans",
                                            size: 11,
                                            weight: "500"
                                        }
                                    },
                                    grid: {
                                        color: "rgba(115,103,240,0.08)"
                                    }
                                },
                                y: {
                                    beginAtZero: true,
                                    title: {
                                        display: true,
                                        text: "Değer",
                                        color: "#5a607b",
                                        font: {
                                            family: "Public Sans",
                                            size: 12,
                                            weight: "700"
                                        }
                                    },
                                    ticks: {
                                        color: "#666f8d",
                                        font: {
                                            family: "Public Sans",
                                            size: 11,
                                            weight: "500"
                                        }
                                    },
                                    grid: {
                                        color: "rgba(115,103,240,0.08)"
                                    }
                                }
                            })
                };

                const chartNeedsRecreate = !state.chartInstance || state.chartInstance.config.type !== chartType;
                if (chartNeedsRecreate) {
                    if (state.chartInstance) {
                        state.chartInstance.destroy();
                    }

                    state.chartInstance = new Chart(chartCanvas, {
                        type: chartType,
                        data: { labels, datasets },
                        plugins: [createPremiumShadowPlugin()],
                        options: chartOptions
                    });
                } else {
                    state.chartInstance.data.labels = labels;
                    state.chartInstance.data.datasets = datasets;
                    state.chartInstance.options = chartOptions;
                    state.chartInstance.update();
                }

                setTimeout(syncStageHeight, 40);

                return true;
            }

            function syncActiveChartIfVisible() {
                if (!viewStage.classList.contains("is-chart") || !state.activeChartType) {
                    return;
                }

                if (!state.chartModel || !state.chartModel.labels.length) {
                    if (state.chartInstance) {
                        state.chartInstance.destroy();
                        state.chartInstance = null;
                    }
                    setView("table");
                    return;
                }

                renderChart(state.activeChartType);
            }

            function createFieldChip(fieldKey) {
                const meta = fieldMeta[fieldKey];
                const el = document.createElement("button");
                el.type = "button";
                el.className = "pivot-field-item";
                el.textContent = meta.label;
                el.draggable = true;
                el.dataset.field = fieldKey;
                el.addEventListener("click", () => addFieldToZone(fieldKey, state.targetZone));
                el.addEventListener("dragstart", ev => {
                    ev.dataTransfer.setData("text/plain", fieldKey);
                });
                return el;
            }

            function renderFieldLists() {
                const dim = document.getElementById("dimensionFields");
                const mea = document.getElementById("measureFields");
                dim.innerHTML = "";
                mea.innerHTML = "";

                Object.keys(fieldMeta).forEach(key => {
                    const chip = createFieldChip(key);
                    if (fieldMeta[key].type === "measure") {
                        mea.appendChild(chip);
                    } else {
                        dim.appendChild(chip);
                    }
                });
            }

            function addFieldToZone(fieldKey, zone, skipRefresh = false) {
                if (!fieldMeta[fieldKey] || !zone) {
                    return;
                }

                if (!isValidZoneForField(fieldKey, zone)) {
                    return;
                }

                if (zone === "values") {
                    if (state.values.some(v => v.key === fieldKey)) {
                        return;
                    }
                    const defaultAgg = fieldMeta[fieldKey].type === "measure" ? "avg" : "count";
                    state.values.push({ key: fieldKey, agg: defaultAgg });
                } else {
                    if (state[zone].includes(fieldKey)) {
                        return;
                    }
                    state[zone].push(fieldKey);
                }

                if (!skipRefresh) {
                    kullaniciEtkilesiminiIsaretle();
                    renderZoneTags();
                    renderFilterInputs();
                    buildPivot();
                }
            }

            function removeFieldFromZone(zone, fieldKey, skipRefresh = false) {
                if (zone === "values") {
                    state.values = state.values.filter(v => v.key !== fieldKey);
                } else {
                    state[zone] = state[zone].filter(k => k !== fieldKey);
                    if (zone === "filters") {
                        delete state.filterValues[fieldKey];
                    }
                }
                if (!skipRefresh) {
                    kullaniciEtkilesiminiIsaretle();
                    renderZoneTags();
                    renderFilterInputs();
                    buildPivot();
                }
            }

            function moveFieldBetweenZones(fromZone, toZone, fieldKey) {
                if (!fromZone || !toZone || !fieldKey || fromZone === toZone) {
                    return;
                }

                // Keep updates atomic so transient empty states do not overwrite draft/state.
                removeFieldFromZone(fromZone, fieldKey, true);
                addFieldToZone(fieldKey, toZone, true);
                kullaniciEtkilesiminiIsaretle();
                renderZoneTags();
                renderFilterInputs();
                buildPivot();
            }

            function renderZoneTags() {
                Object.keys(zones).forEach(zoneName => {
                    zones[zoneName].innerHTML = "";
                    const list = zoneName === "values" ? state.values : state[zoneName];

                    if (!list.length) {
                        const ghost = document.createElement("div");
                        ghost.className = "text-muted small";
                        ghost.textContent = "Alanları buraya sürükleyin";
                        zones[zoneName].appendChild(ghost);
                        return;
                    }

                    list.forEach(item => {
                        const fieldKey = zoneName === "values" ? item.key : item;
                        const wrap = document.createElement("span");
                        wrap.className = "pivot-tag";
                        wrap.draggable = true;
                        wrap.dataset.field = fieldKey;
                        wrap.dataset.zone = zoneName;

                        wrap.addEventListener("dragstart", ev => {
                            ev.dataTransfer.setData("application/json", JSON.stringify({
                                fieldKey,
                                fromZone: zoneName
                            }));
                            ev.dataTransfer.setData("text/plain", fieldKey);
                        });

                        const title = document.createElement("span");
                        title.className = "pivot-tag__title";
                        title.textContent = fieldMeta[fieldKey].label;
                        if (zoneName !== "values") {
                            title.addEventListener("click", function (ev) {
                                ev.stopPropagation();
                                openDimensionPicker(fieldKey, title);
                            });
                        }
                        wrap.appendChild(title);

                        if (zoneName === "values") {
                            const meta = document.createElement("span");
                            meta.className = "pivot-tag__meta";
                            meta.textContent = aggLabel[item.agg] || item.agg;
                            wrap.appendChild(meta);

                            meta.addEventListener("click", function () {
                                const order = ["sum", "avg", "count", "min", "max"];
                                const idx = order.indexOf(item.agg);
                                item.agg = order[(idx + 1) % order.length];
                                renderZoneTags();
                                buildPivot();
                            });
                        }

                        const removeBtn = document.createElement("button");
                        removeBtn.type = "button";
                        removeBtn.className = "pivot-tag__remove";
                        removeBtn.innerHTML = "<i class='fa-solid fa-xmark'></i>";
                        removeBtn.addEventListener("click", () => removeFieldFromZone(zoneName, fieldKey));
                        wrap.appendChild(removeBtn);

                        zones[zoneName].appendChild(wrap);
                    });
                });
            }

            function setupDropZones() {
                document.querySelectorAll(".pivot-zone").forEach(zoneEl => {
                    const zoneName = zoneEl.dataset.zone;
                    const dropArea = zoneEl.querySelector(".pivot-zone__drop");

                    zoneEl.addEventListener("click", () => {
                        state.targetZone = zoneName;
                    });

                    dropArea.addEventListener("dragover", ev => {
                        ev.preventDefault();
                        dropArea.classList.add("is-over");
                    });

                    dropArea.addEventListener("dragleave", () => {
                        dropArea.classList.remove("is-over");
                    });

                    dropArea.addEventListener("drop", ev => {
                        ev.preventDefault();
                        dropArea.classList.remove("is-over");
                        const payloadRaw = ev.dataTransfer.getData("application/json");
                        if (payloadRaw) {
                            try {
                                const payload = JSON.parse(payloadRaw);
                                if (payload?.fieldKey && payload?.fromZone) {
                                    moveFieldBetweenZones(payload.fromZone, zoneName, payload.fieldKey);
                                    return;
                                }
                            } catch {
                            }
                        }

                        const fieldKey = ev.dataTransfer.getData("text/plain");
                        if (!isValidZoneForField(fieldKey, zoneName)) {
                            return;
                        }
                        addFieldToZone(fieldKey, zoneName);
                    });
                });
            }

            function renderFilterInputs() {
                filterInputs.innerHTML = "";
                if (filtreDropdownWrap) {
                    filtreDropdownWrap.style.display = "none";
                }
                if (filtreBadge) {
                    filtreBadge.textContent = "0";
                }
                return;

                if (!state.filters.length) {
                    if (filtreDropdownWrap) {
                        filtreDropdownWrap.style.display = "none";
                    }
                    return;
                }

                if (filtreDropdownWrap) {
                    filtreDropdownWrap.style.display = "block";
                }
                if (filtreBadge) {
                    filtreBadge.textContent = String(state.filters.length);
                }

                state.filters.forEach(fieldKey => {
                    const col = document.createElement("div");
                    col.className = "pivot-filter-control";

                    const label = document.createElement("label");
                    label.className = "form-label";
                    label.textContent = fieldMeta[fieldKey].label;

                    const search = document.createElement("input");
                    search.type = "search";
                    search.className = "pivot-filter-search";
                    search.placeholder = "Ara...";

                    const list = document.createElement("div");
                    list.className = "pivot-filter-list";

                    const values = getDimensionOptions(fieldKey);
                    const selectedValues = getSelectedFilterValues(fieldKey);

                    const allWrap = document.createElement("label");
                    allWrap.className = "pivot-filter-option";
                    const allCheckbox = document.createElement("input");
                    allCheckbox.type = "checkbox";
                    allCheckbox.checked = selectedValues === null;
                    const allText = document.createElement("span");
                    allText.textContent = "Tümü";
                    allWrap.appendChild(allCheckbox);
                    allWrap.appendChild(allText);
                    list.appendChild(allWrap);

                    const optionRows = [];
                    values.forEach(v => {
                        const row = document.createElement("label");
                        row.className = "pivot-filter-option";
                        row.dataset.valueText = v.toLocaleLowerCase("tr-TR");

                        const cb = document.createElement("input");
                        cb.type = "checkbox";
                        cb.value = v;
                        cb.checked = selectedValues === null ? true : selectedValues.includes(v);

                        const text = document.createElement("span");
                        text.textContent = v;

                        row.appendChild(cb);
                        row.appendChild(text);
                        list.appendChild(row);
                        optionRows.push({ row, cb, value: v });
                    });

                    const refreshAllCheckbox = () => {
                        const selectedCount = optionRows.filter(x => x.cb.checked).length;
                        allCheckbox.checked = selectedCount === optionRows.length;
                        allCheckbox.indeterminate = selectedCount > 0 && selectedCount < optionRows.length;
                    };

                    const applySelection = () => {
                        const selected = optionRows.filter(x => x.cb.checked).map(x => x.value);
                        if (selected.length === optionRows.length) {
                            clearSelectedFilterValues(fieldKey);
                        } else {
                            setSelectedFilterValues(fieldKey, selected);
                        }

                        refreshAllCheckbox();
                        kullaniciEtkilesiminiIsaretle();
                        buildPivot();
                    };

                    allCheckbox.addEventListener("change", () => {
                        optionRows.forEach(x => {
                            x.cb.checked = allCheckbox.checked;
                        });
                        applySelection();
                    });

                    optionRows.forEach(x => {
                        x.cb.addEventListener("change", applySelection);
                    });

                    search.addEventListener("input", () => {
                        const q = search.value.trim().toLocaleLowerCase("tr-TR");
                        let visibleCount = 0;

                        optionRows.forEach(x => {
                            const visible = !q || x.row.dataset.valueText.includes(q);
                            x.row.style.display = visible ? "flex" : "none";
                            if (visible) {
                                visibleCount += 1;
                            }
                        });

                        let empty = list.querySelector(".pivot-filter-empty");
                        if (!visibleCount) {
                            if (!empty) {
                                empty = document.createElement("div");
                                empty.className = "pivot-filter-empty";
                                empty.textContent = "Sonuç bulunamadı";
                                list.appendChild(empty);
                            }
                        } else if (empty) {
                            empty.remove();
                        }
                    });

                    col.appendChild(label);
                    col.appendChild(search);
                    col.appendChild(list);
                    filterInputs.appendChild(col);
                });
            }

            function filterData() {
                const activeFilterFields = [...new Set([...state.filters, ...state.rows, ...state.columns])];
                return data.filter(row => {
                    return activeFilterFields.every(f => {
                        const selected = getSelectedFilterValues(f);
                        if (selected === null) {
                            return true;
                        }
                        if (!selected.length) {
                            return false;
                        }
                        return selected.includes(String(row[f] ?? "-"));
                    });
                });
            }

            function keyFromFields(row, fields) {
                if (!fields.length) {
                    return "__tek";
                }
                return fields.map(f => String(row[f] ?? "-")).join(" || ");
            }

            function labelFromKey(key) {
                if (key === "__tek") {
                    return ["-"];
                }
                return key.split(" || ");
            }

            function isDateField(fieldKey) {
                return fieldKey === "TestTarihi" || fieldKey === "DizaynTarihi";
            }

            function tryParseDate(value) {
                const text = String(value || "").trim();
                if (!text || text === "-") {
                    return null;
                }

                const t = Date.parse(text);
                if (!Number.isNaN(t)) {
                    return t;
                }

                return null;
            }

            function tryParseNumeric(value) {
                const text = String(value ?? "").trim();
                if (!text || text === "-") {
                    return null;
                }

                const direct = Number(text);
                if (Number.isFinite(direct)) {
                    return direct;
                }

                let cleaned = text
                    .replace(/\s+/g, "")
                    .replace(/[^0-9,.-]/g, "");

                if (!cleaned) {
                    return null;
                }

                const lastComma = cleaned.lastIndexOf(",");
                const lastDot = cleaned.lastIndexOf(".");

                if (lastComma > lastDot) {
                    cleaned = cleaned.replace(/\./g, "").replace(",", ".");
                } else if (lastDot > lastComma) {
                    cleaned = cleaned.replace(/,/g, "");
                }

                const parsed = Number(cleaned);
                return Number.isFinite(parsed) ? parsed : null;
            }

            function isNumericField(fieldKey) {
                return fieldMeta[fieldKey]?.dataType === "number";
            }

            function compareValuesByField(a, b, fieldKey) {
                if (isDateField(fieldKey)) {
                    const da = tryParseDate(a);
                    const db = tryParseDate(b);

                    if (da === null && db === null) return 0;
                    if (da === null) return 1;
                    if (db === null) return -1;

                    return db - da;
                }

                const na = tryParseNumeric(a);
                const nb = tryParseNumeric(b);
                if (isNumericField(fieldKey)) {
                    if (na === null && nb === null) {
                        return 0;
                    }
                    if (na === null) {
                        return 1;
                    }
                    if (nb === null) {
                        return -1;
                    }

                    return na - nb;
                }

                if (a == null && b == null) {
                    return 0;
                }
                if (a == null || a === "") {
                    return 1;
                }
                if (b == null || b === "") {
                    return -1;
                }

                return String(a ?? "").localeCompare(String(b ?? ""), "tr");
            }

            function sortValuesByField(values, fieldKey) {
                return [...values].sort((a, b) => compareValuesByField(a, b, fieldKey));
            }

            function getMasterDimensionOptions(fieldKey) {
                const raw = masterDimensionValues && typeof masterDimensionValues === "object"
                    ? masterDimensionValues[fieldKey]
                    : null;

                if (!Array.isArray(raw)) {
                    return [];
                }

                return raw
                    .map(v => String(v || "").trim())
                    .filter(v => !!v);
            }

            function getDimensionOptions(fieldKey) {
                const fromData = [...new Set(data.map(d => String(d[fieldKey] ?? "-")))];
                const fromMaster = getMasterDimensionOptions(fieldKey);
                const unique = [...new Set([...fromMaster, ...fromData])];
                return sortValuesByField(unique, fieldKey);
            }

            function getSelectedFilterValues(fieldKey) {
                if (!Object.prototype.hasOwnProperty.call(state.filterValues, fieldKey)) {
                    return null;
                }

                const raw = state.filterValues[fieldKey];
                if (!Array.isArray(raw)) {
                    return null;
                }
                return raw
                    .map(v => String(v ?? "").trim())
                    .filter(v => !!v);
            }

            function setSelectedFilterValues(fieldKey, values) {
                const normalized = Array.isArray(values)
                    ? values.map(v => String(v ?? "").trim()).filter(v => !!v)
                    : [];

                state.filterValues[fieldKey] = [...new Set(normalized)];
            }

            function clearSelectedFilterValues(fieldKey) {
                delete state.filterValues[fieldKey];
            }

            function closeDimensionPicker() {
                if (activeDimensionPicker && activeDimensionPicker.parentElement) {
                    activeDimensionPicker.remove();
                }
                activeDimensionPicker = null;
            }

            function openDimensionPicker(fieldKey, anchorElement) {
                closeDimensionPicker();

                const wrapper = document.createElement("div");
                wrapper.className = "pivot-dim-combobox";

                const title = document.createElement("div");
                title.className = "pivot-dim-combobox__title";
                title.textContent = `${fieldMeta[fieldKey].label} Seçimi`;

                const search = document.createElement("input");
                search.type = "search";
                search.className = "pivot-filter-search";
                search.placeholder = "Ara...";

                const list = document.createElement("div");
                list.className = "pivot-dim-combobox__list";

                const values = getDimensionOptions(fieldKey);
                const selectedValues = getSelectedFilterValues(fieldKey);

                const allWrap = document.createElement("label");
                allWrap.className = "pivot-filter-option";
                const allCheckbox = document.createElement("input");
                allCheckbox.type = "checkbox";
                allCheckbox.checked = selectedValues === null;
                const allText = document.createElement("span");
                allText.textContent = "Tümü";
                allWrap.appendChild(allCheckbox);
                allWrap.appendChild(allText);
                list.appendChild(allWrap);

                const optionRows = [];
                values.forEach(v => {
                    const row = document.createElement("label");
                    row.className = "pivot-filter-option";
                    row.dataset.valueText = v.toLocaleLowerCase("tr-TR");

                    const cb = document.createElement("input");
                    cb.type = "checkbox";
                    cb.value = v;
                    cb.checked = selectedValues === null ? true : selectedValues.includes(v);

                    const text = document.createElement("span");
                    text.textContent = v;

                    row.appendChild(cb);
                    row.appendChild(text);
                    list.appendChild(row);
                    optionRows.push({ row, cb, value: v });
                });

                const refreshAllCheckbox = () => {
                    const selectedCount = optionRows.filter(x => x.cb.checked).length;
                    allCheckbox.checked = selectedCount === optionRows.length;
                    allCheckbox.indeterminate = selectedCount > 0 && selectedCount < optionRows.length;
                };

                const applySelection = () => {
                    const selected = optionRows.filter(x => x.cb.checked).map(x => x.value);
                    if (selected.length === optionRows.length) {
                        clearSelectedFilterValues(fieldKey);
                    } else {
                        setSelectedFilterValues(fieldKey, selected);
                    }
                    refreshAllCheckbox();
                    kullaniciEtkilesiminiIsaretle();
                    buildPivot();
                };

                allCheckbox.addEventListener("change", () => {
                    optionRows.forEach(x => {
                        x.cb.checked = allCheckbox.checked;
                    });
                    applySelection();
                });

                optionRows.forEach(x => {
                    x.cb.addEventListener("change", applySelection);
                });

                search.addEventListener("input", () => {
                    const q = search.value.trim().toLocaleLowerCase("tr-TR");
                    let visibleCount = 0;

                    optionRows.forEach(x => {
                        const visible = !q || x.row.dataset.valueText.includes(q);
                        x.row.style.display = visible ? "flex" : "none";
                        if (visible) {
                            visibleCount += 1;
                        }
                    });

                    let empty = list.querySelector(".pivot-filter-empty");
                    if (!visibleCount) {
                        if (!empty) {
                            empty = document.createElement("div");
                            empty.className = "pivot-filter-empty";
                            empty.textContent = "Sonuç bulunamadı";
                            list.appendChild(empty);
                        }
                    } else if (empty) {
                        empty.remove();
                    }
                });

                wrapper.appendChild(title);
                wrapper.appendChild(search);
                wrapper.appendChild(list);
                document.body.appendChild(wrapper);

                const rect = anchorElement.getBoundingClientRect();
                const left = Math.min(rect.left, window.innerWidth - wrapper.offsetWidth - 10);
                const top = Math.min(rect.bottom + 8, window.innerHeight - wrapper.offsetHeight - 10);
                wrapper.style.left = `${Math.max(8, left)}px`;
                wrapper.style.top = `${Math.max(8, top)}px`;

                activeDimensionPicker = wrapper;

                const closeOnClick = (ev) => {
                    if (!activeDimensionPicker) {
                        return;
                    }
                    if (activeDimensionPicker.contains(ev.target) || anchorElement.contains(ev.target)) {
                        return;
                    }
                    closeDimensionPicker();
                    document.removeEventListener("mousedown", closeOnClick, true);
                };

                document.addEventListener("mousedown", closeOnClick, true);
            }

            function cartesianJoin(valuesByField) {
                if (!valuesByField.length) {
                    return ["__tek"];
                }

                let combos = [[]];
                valuesByField.forEach(values => {
                    if (!values.length) {
                        combos = [];
                        return;
                    }
                    const next = [];
                    combos.forEach(prefix => {
                        values.forEach(v => next.push([...prefix, v]));
                    });
                    combos = next;
                });

                return combos.map(parts => parts.join(" || "));
            }

            function getForcedAxisKeys(fields) {
                if (!fields.length) {
                    return ["__tek"];
                }

                const valuesByField = fields.map(fieldKey => {
                    const selected = getSelectedFilterValues(fieldKey);
                    if (selected === null) {
                        return [];
                    }
                    return selected;
                });

                if (valuesByField.some(arr => !arr.length)) {
                    return [];
                }

                return cartesianJoin(valuesByField);
            }

            function sortKeysByFields(keys, fields) {
                if (!fields.length) {
                    return [...keys];
                }

                return [...keys].sort((a, b) => {
                    const labelsA = labelFromKey(a);
                    const labelsB = labelFromKey(b);

                    for (let i = 0; i < fields.length; i += 1) {
                        const cmp = compareValuesByField(labelsA[i], labelsB[i], fields[i]);
                        if (cmp !== 0) {
                            return cmp;
                        }
                    }

                    return 0;
                });
            }

            function initAgg(agg) {
                if (agg === "min") return { min: Number.POSITIVE_INFINITY };
                if (agg === "max") return { max: Number.NEGATIVE_INFINITY };
                if (agg === "count") return { count: 0 };
                return { sum: 0, count: 0 };
            }

            function updateAgg(acc, agg, value) {
                const n = toNumber(value);
                if (agg === "sum") {
                    acc.sum += n;
                } else if (agg === "avg") {
                    acc.sum += n;
                    acc.count += 1;
                } else if (agg === "count") {
                    acc.count += 1;
                } else if (agg === "min") {
                    acc.min = Math.min(acc.min, n);
                } else if (agg === "max") {
                    acc.max = Math.max(acc.max, n);
                }
            }

            function finishAgg(acc, agg) {
                if (agg === "sum") return acc.sum;
                if (agg === "avg") return acc.count ? acc.sum / acc.count : 0;
                if (agg === "count") return acc.count;
                if (agg === "min") return acc.min === Number.POSITIVE_INFINITY ? 0 : acc.min;
                if (agg === "max") return acc.max === Number.NEGATIVE_INFINITY ? 0 : acc.max;
                return 0;
            }

            function formatNumber(value) {
                return Number(value).toLocaleString("tr-TR", {
                    minimumFractionDigits: state.options.decimalPlaces,
                    maximumFractionDigits: state.options.decimalPlaces
                });
            }

            function valueLabel(v) {
                return `${fieldMeta[v.key].label} (${aggLabel[v.agg]})`;
            }

            function formatHeaderCell(mainText, topText = "") {
                const safeMain = mainText || "-";
                if (!topText) {
                    return `<div class=\"pivot-th-main\">${safeMain}</div>`;
                }
                return `<div class=\"pivot-th-top\">${topText}</div><div class=\"pivot-th-main\">${safeMain}</div>`;
            }

            function formatColumnHeaderText(columnKey) {
                if (!state.columns.length) {
                    return "";
                }

                const labels = labelFromKey(columnKey);
                return labels
                    .map((label, idx) => {
                        const fieldKey = state.columns[idx];
                        if (fieldKey === "GucKVA") {
                            return `Güç ${label}`;
                        }
                        return label;
                    })
                    .join(" / ");
            }

            function buildPivot() {
                if (!state.rows.length || !state.values.length) {
                    table.innerHTML = "";
                    tableHolder.style.display = "none";
                    pivotKaydetBtn.style.display = "none";
                    emptyState.style.display = "block";
                    
                    let mesaj = "Analize başlamak için alanları kutucuklara yerleştirin";
                    if (!state.rows.length && state.values.length) {
                        mesaj = "⚠️ En az bir Satır alanı seçmelisiniz";
                    } else if (state.rows.length && !state.values.length) {
                        mesaj = "⚠️ En az bir Değer alanı seçmelisiniz";
                    } else if (!state.rows.length && !state.values.length) {
                        mesaj = "⚠️ Satır ve Değer alanları zorunludur";
                    }
                    
                    emptyState.querySelector("h6").textContent = mesaj;
                    console.warn("[Pivot] Boş pivot:", { rows: state.rows.length, values: state.values.length, mesaj });
                    
                    state.chartModel = null;
                    syncActiveChartIfVisible();
                    setView("table");
                    syncStageHeight();
                    // Avoid persisting incomplete layouts (prevents accidental row resets).
                    return;
                }

                const filtered = filterData();
                const hasFilteredRows = filtered.length > 0;

                if (!hasFilteredRows) {
                    const hasAnyExplicitSelection = state.filters.some(f => getSelectedFilterValues(f) !== null);
                    if (!hasAnyExplicitSelection) {
                        table.innerHTML = "";
                        tableHolder.style.display = "none";
                        pivotKaydetBtn.style.display = "none";
                        emptyState.style.display = "block";
                        emptyState.querySelector("h6").textContent = "Seçili filtrelerle eşleşen kayıt bulunamadı";
                        state.chartModel = null;
                        syncActiveChartIfVisible();
                        setView("table");
                        syncStageHeight();
                        return;
                    }
                }

                emptyState.querySelector("h6").textContent = "Analize başlamak için alanları kutucuklara yerleştirin";
                let rowKeys = hasFilteredRows
                    ? sortKeysByFields([...new Set(filtered.map(r => keyFromFields(r, state.rows)))], state.rows)
                    : getForcedAxisKeys(state.rows);

                const colKeys = state.columns.length
                    ? (hasFilteredRows
                        ? sortKeysByFields([...new Set(filtered.map(r => keyFromFields(r, state.columns)))], state.columns)
                        : getForcedAxisKeys(state.columns))
                    : ["__tek"];

                if (!rowKeys.length || !colKeys.length) {
                    table.innerHTML = "";
                    tableHolder.style.display = "none";
                    pivotKaydetBtn.style.display = "none";
                    emptyState.style.display = "block";
                    emptyState.querySelector("h6").textContent = "Seçili filtrelerle eşleşen kayıt bulunamadı";
                    state.chartModel = null;
                    syncActiveChartIfVisible();
                    setView("table");
                    syncStageHeight();
                    return;
                }

                const matrix = new Map();
                const comboRecords = new Map();
                const columnTotals = new Map();

                filtered.forEach(r => {
                    const rk = keyFromFields(r, state.rows);
                    const ck = keyFromFields(r, state.columns);
                    const key = `${rk}##${ck}`;
                    if (!matrix.has(key)) {
                        const initial = state.values.map(v => initAgg(v.agg));
                        matrix.set(key, initial);
                    }
                    const bucket = matrix.get(key);
                    state.values.forEach((v, i) => updateAgg(bucket[i], v.agg, r[v.key]));

                    if (!columnTotals.has(ck)) {
                        columnTotals.set(ck, state.values.map(v => initAgg(v.agg)));
                    }

                    const totalBucket = columnTotals.get(ck);
                    state.values.forEach((v, i) => updateAgg(totalBucket[i], v.agg, r[v.key]));

                    if (!comboRecords.has(key)) {
                        comboRecords.set(key, []);
                    }
                    comboRecords.get(key).push(r);
                });

                if (state.values.length) {
                    const rowVectorMap = new Map();
                    const hasNumericAxisField = [...state.rows, ...state.columns].some(fieldKey => isNumericField(fieldKey));
                    const hasDateAxisField = [...state.rows, ...state.columns].some(fieldKey => isDateField(fieldKey));

                    rowKeys.forEach(rk => {
                        const vector = [];

                        colKeys.forEach(ck => {
                            const comboKey = `${rk}##${ck}`;
                            const combo = matrix.get(comboKey);

                            state.values.forEach((v, i) => {
                                const val = combo ? finishAgg(combo[i], v.agg) : 0;
                                vector.push(Number.isFinite(Number(val)) ? Number(val) : 0);
                            });
                        });

                        rowVectorMap.set(rk, vector);
                    });

                    if (!hasNumericAxisField && !hasDateAxisField) {
                        rowKeys = [...rowKeys].sort((a, b) => {
                            const vecA = rowVectorMap.get(a) || [];
                            const vecB = rowVectorMap.get(b) || [];

                            const totalA = vecA.reduce((sum, n) => sum + n, 0);
                            const totalB = vecB.reduce((sum, n) => sum + n, 0);
                            if (totalA !== totalB) {
                                return totalA - totalB;
                            }

                            const nonZeroA = vecA.reduce((count, n) => count + (n > 0 ? 1 : 0), 0);
                            const nonZeroB = vecB.reduce((count, n) => count + (n > 0 ? 1 : 0), 0);
                            if (nonZeroA !== nonZeroB) {
                                return nonZeroA - nonZeroB;
                            }

                            return a.localeCompare(b, "tr");
                        });
                    } else {
                        rowKeys = sortKeysByFields(rowKeys, state.rows);
                    }
                }

                const headRow = [];
                const metricHeaders = [];
                state.rows.forEach(f => {
                    headRow.push(formatHeaderCell(fieldMeta[f].label));
                });
                colKeys.forEach(ck => {
                    const colName = formatColumnHeaderText(ck);
                    state.values.forEach(v => {
                        const metricText = valueLabel(v);
                        headRow.push(formatHeaderCell(metricText, colName));
                        metricHeaders.push(colName ? `${colName} / ${metricText}` : metricText);
                    });
                });

                const chartModel = {
                    labels: [],
                    series: metricHeaders.map(h => ({ name: h, data: [] }))
                };

                let html = "<thead><tr>";
                headRow.forEach(h => {
                    html += `<th>${h}</th>`;
                });
                html += "</tr></thead><tbody>";

                rowKeys.forEach(rk => {
                    const rowLabels = labelFromKey(rk);
                    chartModel.labels.push(rowLabels.join(" / "));
                    html += "<tr>";
                    rowLabels.forEach(x => {
                        html += `<th>${x}</th>`;
                    });

                    let seriesIndex = 0;

                    colKeys.forEach(ck => {
                        const combo = matrix.get(`${rk}##${ck}`) || state.values.map(v => initAgg(v.agg));
                        state.values.forEach((v, i) => {
                            const val = finishAgg(combo[i], v.agg);
                            chartModel.series[seriesIndex].data.push(Number(val));
                            seriesIndex += 1;

                            const matchedRows = comboRecords.get(`${rk}##${ck}`) || [];
                            const recordIds = matchedRows
                                .map(x => Number(x.Id))
                                .filter(x => Number.isFinite(x) && x > 0);

                            if (recordIds.length) {
                                const rowText = rowLabels.join(" / ");
                                const colText = state.columns.length ? labelFromKey(ck).join(" / ") : "-";
                                const title = escapeHtml(`${rowText} | ${colText} | ${valueLabel(v)}`);
                                html += `<td class='pivot-drill-cell' data-record-ids='${recordIds.join(",")}' data-drill-title='${title}' title='Çift tıkla: kayıtları görüntüle'>${formatNumber(val)}</td>`;
                            } else {
                                html += `<td>${formatNumber(val)}</td>`;
                            }
                        });
                    });

                    html += "</tr>";
                });

                if (state.options.showGrandTotals) {
                    html += "<tr class='pivot-grand-row'>";
                    html += `<th colspan='${Math.max(1, state.rows.length)}'>Genel Toplam</th>`;

                    const cellCount = colKeys.length * state.values.length;
                    for (let i = 0; i < cellCount; i++) {
                        const colIdx = Math.floor(i / state.values.length);
                        const ck = colKeys[colIdx];
                        const valIdx = i % state.values.length;
                        const v = state.values[valIdx];
                        const totalsForCol = columnTotals.get(ck) || state.values.map(x => initAgg(x.agg));
                        const totalVal = finishAgg(totalsForCol[valIdx], v.agg);
                        html += `<td class='pivot-total-cell'>${formatNumber(totalVal)}</td>`;
                    }

                    html += "</tr>";
                }

                html += "</tbody>";
                table.innerHTML = html;

                table.querySelectorAll("td.pivot-drill-cell").forEach(cell => {
                    cell.addEventListener("dblclick", function () {
                        const ids = this.dataset.recordIds || "";
                        if (!ids) {
                            return;
                        }

                        const title = this.dataset.drillTitle || "Pivot Hücre Detayı";
                        const url = `/TrafoTests/PivotKayitlar?ids=${encodeURIComponent(ids)}&title=${encodeURIComponent(title)}`;
                        window.open(url, "_blank");
                    });
                });

                tableHolder.style.display = "block";
                pivotKaydetBtn.style.display = "inline-flex";
                emptyState.style.display = "none";
                state.chartModel = chartModel;

                if (state.options.compactRows) {
                    reportWrap.classList.add("pivot-row-compact");
                } else {
                    reportWrap.classList.remove("pivot-row-compact");
                }

                syncStageHeight();
                pivotTaslakKaydet();
                syncActiveChartIfVisible();
            }

            function applyDefaultSetup() {
                state.rows = ["Musteri"];
                state.columns = ["Muhendis"];
                state.filters = ["Sonuc"];
                state.values = [
                    { key: "P0SapmaHT", agg: "avg" },
                    { key: "PkSapmaHT", agg: "avg" },
                    { key: "UkSapmaHT", agg: "avg" },
                    { key: "Musteri", agg: "count" }
                ];
                state.filterValues = {};
                renderZoneTags();
                renderFilterInputs();
                buildPivot();
            }

            document.getElementById("filtreTemizleBtn").addEventListener("click", function () {
                kayitliTabloOdakModuAyarla(false);
                pivotDurumunuSifirla();
            });

            kayitliTablolarBtn.addEventListener("click", async function () {
                const mod = kayitliTablolarBtn.dataset.mode || "liste";
                kayitliTablolarGorunumunuAc();
                if (mod === "geri-don") {
                    await kayitliTablolariListele();
                    return;
                }
                await kayitliTablolariListele();
            });

            analizeDonBtn.addEventListener("click", function () {
                analizGorunumunuAc();
            });

            pivotKaydetBtn.addEventListener("click", async function () {
                try {
                    if (!table.tHead || !table.tBodies.length || !state.rows.length || !state.values.length) {
                        await Swal.fire({
                            icon: "info",
                            title: "Kaydedilecek tablo yok",
                            text: "Önce bir pivot tablo oluşturun."
                        });
                        return;
                    }

                    const result = await Swal.fire({
                        title: "Pivot Tabloyu Kaydet",
                        input: "text",
                        inputLabel: "Tablo adı",
                        showCancelButton: true,
                        confirmButtonText: "Kaydet",
                        cancelButtonText: "Vazgeç",
                        buttonsStyling: false,
                        customClass: {
                            popup: "pivot-swal",
                            title: "pivot-swal-title",
                            input: "pivot-swal-input",
                            actions: "pivot-swal-actions",
                            confirmButton: "pivot-swal-confirm",
                            cancelButton: "pivot-swal-cancel"
                        },
                        showClass: {
                            popup: "",
                            backdrop: ""
                        },
                        hideClass: {
                            popup: ""
                        },
                        inputValidator: value => {
                            if (!value || !value.trim()) {
                                return "Tablo adı zorunludur.";
                            }
                            if (value.trim().length > 150) {
                                return "Tablo adı en fazla 150 karakter olabilir.";
                            }
                            return null;
                        }
                    });

                    if (!result.isConfirmed) {
                        return;
                    }

                    const response = await fetch("/TrafoTests/KaydetPivotTablo", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "X-Requested-With": "XMLHttpRequest"
                        },
                        body: JSON.stringify({
                            TabloAdi: result.value.trim(),
                            KonfigJson: JSON.stringify(mevcutKonfigOlustur())
                        })
                    });

                    const payload = await parseJsonResponseSafe(response);
                    if (!response.ok || !payload.success) {
                        throw new Error(payload.message || `Kaydetme işlemi başarısız (${response.status}).`);
                    }

                    await Swal.fire({
                        icon: "success",
                        title: "Kaydedildi",
                        text: payload.message || "Pivot tablo kaydedildi.",
                        timer: 1200,
                        showConfirmButton: false
                    });

                    pivotDurumunuSifirla();
                } catch (error) {
                    await Swal.fire({
                        icon: "error",
                        title: "Hata",
                        text: error.message || "Pivot tablo kaydedilemedi."
                    });
                }
            });

            if (pivotGuncelleBtn) {
                pivotGuncelleBtn.addEventListener("click", async function () {
                    try {
                        if (!aktifKayitId || !Number.isFinite(Number(aktifKayitId))) {
                            await Swal.fire({
                                icon: "info",
                                title: "Kayıt seçilmedi",
                                text: "Güncelleme için önce Kayıtlı Tablolarım listesinden bir tablo açın."
                            });
                            return;
                        }

                        const response = await fetch("/TrafoTests/PivotTabloGuncelle", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                                "X-Requested-With": "XMLHttpRequest"
                            },
                            body: JSON.stringify({
                                Id: Number(aktifKayitId),
                                KonfigJson: JSON.stringify(mevcutKonfigOlustur())
                            })
                        });

                        const payload = await parseJsonResponseSafe(response);
                        if (!response.ok || !payload.success) {
                            throw new Error(payload.message || `Güncelleme işlemi başarısız (${response.status}).`);
                        }

                        // Veritabanından güncel konfigürasyonu yükle
                        const detayResponse = await fetch(`/TrafoTests/PivotTabloDetay?id=${aktifKayitId}`, {
                            method: "GET",
                            headers: { "X-Requested-With": "XMLHttpRequest" }
                        });
                        const detayPayload = await parseJsonResponseSafe(detayResponse);
                        if (detayResponse.ok && detayPayload.success && detayPayload.data) {
                            const konfigJson = detayPayload.data.konfigJson || detayPayload.data.KonfigJson;
                            if (konfigJson) {
                                const konfig = JSON.parse(konfigJson);
                                konfigUygula(konfig);
                                kullaniciElleDegisiklikYapti = false;
                                pivotTaslakTemizle();
                            }
                        }

                        await Swal.fire({
                            icon: "success",
                            title: "Başarılı",
                            text: payload.message || "Değişiklikler başarıyla kaydedildi"
                        });
                        if (aktifKayitId) {
                            kayitliTabloOdakModuAyarla(true);
                        }
                    } catch (error) {
                        await Swal.fire({
                            icon: "error",
                            title: "Hata",
                            text: error.message || "Güncelleme sırasında hata oluştu."
                        });
                    }
                });
            }

            document.getElementById("applyOzelBtn").addEventListener("click", function () {
                state.options.showGrandTotals = document.getElementById("showGrandTotals").checked;
                state.options.compactRows = document.getElementById("compactRows").checked;
                state.options.decimalPlaces = Number(document.getElementById("decimalPlaces").value);
                kullaniciEtkilesiminiIsaretle();
                buildPivot();

                const modalEl = document.getElementById("pivotOzelModal");
                const instance = bootstrap.Modal.getInstance(modalEl);
                if (instance) {
                    instance.hide();
                }
            });

            document.getElementById("excelBtn").addEventListener("click", function () {
                if (!table.tHead || !table.tBodies.length) {
                    return;
                }
                const wb = XLSX.utils.book_new();
                const ws = XLSX.utils.table_to_sheet(table);
                XLSX.utils.book_append_sheet(wb, ws, "Analiz");
                XLSX.writeFile(wb, "trafo-analiz-raporu.xlsx");
            });

            document.getElementById("pdfBtn").addEventListener("click", function () {
                if (!table.tHead || !table.tBodies.length) {
                    return;
                }
                const { jsPDF } = window.jspdf;
                const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "a4" });

                const headers = [...table.querySelectorAll("thead th")].map(x => x.textContent.trim());
                const body = [...table.querySelectorAll("tbody tr")].map(row =>
                    [...row.children].map(cell => cell.textContent.trim())
                );

                doc.text("Trafo Analiz Raporu", 40, 30);
                doc.autoTable({
                    head: [headers],
                    body: body,
                    startY: 45,
                    styles: { fontSize: 8, cellPadding: 4 },
                    headStyles: { fillColor: [235, 235, 237], textColor: [68, 64, 80] }
                });

                doc.save("trafo-analiz-raporu.pdf");
            });

            document.querySelectorAll(".pivot-chart-option").forEach(item => {
                item.addEventListener("click", function () {
                    const type = item.dataset.chartType;
                    if (renderChart(type)) {
                        setView("chart");
                    }
                });
            });

            tabloyaDonBtn.addEventListener("click", function () {
                setView("table");
            });

            renderFieldLists();
            setupDropZones();
            setActivePivotAdi("");
            kayitliTablolarButonunuAyarla(false);

            // Düzenle butonuna tıklandığında yeni sekmede aç
            if (pivotDuzenleBtn) {
                pivotDuzenleBtn.addEventListener("click", function () {
                    if (!aktifKayitId) return;
                    window.open(`/TrafoTests/Analiz?editPivot=${aktifKayitId}`, "_blank");
                });
            }

            // URL'de editPivot/viewPivot parametresi varsa, ilgili tabloyu yükle
            const yuklenecekPivotId = (Number.isFinite(editPivotId) && editPivotId > 0)
                ? editPivotId
                : ((Number.isFinite(viewPivotId) && viewPivotId > 0) ? viewPivotId : 0);

            if (yuklenecekPivotId > 0) {
                (async () => {
                    try {
                        console.log("[Pivot] Pivot tablosu yükleniyor (ID:", yuklenecekPivotId, ")");
                        emptyState.style.display = "block";
                        emptyState.querySelector("h6").textContent = "Tablo yükleniyor...";
                        tableHolder.style.display = "none";
                        pivotKaydetBtn.style.display = "none";

                        const response = await fetch(`/TrafoTests/PivotTabloDetay?id=${yuklenecekPivotId}`, {
                            method: "GET",
                            headers: { "X-Requested-With": "XMLHttpRequest" }
                        });
                        const payload = await response.json();
                        if (!response.ok || !payload.success) throw new Error(payload.message || "Kayıt yüklenemedi.");
                        const konfigJson = (payload.data || {}).konfigJson || (payload.data || {}).KonfigJson;
                        if (!konfigJson) throw new Error("Kayıtlı tablo içeriği bulunamadı.");
                        if (kullaniciElleDegisiklikYapti) {
                            console.log("[Pivot] Kullanıcı tarafından yapılan değişiklikler var, yükleme iptal edildi");
                            return;
                        }
                        setActivePivotState(yuklenecekPivotId, (payload.data || {}).ad || (payload.data || {}).Ad || "");
                        konfigUygula(JSON.parse(konfigJson));
                        analizGorunumunuAc(true);
                        console.log("[Pivot] Pivot tablosu başarıyla yüklendi");
                    } catch (e) {
                        console.error("[Pivot] Yükleme hatası:", e);
                        emptyState.style.display = "block";
                        emptyState.querySelector("h6").textContent = "Tablo yüklenemedi: " + (e.message || "Bilinmeyen hata");
                        buildPivot();
                    }
                })();
            } else if (forcePivotReset) {
                // Preserve draft if present; reset signal should not unexpectedly wipe in-progress setup.
                if (!pivotTaslakYukle()) {
                    buildPivot();
                }
            } else if (!pivotTaslakYukle()) {
                buildPivot();
            }
            window.addEventListener("resize", syncStageHeight);
        });
    </script>
}
