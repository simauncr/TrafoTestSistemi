@{
    ViewData["Title"] = "Trafo Analiz Raporu";
}

<div class="container-fluid mt-3">
    <div class="app-page-header mb-3">
        <div>
            <span class="app-page-header__eyebrow">Analiz Paneli</span>
        </div>
        <a asp-action="Index" class="btn btn-outline-primary btn-sm">Listeye Dön</a>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card app-stat-card app-stat-card--primary">
                <div class="card-body app-stat-card__body">
                    <div>
                        <div class="app-stat-card__label">Toplam Yapılan Test</div>
                        <p class="app-stat-card__value">@(ViewBag.Toplam ?? 0)</p>
                        <div class="app-stat-card__subtext">Kayıt altına alınan tüm testler</div>
                    </div>
                    <span class="app-stat-card__icon"><i class="fa-solid fa-bolt"></i></span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card app-stat-card app-stat-card--success">
                <div class="card-body app-stat-card__body">
                    <div>
                        <div class="app-stat-card__label">Uygun</div>
                        <p class="app-stat-card__value">@(ViewBag.Uygun ?? 0)</p>
                        <div class="app-stat-card__subtext">Spesifikasyona uyan testler</div>
                    </div>
                    <span class="app-stat-card__icon"><i class="fa-solid fa-circle-check"></i></span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card app-stat-card app-stat-card--danger">
                <div class="card-body app-stat-card__body">
                    <div>
                        <div class="app-stat-card__label">Uygun Değil</div>
                        <p class="app-stat-card__value">@(ViewBag.UygunDegil ?? 0)</p>
                        <div class="app-stat-card__subtext">Revizyon veya inceleme isteyen testler</div>
                    </div>
                    <span class="app-stat-card__icon"><i class="fa-solid fa-triangle-exclamation"></i></span>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-6 mx-auto">
            <div class="card app-card-muted">
                <div class="card-header">
                    <h5 class="card-title mb-0 text-center fw-bold">Uygunluk Dağılımı</h5>
                </div>
                <div class="card-body p-4">
                    <canvas id="trafoPieChart" style="max-height: 350px;"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const ctx = document.getElementById('trafoPieChart').getContext('2d');
            const uygun = @(ViewBag.Uygun ?? 0);
            const uygunDegil = @(ViewBag.UygunDegil ?? 0);

            if (uygun === 0 && uygunDegil === 0) {
                ctx.font = "16px Arial";
                ctx.textAlign = "center";
                ctx.fillText("Henüz analiz edilecek veri bulunmuyor.", ctx.canvas.width/2, ctx.canvas.height/2);
            } else {
                new Chart(ctx, {
                    type: 'pie',
                    data: {
                        labels: ['Uygun Trafolar', 'Uygun Olmayan Trafolar'],
                        datasets: [{
                            data: [uygun, uygunDegil],
                            backgroundColor: ['#198754', '#dc3545'],
                            hoverOffset: 15,
                            borderWidth: 2,
                            borderColor: '#fff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { padding: 20, font: { size: 14 } }
                            }
                        }
                    }
                });
            }
        });
    </script>
}