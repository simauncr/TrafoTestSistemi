        }

        .pivot-modal-header {
            background: linear-gradient(180deg, rgba(var(--app-primary-rgb), 0.14), rgba(var(--app-primary-rgb), 0.06));
            border-bottom: 1px solid rgba(var(--app-primary-rgb), 0.2);
        }

        .pivot-row-compact .pivot-result-table th,
        .pivot-row-compact .pivot-result-table td {
