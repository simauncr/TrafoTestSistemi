            padding-bottom: 0.42rem;
        }

        @@media (max-width: 991.98px) {
            .pivot-zone-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .pivot-filter-dropdown-menu {
                min-width: 280px;
            }

            .pivot-chart-wrap {
                height: 34vh;
            }
        }

        @@media (max-width: 575.98px) {
            .pivot-zone-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jspdf-autotable@3.8.2/dist/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const analysisRecords = @Html.Raw(analysisJson);

            const fieldMeta = {
                Musteri: { label: "Müşteri", type: "dimension" },
                ProjeAdi: { label: "Proje Adı", type: "dimension" },
                TasarimNo: { label: "Tasarım No", type: "dimension" },
                DizaynId: { label: "Dizayn Id", type: "dimension" },
                MusteriProje: { label: "Müşteri / Proje", type: "dimension" },
                ElektrikMuhendisi: { label: "Elektrik Mühendisi", type: "dimension" },
                MekanikMuhendisi: { label: "Mekanik Mühendisi", type: "dimension" },
                Muhendis: { label: "Sorumlu Mühendis", type: "dimension" },
                BaglantiGrubu: { label: "Bağlantı Grubu", type: "dimension" },
                CekirdekTipi: { label: "Çekirdek Tipi", type: "dimension" },
                SacCinsi: { label: "Sac Cinsi", type: "dimension" },
                KazanCinsi: { label: "Kazan Cinsi", type: "dimension" },
                YagCinsi: { label: "Yağ Cinsi", type: "dimension" },
                Sonuc: { label: "Sonuç", type: "dimension" },
                TestTarihi: { label: "Test Tarihi", type: "dimension" },
                DizaynTarihi: { label: "Dizayn Tarihi", type: "dimension" },
                GucKVA: { label: "Güç (kVA)", type: "measure" },
                GerilimYG: { label: "YG Gerilim", type: "measure" },
                GerilimAG: { label: "AG Gerilim", type: "measure" },
                Frekans: { label: "Frekans", type: "measure" },
                P0Sapma: { label: "P0 Sapma", type: "measure" },
                PkSapma: { label: "Pk Sapma", type: "measure" },
                UkSapma: { label: "UK Sapma", type: "measure" }
            };

            const aggLabel = {
                sum: "Toplam",
                avg: "Ortalama",
                count: "Adet",
                min: "En Küçük",
                max: "En Büyük"
            };

            function toNumber(value) {
                const n = Number(value);
                return Number.isFinite(n) ? n : 0;
            }

            const data = analysisRecords.map(r => ({
                Musteri: r.Musteri || "Tanımsız",
                ProjeAdi: r.ProjeAdi || "Tanımsız",
                TasarimNo: r.TasarimNo || "Tanımsız",
                DizaynId: r.DizaynId || "Tanımsız",
                MusteriProje: r.MusteriProje || "Tanımsız / Tanımsız",
                ElektrikMuhendisi: r.ElektrikMuhendisi || "Tanımsız",
                MekanikMuhendisi: r.MekanikMuhendisi || "Tanımsız",
                Muhendis: r.Muhendis || "Tanımsız",
                BaglantiGrubu: r.BaglantiGrubu || "Tanımsız",
                CekirdekTipi: r.CekirdekTipi || "Tanımsız",
                SacCinsi: r.SacCinsi || "Tanımsız",
                KazanCinsi: r.KazanCinsi || "Tanımsız",
                YagCinsi: r.YagCinsi || "Tanımsız",
                Sonuc: r.Sonuc || "BEKLEMEDE",
                TestTarihi: r.TestTarihi || "-",
                DizaynTarihi: r.DizaynTarihi || "-",
                GucKVA: toNumber(r.Guc),
                GerilimYG: toNumber(r.GerilimYG),
                GerilimAG: toNumber(r.GerilimAG),
                Frekans: toNumber(r.Frekans),
                P0Sapma: toNumber(r.P0Sapma),
                PkSapma: toNumber(r.PkSapma),
                UkSapma: toNumber(r.UkSapma)
            }));

            const state = {
                targetZone: "rows",
                rows: [],
                columns: [],
                filters: [],
                values: [],
                filterValues: {},
                chartModel: null,
                chartInstance: null,
                options: {
                    showGrandTotals: true,
                    compactRows: false,
                    decimalPlaces: 2
                }
            };

            function isValidZoneForField(fieldKey, zone) {
                const meta = fieldMeta[fieldKey];
                if (!meta) {
                    return false;
                }
                return true;
            }

            const zones = {
                rows: document.getElementById("zone-rows"),
                columns: document.getElementById("zone-columns"),
                values: document.getElementById("zone-values"),
                filters: document.getElementById("zone-filters")
            };

            const emptyState = document.getElementById("pivotEmptyState");
            const tableHolder = document.getElementById("pivotTableHolder");
            const table = document.getElementById("pivotResultTable");
            const filterInputs = document.getElementById("dynamicFilterInputs");
            const filtreDropdownWrap = document.getElementById("aktifFiltreDropdownWrap");
            const filtreBadge = document.getElementById("aktifFiltreBadge");
            const reportWrap = document.getElementById("pivotReportWrap");
            const viewStage = document.getElementById("pivotViewStage");
            const tablePanel = document.getElementById("pivotTablePanel");
            const chartPanel = document.getElementById("pivotChartPanel");
            const chartCanvas = document.getElementById("pivotChartCanvas");
            const tabloyaDonBtn = document.getElementById("tabloyaDonBtn");
            const analizCalismaAlani = document.getElementById("analizCalismaAlani");
            const kayitliTablolarBtn = document.getElementById("kayitliTablolarBtn");
            const kayitliTablolarSayfasi = document.getElementById("kayitliTablolarSayfasi");
            const kayitliTablolarListe = document.getElementById("kayitliTablolarListe");
            const analizeDonBtn = document.getElementById("analizeDonBtn");
            const pivotKaydetBtn = document.getElementById("pivotKaydetBtn");

            function kayitliTablolarButonunuAyarla(geriDonModu) {
                if (geriDonModu) {
                    kayitliTablolarBtn.dataset.mode = "geri-don";
                    kayitliTablolarBtn.innerHTML = "<i class='fa-solid fa-arrow-left me-1'></i>Geri Dön";
                    return;
                }

                kayitliTablolarBtn.dataset.mode = "liste";
                kayitliTablolarBtn.innerHTML = "<i class='fa-solid fa-bookmark me-1'></i>Kayıtlı Tablolarım";
            }

            function escapeHtml(text) {
                return String(text || "")
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/\"/g, "&quot;")
                    .replace(/'/g, "&#39;");
            }

            function mevcutKonfigOlustur() {
                return {
                    rows: [...state.rows],
                    columns: [...state.columns],
                    filters: [...state.filters],
                    values: state.values.map(v => ({ key: v.key, agg: v.agg })),
                    filterValues: { ...state.filterValues },
                    options: {
                        showGrandTotals: !!state.options.showGrandTotals,
                        compactRows: !!state.options.compactRows,
                        decimalPlaces: Number(state.options.decimalPlaces)
                    }
                };
            }

            function konfigUygula(konfig) {
                if (!konfig) {
                    return;
                }

                const diziTemizle = (dizi, tur) => (Array.isArray(dizi) ? dizi : [])
                    .filter(k => fieldMeta[k] && (!tur || fieldMeta[k].type === tur));

                state.rows = diziTemizle(konfig.rows, "dimension");
                state.columns = diziTemizle(konfig.columns, "dimension");
                state.filters = diziTemizle(konfig.filters, "dimension");

                state.values = (Array.isArray(konfig.values) ? konfig.values : [])
                    .filter(v => v && fieldMeta[v.key] && ["sum", "avg", "count", "min", "max"].includes(v.agg))
                    .map(v => ({ key: v.key, agg: v.agg }));

                state.filterValues = {};
                if (konfig.filterValues && typeof konfig.filterValues === "object") {
                    Object.keys(konfig.filterValues).forEach(key => {
                        if (state.filters.includes(key)) {
                            state.filterValues[key] = konfig.filterValues[key];
                        }
                    });
                }

                if (konfig.options && typeof konfig.options === "object") {
                    state.options.showGrandTotals = konfig.options.showGrandTotals !== false;
                    state.options.compactRows = !!konfig.options.compactRows;
                    state.options.decimalPlaces = Number.isFinite(Number(konfig.options.decimalPlaces))
                        ? Number(konfig.options.decimalPlaces)
                        : 2;
                }

                document.getElementById("showGrandTotals").checked = state.options.showGrandTotals;
                document.getElementById("compactRows").checked = state.options.compactRows;
                document.getElementById("decimalPlaces").value = String(state.options.decimalPlaces);

                renderZoneTags();
                renderFilterInputs();
                setView("table");
                buildPivot();
            }

            function kayitliTabloOdakModuAyarla(aktif) {
                analizCalismaAlani.classList.toggle("pivot-kayit-odak", !!aktif);
                kayitliTablolarButonunuAyarla(!!aktif);
                syncStageHeight();
            }

            function analizGorunumunuAc(sadeceKayitliTablo = false) {
                analizCalismaAlani.style.display = "flex";
                kayitliTablolarSayfasi.style.display = "none";
                kayitliTabloOdakModuAyarla(!!sadeceKayitliTablo);
            }

            function kayitliTablolarGorunumunuAc() {
                analizCalismaAlani.style.display = "none";
                kayitliTablolarSayfasi.style.display = "block";
                kayitliTabloOdakModuAyarla(false);
            }

            async function kayitliTablolariGetir() {
                const response = await fetch("/TrafoTests/KayitliPivotTablolar", {
                    method: "GET",
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });

                const payload = await response.json();
                if (!response.ok || !payload.success) {
                    throw new Error(payload.message || "Kayıtlı tablolar alınamadı.");
                }

                return payload.data || [];
            }

            async function kayitliTablolariListele() {
                kayitliTablolarListe.innerHTML = "<div class='text-muted small'>Yükleniyor...</div>";

                try {
                    const liste = await kayitliTablolariGetir();
                    if (!liste.length) {
                        kayitliTablolarListe.innerHTML = "<div class='text-muted small'>Henüz kayıtlı pivot tablo bulunmuyor.</div>";
                        return;
                    }

                    kayitliTablolarListe.innerHTML = liste.map(item => `
                        <div class="pivot-saved-item" data-kayit-id="${item.id}">
                            <div>
                                <div class="pivot-saved-item__title">${escapeHtml(item.ad)}</div>
                                <div class="pivot-saved-item__meta">${escapeHtml(item.olusturan || "Sistem")} • ${escapeHtml(item.olusturmaTarihi || "")}</div>
                            </div>
                            <div class="pivot-saved-item__actions">
                                <button type="button" class="btn btn-sm pivot-action-btn pivot-action-btn--lila js-pivot-yukle">Görüntüle</button>
                                <button type="button" class="btn btn-sm btn-outline-danger js-pivot-sil">Sil</button>
                            </div>
                        </div>
                    `).join("");

                    kayitliTablolarListe.querySelectorAll(".js-pivot-yukle").forEach(btn => {
                        btn.addEventListener("click", async function () {
                            const kayitId = Number(btn.closest("[data-kayit-id]").dataset.kayitId);
                            if (!Number.isFinite(kayitId) || kayitId <= 0) {
                                return;
                            }
                            try {
                                await pivotTabloYukle(kayitId);
                            } catch (error) {
                                await Swal.fire({
                                    icon: "error",
                                    title: "Hata",
                                    text: error.message || "Kayıt yüklenemedi."
                                });
                            }
                        });
                    });

                    kayitliTablolarListe.querySelectorAll(".js-pivot-sil").forEach(btn => {
                        btn.addEventListener("click", async function () {
                            const kayitId = Number(btn.closest("[data-kayit-id]").dataset.kayitId);
                            try {
                                await pivotTabloSil(kayitId);
                            } catch (error) {
                                await Swal.fire({
                                    icon: "error",
                                    title: "Hata",
                                    text: error.message || "Kayıt silinemedi."
                                });
                            }
                        });
                    });
                } catch (error) {
                    kayitliTablolarListe.innerHTML = `<div class='text-danger small'>${escapeHtml(error.message || "Kayıtlar alınamadı.")}</div>`;
                }
            }

            async function pivotTabloYukle(id) {
                const response = await fetch(`/TrafoTests/PivotTabloDetay?id=${id}`, {
                    method: "GET",
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });

                const payload = await response.json();
                if (!response.ok || !payload.success) {
                    throw new Error(payload.message || "Kayıt yüklenemedi.");
                }

                const detay = payload.data || {};
                const konfigJson = detay.konfigJson || detay.KonfigJson;
                if (!konfigJson) {
                    throw new Error("Kayıtlı tablo içeriği bulunamadı.");
                }

                const konfig = JSON.parse(konfigJson);
                konfigUygula(konfig);
                analizGorunumunuAc(true);
            }

            async function pivotTabloSil(id) {
                const onay = await Swal.fire({
                    icon: "warning",
                    title: "Kayıt silinsin mi?",
                    text: "Bu işlem geri alınamaz.",
                    showCancelButton: true,
                    confirmButtonText: "Sil",
                    cancelButtonText: "Vazgeç"
                });

                if (!onay.isConfirmed) {
                    return;
                }

                const response = await fetch("/TrafoTests/PivotTabloSil", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    body: JSON.stringify({ id })
                });

                const payload = await response.json();
                if (!response.ok || !payload.success) {
                    throw new Error(payload.message || "Silme işlemi başarısız.");
                }

                await kayitliTablolariListele();
            }

            function syncStageHeight() {
                const activePanel = viewStage.classList.contains("is-chart") ? chartPanel : tablePanel;
                const contentHeight = activePanel ? activePanel.scrollHeight : 0;
                viewStage.style.height = `${contentHeight}px`;
            }

            function setView(mode) {
                if (mode === "chart") {
                    viewStage.classList.add("is-chart");
                    syncStageHeight();
                    return;
                }
                viewStage.classList.remove("is-chart");
                syncStageHeight();
            }

            function hexToRgba(hex, alpha) {
                const value = (hex || "").replace("#", "");
                const normalized = value.length === 3
                    ? value.split("").map(c => c + c).join("")
                    : value;
                const int = parseInt(normalized, 16);
                const r = (int >> 16) & 255;
                const g = (int >> 8) & 255;
                const b = int & 255;
                return `rgba(${r}, ${g}, ${b}, ${alpha})`;
            }

            function adjustHex(hex, amount) {
                const value = (hex || "").replace("#", "");
                const normalized = value.length === 3
                    ? value.split("").map(c => c + c).join("")
                    : value;
                const int = parseInt(normalized, 16);
                const r = Math.max(0, Math.min(255, ((int >> 16) & 255) + amount));
                const g = Math.max(0, Math.min(255, ((int >> 8) & 255) + amount));
                const b = Math.max(0, Math.min(255, (int & 255) + amount));
                return `rgb(${r}, ${g}, ${b})`;
            }

            function createVerticalGradient(chart, colorHex) {
                const { ctx, chartArea } = chart;
                if (!chartArea) {
                    return hexToRgba(colorHex, 0.55);
                }

                const gradient = ctx.createLinearGradient(0, chartArea.top, 0, chartArea.bottom);
                gradient.addColorStop(0, hexToRgba(colorHex, 0.82));
                gradient.addColorStop(1, hexToRgba(colorHex, 0.09));
                return gradient;
            }

            function createPremiumShadowPlugin() {
                return {
                    id: "premiumShadowPlugin",
                    beforeDatasetDraw(chart) {
                        const { ctx } = chart;
                        ctx.save();
                        ctx.shadowColor = "rgba(115, 103, 240, 0.2)";
                        ctx.shadowBlur = 12;
                        ctx.shadowOffsetX = 0;
                        ctx.shadowOffsetY = 4;
                    },
                    afterDatasetDraw(chart) {
                        chart.ctx.restore();
                    }
                };
            }

            function renderChart(chartType) {
                if (!state.chartModel || !state.chartModel.labels.length || !chartCanvas) {
                    return false;
                }

                if (state.chartInstance) {
                    state.chartInstance.destroy();
                }

                const palette = ["#7367F0", "#00CFE8", "#28C76F", "#FF6B6B", "#A66BFF", "#1E9EF7", "#00B894", "#FF9F43"];
                const base = idx => palette[idx % palette.length];

                let labels = state.chartModel.labels;
                let datasets;

                if (chartType === "pie" || chartType === "doughnut") {
                    const first = state.chartModel.series[0];
                    datasets = [{
                        label: first.name,
                        data: first.data,
                        backgroundColor: labels.map((_, i) => hexToRgba(base(i), 0.82)),
                        borderColor: labels.map(() => "rgba(255,255,255,0.96)"),
                        hoverBackgroundColor: labels.map((_, i) => adjustHex(base(i), 20)),
                        borderWidth: 2,
                        hoverOffset: 14,
                        spacing: 2
                    }];
                } else if (chartType === "radar") {
                    datasets = state.chartModel.series.map((s, i) => ({
                        label: s.name,
                        data: s.data,
                        borderColor: base(i),
                        backgroundColor: hexToRgba(base(i), 0.18),
                        pointBackgroundColor: adjustHex(base(i), 28),
                        pointBorderColor: "#ffffff",
                        pointHoverBackgroundColor: "#ffffff",
                        pointHoverBorderColor: base(i),
                        pointRadius: 3.5,
                        pointHoverRadius: 6,
                        borderWidth: 2.2,
                        fill: true,
                        tension: 0.38
                    }));
                } else {
                    datasets = state.chartModel.series.map((s, i) => ({
                        label: s.name,
                        data: s.data,
                        borderColor: base(i),
                        backgroundColor: context => createVerticalGradient(context.chart, base(i)),
                        hoverBackgroundColor: adjustHex(base(i), 20),
                        hoverBorderColor: adjustHex(base(i), 25),
                        hoverBorderWidth: 2,
                        pointBackgroundColor: base(i),
                        pointBorderColor: "#ffffff",
                        pointRadius: chartType === "line" ? 3 : 0,
                        pointHoverRadius: chartType === "line" ? 7 : 4,
                        pointHitRadius: 14,
                        fill: chartType === "line",
                        tension: chartType === "line" ? 0.44 : 0.26,
                        cubicInterpolationMode: "monotone",
                        borderWidth: chartType === "line" ? 3 : 1.6,
                        borderSkipped: false,
                        borderRadius: chartType === "bar" ? 8 : 0
                    }));
                }

                state.chartInstance = new Chart(chartCanvas, {
                    type: chartType,
                    data: { labels, datasets },
                    plugins: [createPremiumShadowPlugin()],
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: {
                            duration: 950,
                            easing: "easeInOutQuart"
                        },
                        interaction: {
                            mode: "nearest",
                            intersect: false
                        },
                        plugins: {
                            legend: {
                                position: "bottom",
                                labels: {
                                    usePointStyle: true,
                                    pointStyle: "circle",
                                    padding: 14,
                                    boxWidth: 10,
                                    color: "#4b4f64",
                                    font: {
                                        family: "Public Sans",
                                        size: 12,
                                        weight: "600"
                                    }
                                }
                            },
                            tooltip: {
                                backgroundColor: "rgba(115, 103, 240, 0.94)",
                                titleColor: "#ffffff",
                                bodyColor: "#f7f7ff",
                                borderColor: "rgba(255,255,255,0.36)",
                                borderWidth: 1,
                                cornerRadius: 10,
                                padding: 11,
                                displayColors: true,
                                titleFont: {
                                    family: "Public Sans",
                                    size: 12,
                                    weight: "700"
                                },
                                bodyFont: {
                                    family: "Public Sans",
                                    size: 12,
                                    weight: "500"
                                },
                                callbacks: {
                                    title(items) {
                                        return `Kategori: ${items[0].label}`;
                                    },
                                    label(context) {
                                        const rawVal = (typeof context.parsed === "number")
                                            ? context.parsed
                                            : (context.parsed && typeof context.parsed.y === "number" ? context.parsed.y : 0);
                                        return `${context.dataset.label}: ${Number(rawVal).toLocaleString("tr-TR", {
                                            minimumFractionDigits: state.options.decimalPlaces,
                                            maximumFractionDigits: state.options.decimalPlaces
                                        })}`;
                                    }
                                }
                            }
                        },
                        scales: (chartType === "pie" || chartType === "doughnut")
                            ? {}
                            : (chartType === "radar"
                                ? {
                                    r: {
                                        angleLines: { color: "rgba(115,103,240,0.15)" },
                                        grid: { color: "rgba(115,103,240,0.14)" },
                                        pointLabels: {
                                            color: "#5a607b",
                                            font: {
                                                family: "Public Sans",
                                                size: 11,
                                                weight: "600"
                                            }
                                        },
                                        ticks: {
                                            backdropColor: "transparent",
                                            color: "#7a809c",
                                            showLabelBackdrop: false
                                        }
                                    }
                                }
                                : {
                                    x: {
                                        title: {
                                            display: true,
                                            text: "Kırılım",
                                            color: "#5a607b",
                                            font: {
                                                family: "Public Sans",
                                                size: 12,
                                                weight: "700"
                                            }
                                        },
                                        ticks: {
                                            maxRotation: 35,
                                            minRotation: 0,
                                            color: "#666f8d",
                                            font: {
                                                family: "Public Sans",
                                                size: 11,
                                                weight: "500"
                                            }
                                        },
                                        grid: {
                                            color: "rgba(115,103,240,0.08)"
                                        }
                                    },
                                    y: {
                                        beginAtZero: true,
                                        title: {
                                            display: true,
                                            text: "Değer",
                                            color: "#5a607b",
                                            font: {
                                                family: "Public Sans",
                                                size: 12,
                                                weight: "700"
                                            }
                                        },
                                        ticks: {
                                            color: "#666f8d",
                                            font: {
                                                family: "Public Sans",
                                                size: 11,
                                                weight: "500"
                                            }
                                        },
                                        grid: {
                                            color: "rgba(115,103,240,0.08)"
                                        }
                                    }
                                })
                    }
                });

                setTimeout(syncStageHeight, 40);

                return true;
            }

            function createFieldChip(fieldKey) {
                const meta = fieldMeta[fieldKey];
                const el = document.createElement("button");
                el.type = "button";
                el.className = "pivot-field-item";
                el.textContent = meta.label;
                el.draggable = true;
                el.dataset.field = fieldKey;
                el.addEventListener("click", () => addFieldToZone(fieldKey, state.targetZone));
                el.addEventListener("dragstart", ev => {
                    ev.dataTransfer.setData("text/plain", fieldKey);
                });
                return el;
            }

            function renderFieldLists() {
                const dim = document.getElementById("dimensionFields");
                const mea = document.getElementById("measureFields");
                dim.innerHTML = "";
                mea.innerHTML = "";

                Object.keys(fieldMeta).forEach(key => {
                    const chip = createFieldChip(key);
                    if (fieldMeta[key].type === "measure") {
                        mea.appendChild(chip);
                    } else {
                        dim.appendChild(chip);
                    }
                });
            }

            function addFieldToZone(fieldKey, zone) {
                if (!fieldMeta[fieldKey] || !zone) {
                    return;
                }

                if (!isValidZoneForField(fieldKey, zone)) {
                    return;
                }

                if (zone === "values") {
                    if (state.values.some(v => v.key === fieldKey)) {
                        return;
                    }
                    const defaultAgg = fieldMeta[fieldKey].type === "measure" ? "avg" : "count";
                    state.values.push({ key: fieldKey, agg: defaultAgg });
                } else {
                    if (state[zone].includes(fieldKey)) {
                        return;
                    }
                    state[zone].push(fieldKey);
                }

                renderZoneTags();
                renderFilterInputs();
                buildPivot();
            }

            function removeFieldFromZone(zone, fieldKey) {
                if (zone === "values") {
                    state.values = state.values.filter(v => v.key !== fieldKey);
                } else {
                    state[zone] = state[zone].filter(k => k !== fieldKey);
                    if (zone === "filters") {
                        delete state.filterValues[fieldKey];
                    }
                }
                renderZoneTags();
                renderFilterInputs();
                buildPivot();
            }

            function moveFieldBetweenZones(fromZone, toZone, fieldKey) {
                if (!fromZone || !toZone || !fieldKey || fromZone === toZone) {
                    return;
                }

                removeFieldFromZone(fromZone, fieldKey);
                addFieldToZone(fieldKey, toZone);
            }

            function renderZoneTags() {
                Object.keys(zones).forEach(zoneName => {
                    zones[zoneName].innerHTML = "";
                    const list = zoneName === "values" ? state.values : state[zoneName];

                    if (!list.length) {
                        const ghost = document.createElement("div");
                        ghost.className = "text-muted small";
                        ghost.textContent = "Alanları buraya sürükleyin";
                        zones[zoneName].appendChild(ghost);
                        return;
                    }

                    list.forEach(item => {
                        const fieldKey = zoneName === "values" ? item.key : item;
                        const wrap = document.createElement("span");
                        wrap.className = "pivot-tag";
                        wrap.draggable = true;
                        wrap.dataset.field = fieldKey;
                        wrap.dataset.zone = zoneName;

                        wrap.addEventListener("dragstart", ev => {
                            ev.dataTransfer.setData("application/json", JSON.stringify({
                                fieldKey,
                                fromZone: zoneName
                            }));
                            ev.dataTransfer.setData("text/plain", fieldKey);
                        });

                        const title = document.createElement("span");
                        title.textContent = fieldMeta[fieldKey].label;
                        wrap.appendChild(title);

                        if (zoneName === "values") {
                            const meta = document.createElement("span");
                            meta.className = "pivot-tag__meta";
                            meta.textContent = aggLabel[item.agg] || item.agg;
                            wrap.appendChild(meta);

                            meta.addEventListener("click", function () {
                                const order = ["sum", "avg", "count", "min", "max"];
                                const idx = order.indexOf(item.agg);
                                item.agg = order[(idx + 1) % order.length];
                                renderZoneTags();
                                buildPivot();
                            });
                        }

                        const removeBtn = document.createElement("button");
                        removeBtn.type = "button";
                        removeBtn.className = "pivot-tag__remove";
                        removeBtn.innerHTML = "<i class='fa-solid fa-xmark'></i>";
                        removeBtn.addEventListener("click", () => removeFieldFromZone(zoneName, fieldKey));
                        wrap.appendChild(removeBtn);

                        zones[zoneName].appendChild(wrap);
                    });
                });
            }

            function setupDropZones() {
                document.querySelectorAll(".pivot-zone").forEach(zoneEl => {
                    const zoneName = zoneEl.dataset.zone;
                    const dropArea = zoneEl.querySelector(".pivot-zone__drop");

                    zoneEl.addEventListener("click", () => {
                        state.targetZone = zoneName;
                    });

                    dropArea.addEventListener("dragover", ev => {
                        ev.preventDefault();
                        dropArea.classList.add("is-over");
                    });

                    dropArea.addEventListener("dragleave", () => {
                        dropArea.classList.remove("is-over");
                    });

                    dropArea.addEventListener("drop", ev => {
                        ev.preventDefault();
                        dropArea.classList.remove("is-over");
                        const payloadRaw = ev.dataTransfer.getData("application/json");
                        if (payloadRaw) {
                            try {
                                const payload = JSON.parse(payloadRaw);
                                if (payload?.fieldKey && payload?.fromZone) {
                                    moveFieldBetweenZones(payload.fromZone, zoneName, payload.fieldKey);
                                    return;
                                }
                            } catch {
                            }
                        }

                        const fieldKey = ev.dataTransfer.getData("text/plain");
                        if (!isValidZoneForField(fieldKey, zoneName)) {
                            return;
                        }
                        addFieldToZone(fieldKey, zoneName);
                    });
                });
            }

            function renderFilterInputs() {
                filterInputs.innerHTML = "";
                if (!state.filters.length) {
                    if (filtreDropdownWrap) {
                        filtreDropdownWrap.style.display = "none";
                    }
                    return;
                }

                if (filtreDropdownWrap) {
                    filtreDropdownWrap.style.display = "block";
                }
                if (filtreBadge) {
                    filtreBadge.textContent = String(state.filters.length);
                }

                state.filters.forEach(fieldKey => {
                    const col = document.createElement("div");
                    col.className = "pivot-filter-control";

                    const label = document.createElement("label");
                    label.className = "form-label";
                    label.textContent = fieldMeta[fieldKey].label;

                    const select = document.createElement("select");
                    select.className = "form-select form-select-sm";
                    const allOption = document.createElement("option");
                    allOption.value = "";
                    allOption.textContent = "Tümü";
                    select.appendChild(allOption);

                    const values = [...new Set(data.map(d => String(d[fieldKey] ?? "-")))].sort((a, b) => a.localeCompare(b, "tr"));
                    values.forEach(v => {
                        const opt = document.createElement("option");
                        opt.value = v;
                        opt.textContent = v;
                        if (state.filterValues[fieldKey] === v) {
                            opt.selected = true;
                        }
                        select.appendChild(opt);
                    });

                    select.addEventListener("change", () => {
                        state.filterValues[fieldKey] = select.value;
                        buildPivot();
                    });

                    col.appendChild(label);
                    col.appendChild(select);
                    filterInputs.appendChild(col);
                });
            }

            function filterData() {
                return data.filter(row => {
                    return state.filters.every(f => {
                        const selected = state.filterValues[f];
                        if (!selected) {
                            return true;
                        }
                        return String(row[f] ?? "-") === selected;
                    });
                });
            }

            function keyFromFields(row, fields) {
                if (!fields.length) {
                    return "__tek";
                }
                return fields.map(f => String(row[f] ?? "-")).join(" || ");
            }

            function labelFromKey(key) {
                if (key === "__tek") {
                    return ["-"];
                }
                return key.split(" || ");
            }

            function initAgg(agg) {
                if (agg === "min") return { min: Number.POSITIVE_INFINITY };
                if (agg === "max") return { max: Number.NEGATIVE_INFINITY };
                if (agg === "count") return { count: 0 };
                return { sum: 0, count: 0 };
            }

            function updateAgg(acc, agg, value) {
                const n = toNumber(value);
                if (agg === "sum") {
                    acc.sum += n;
                } else if (agg === "avg") {
                    acc.sum += n;
                    acc.count += 1;
                } else if (agg === "count") {
                    acc.count += 1;
                } else if (agg === "min") {
                    acc.min = Math.min(acc.min, n);
                } else if (agg === "max") {
                    acc.max = Math.max(acc.max, n);
                }
            }

            function finishAgg(acc, agg) {
                if (agg === "sum") return acc.sum;
                if (agg === "avg") return acc.count ? acc.sum / acc.count : 0;
                if (agg === "count") return acc.count;
                if (agg === "min") return acc.min === Number.POSITIVE_INFINITY ? 0 : acc.min;
                if (agg === "max") return acc.max === Number.NEGATIVE_INFINITY ? 0 : acc.max;
                return 0;
            }

            function formatNumber(value) {
                return Number(value).toLocaleString("tr-TR", {
                    minimumFractionDigits: state.options.decimalPlaces,
                    maximumFractionDigits: state.options.decimalPlaces
                });
            }

            function valueLabel(v) {
                return `${fieldMeta[v.key].label} (${aggLabel[v.agg]})`;
            }

            function formatHeaderCell(mainText, topText = "") {
                const safeMain = mainText || "-";
                if (!topText) {
                    return `<div class=\"pivot-th-main\">${safeMain}</div>`;
                }
                return `<div class=\"pivot-th-top\">${topText}</div><div class=\"pivot-th-main\">${safeMain}</div>`;
            }

            function buildPivot() {
                if (!state.rows.length || !state.values.length) {
                    table.innerHTML = "";
                    tableHolder.style.display = "none";
                    pivotKaydetBtn.style.display = "none";
                    emptyState.style.display = "block";
                    state.chartModel = null;
                    setView("table");
                    syncStageHeight();
                    return;
                }

                const filtered = filterData();
                if (!filtered.length) {
                    table.innerHTML = "";
                    tableHolder.style.display = "none";
                    pivotKaydetBtn.style.display = "none";
                    emptyState.style.display = "block";
                    emptyState.querySelector("h6").textContent = "Seçili filtrelerle eşleşen kayıt bulunamadı";
                    state.chartModel = null;
                    setView("table");
                    syncStageHeight();
                    return;
                }

                emptyState.querySelector("h6").textContent = "Analize başlamak için alanları kutucuklara yerleştirin";
                const rowKeys = [...new Set(filtered.map(r => keyFromFields(r, state.rows)))].sort((a, b) => a.localeCompare(b, "tr"));
                const colKeys = state.columns.length
                    ? [...new Set(filtered.map(r => keyFromFields(r, state.columns)))].sort((a, b) => a.localeCompare(b, "tr"))
                    : ["__tek"];

                const matrix = new Map();

                filtered.forEach(r => {
                    const rk = keyFromFields(r, state.rows);
                    const ck = keyFromFields(r, state.columns);
                    const key = `${rk}##${ck}`;
                    if (!matrix.has(key)) {
                        const initial = state.values.map(v => initAgg(v.agg));
                        matrix.set(key, initial);
                    }
                    const bucket = matrix.get(key);
                    state.values.forEach((v, i) => updateAgg(bucket[i], v.agg, r[v.key]));
                });

                const headRow = [];
                const metricHeaders = [];
                state.rows.forEach(f => {
                    headRow.push(formatHeaderCell(fieldMeta[f].label));
                });
                colKeys.forEach(ck => {
                    const colName = state.columns.length ? labelFromKey(ck).join(" / ") : "";
                    state.values.forEach(v => {
                        const metricText = valueLabel(v);
                        headRow.push(formatHeaderCell(metricText, colName));
                        metricHeaders.push(colName ? `${colName} / ${metricText}` : metricText);
                    });
                });

                const chartModel = {
                    labels: [],
                    series: metricHeaders.map(h => ({ name: h, data: [] }))
                };

                let html = "<thead><tr>";
                headRow.forEach(h => {
                    html += `<th>${h}</th>`;
                });
                html += "</tr></thead><tbody>";

                const grandCollectors = state.values.map(v => initAgg(v.agg));

                rowKeys.forEach(rk => {
                    const rowLabels = labelFromKey(rk);
                    chartModel.labels.push(rowLabels.join(" / "));
                    html += "<tr>";
                    rowLabels.forEach(x => {
                        html += `<th>${x}</th>`;
                    });

                    let seriesIndex = 0;

                    colKeys.forEach(ck => {
                        const combo = matrix.get(`${rk}##${ck}`) || state.values.map(v => initAgg(v.agg));
                        state.values.forEach((v, i) => {
                            const val = finishAgg(combo[i], v.agg);
                            updateAgg(grandCollectors[i], v.agg, val);
                            chartModel.series[seriesIndex].data.push(Number(val));
                            seriesIndex += 1;
                            html += `<td>${formatNumber(val)}</td>`;
                        });
                    });

                    html += "</tr>";
                });

                if (state.options.showGrandTotals) {
                    html += "<tr class='pivot-grand-row'>";
                    html += `<th colspan='${Math.max(1, state.rows.length)}'>Genel Toplam</th>`;

                    const cellCount = colKeys.length * state.values.length;
                    for (let i = 0; i < cellCount; i++) {
                        const valIdx = i % state.values.length;
                        const v = state.values[valIdx];
                        const totalVal = finishAgg(grandCollectors[valIdx], v.agg);
                        html += `<td class='pivot-total-cell'>${formatNumber(totalVal)}</td>`;
                    }

                    html += "</tr>";
                }

                html += "</tbody>";
                table.innerHTML = html;
                tableHolder.style.display = "block";
                pivotKaydetBtn.style.display = "inline-flex";
                emptyState.style.display = "none";
                state.chartModel = chartModel;

                if (state.options.compactRows) {
                    reportWrap.classList.add("pivot-row-compact");
                } else {
                    reportWrap.classList.remove("pivot-row-compact");
                }

                syncStageHeight();
            }

            function applyDefaultSetup() {
                state.rows = ["Musteri"];
                state.columns = ["Muhendis"];
                state.filters = ["Sonuc"];
                state.values = [
                    { key: "P0Sapma", agg: "avg" },
                    { key: "PkSapma", agg: "avg" },
                    { key: "UkSapma", agg: "avg" },
                    { key: "Musteri", agg: "count" }
                ];
                state.filterValues = {};
                renderZoneTags();
                renderFilterInputs();
                buildPivot();
            }

            document.getElementById("filtreTemizleBtn").addEventListener("click", function () {
                kayitliTabloOdakModuAyarla(false);
                state.rows = [];
                state.columns = [];
                state.values = [];
                state.filters = [];
                state.filterValues = {};
                renderZoneTags();
                renderFilterInputs();
                buildPivot();
            });

            kayitliTablolarBtn.addEventListener("click", async function () {
                const mod = kayitliTablolarBtn.dataset.mode || "liste";
                kayitliTablolarGorunumunuAc();
                if (mod === "geri-don") {
                    await kayitliTablolariListele();
                    return;
                }
                await kayitliTablolariListele();
            });

            analizeDonBtn.addEventListener("click", function () {
                analizGorunumunuAc();
            });

            pivotKaydetBtn.addEventListener("click", async function () {
                try {
                    if (!table.tHead || !table.tBodies.length || !state.rows.length || !state.values.length) {
                        await Swal.fire({
                            icon: "info",
                            title: "Kaydedilecek tablo yok",
                            text: "Önce bir pivot tablo oluşturun."
                        });
                        return;
                    }

                    const result = await Swal.fire({
                        title: "Pivot Tabloyu Kaydet",
                        input: "text",
                        inputLabel: "Tablo adı",
                        showCancelButton: true,
                        confirmButtonText: "Kaydet",
                        cancelButtonText: "Vazgeç",
                        buttonsStyling: false,
                        customClass: {
                            popup: "pivot-swal",
                            title: "pivot-swal-title",
                            input: "pivot-swal-input",
                            actions: "pivot-swal-actions",
                            confirmButton: "pivot-swal-confirm",
                            cancelButton: "pivot-swal-cancel"
                        },
                        showClass: {
                            popup: "",
                            backdrop: ""
                        },
                        hideClass: {
                            popup: ""
                        },
                        inputValidator: value => {
                            if (!value || !value.trim()) {
                                return "Tablo adı zorunludur.";
                            }
                            if (value.trim().length > 150) {
                                return "Tablo adı en fazla 150 karakter olabilir.";
                            }
                            return null;
                        }
                    });

                    if (!result.isConfirmed) {
                        return;
                    }

                    const response = await fetch("/TrafoTests/KaydetPivotTablo", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "X-Requested-With": "XMLHttpRequest"
                        },
                        body: JSON.stringify({
                            tabloAdi: result.value.trim(),
                            konfigJson: JSON.stringify(mevcutKonfigOlustur())
                        })
                    });

                    const payload = await response.json();
                    if (!response.ok || !payload.success) {
                        throw new Error(payload.message || "Kaydetme işlemi başarısız.");
                    }

                    await Swal.fire({
                        icon: "success",
                        title: "Kaydedildi",
                        text: payload.message || "Pivot tablo kaydedildi.",
                        timer: 1200,
                        showConfirmButton: false
                    });
                } catch (error) {
                    await Swal.fire({
                        icon: "error",
                        title: "Hata",
                        text: error.message || "Pivot tablo kaydedilemedi."
                    });
                }
            });

            document.getElementById("applyOzelBtn").addEventListener("click", function () {
                state.options.showGrandTotals = document.getElementById("showGrandTotals").checked;
                state.options.compactRows = document.getElementById("compactRows").checked;
                state.options.decimalPlaces = Number(document.getElementById("decimalPlaces").value);
                buildPivot();

                const modalEl = document.getElementById("pivotOzelModal");
                const instance = bootstrap.Modal.getInstance(modalEl);
                if (instance) {
                    instance.hide();
                }
            });

            document.getElementById("excelBtn").addEventListener("click", function () {
                if (!table.tHead || !table.tBodies.length) {
                    return;
                }
                const wb = XLSX.utils.book_new();
                const ws = XLSX.utils.table_to_sheet(table);
                XLSX.utils.book_append_sheet(wb, ws, "Analiz");
                XLSX.writeFile(wb, "trafo-analiz-raporu.xlsx");
            });

            document.getElementById("pdfBtn").addEventListener("click", function () {
                if (!table.tHead || !table.tBodies.length) {
                    return;
                }
                const { jsPDF } = window.jspdf;
                const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "a4" });

                const headers = [...table.querySelectorAll("thead th")].map(x => x.textContent.trim());
                const body = [...table.querySelectorAll("tbody tr")].map(row =>
                    [...row.children].map(cell => cell.textContent.trim())
                );

                doc.text("Trafo Analiz Raporu", 40, 30);
                doc.autoTable({
                    head: [headers],
                    body: body,
                    startY: 45,
                    styles: { fontSize: 8, cellPadding: 4 },
                    headStyles: { fillColor: [235, 235, 237], textColor: [68, 64, 80] }
                });

                doc.save("trafo-analiz-raporu.pdf");
            });

            document.querySelectorAll(".pivot-chart-option").forEach(item => {
                item.addEventListener("click", function () {
                    const type = item.dataset.chartType;
                    if (renderChart(type)) {
                        setView("chart");
                    }
                });
            });

            tabloyaDonBtn.addEventListener("click", function () {
                setView("table");
            });

            renderFieldLists();
            setupDropZones();
            kayitliTablolarButonunuAyarla(false);
            window.addEventListener("resize", syncStageHeight);
        });
    </script>
}
