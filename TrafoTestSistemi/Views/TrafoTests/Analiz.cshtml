@{
    ViewData["Title"] = "Trafo Analiz Raporu";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-secondary">📊 Trafo Test Analiz Paneli</h2>
        <a asp-action="Index" class="btn btn-outline-primary btn-sm">← Listeye Dön</a>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-primary text-white pt-3">
                <div class="card-body text-center">
                    <h6 class="text-uppercase small">Toplam Yapılan Test</h6>
                    <h2 class="display-6 fw-bold">@(ViewBag.Toplam ?? 0)</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-success text-white pt-3">
                <div class="card-body text-center">
                    <h6 class="text-uppercase small">Uygun</h6>
                    <h2 class="display-6 fw-bold">@(ViewBag.Uygun ?? 0)</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-danger text-white pt-3">
                <div class="card-body text-center">
                    <h6 class="text-uppercase small">Uygun Değil</h6>
                    <h2 class="display-6 fw-bold">@(ViewBag.UygunDegil ?? 0)</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-6 mx-auto">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0 text-center fw-bold">Uygunluk Dağılımı</h5>
                </div>
                <div class="card-body p-4">
                    <canvas id="trafoPieChart" style="max-height: 350px;"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const ctx = document.getElementById('trafoPieChart').getContext('2d');
            const uygun = @(ViewBag.Uygun ?? 0);
            const uygunDegil = @(ViewBag.UygunDegil ?? 0);

            if (uygun === 0 && uygunDegil === 0) {
                ctx.font = "16px Arial";
                ctx.textAlign = "center";
                ctx.fillText("Henüz analiz edilecek veri bulunmuyor.", ctx.canvas.width/2, ctx.canvas.height/2);
            } else {
                new Chart(ctx, {
                    type: 'pie',
                    data: {
                        labels: ['Uygun Trafolar', 'Uygun Olmayan Trafolar'],
                        datasets: [{
                            data: [uygun, uygunDegil],
                            backgroundColor: ['#198754', '#dc3545'],
                            hoverOffset: 15,
                            borderWidth: 2,
                            borderColor: '#fff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { padding: 20, font: { size: 14 } }
                            }
                        }
                    }
                });
            }
        });
    </script>
}