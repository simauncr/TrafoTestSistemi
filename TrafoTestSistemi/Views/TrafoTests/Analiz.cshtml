@{
    ViewData["Title"] = "Trafo Analiz Raporu";
    var analysisJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.AnalysisRecords ?? new List<object>());
    var forcePivotResetJson = System.Text.Json.JsonSerializer.Serialize((bool?)(ViewBag.ForcePivotReset) ?? false);
    var masterDimensionValuesJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.MasterDimensionValues ?? new Dictionary<string, List<string>>());
}

<div class="container-fluid mt-3">
    <div class="app-page-header mb-3">
        <div>
            <span class="app-page-header__eyebrow">Analiz Paneli</span>
        </div>
    </div>

    <div class="card app-card-muted pivot-modul-shell">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h6 class="mb-1 fw-bold">Kurumsal Dinamik Pivot Analiz Modülü</h6>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-sm pivot-action-btn pivot-action-btn--duzenle" id="pivotDuzenleBtn" style="display:none;" title="Bu tabloyu düzenle">
                    <i class="fa-solid fa-pen-to-square"></i>
                </button>
                <button type="button" class="btn btn-sm pivot-action-btn pivot-action-btn--lila" id="pivotGuncelleBtn" style="display:none;" title="Mevcut kayıtlı tabloyu güncelle">
                    <i class="fa-solid fa-floppy-disk me-1"></i>Değişiklikleri Kaydet
                </button>
                <button type="button" class="btn btn-sm pivot-action-btn pivot-action-btn--excel" id="excelBtn">
                    <i class="fa-solid fa-file-excel me-1"></i>Excel
                </button>
                <button type="button" class="btn btn-sm pivot-action-btn pivot-action-btn--pdf" id="pdfBtn">
                    <i class="fa-solid fa-file-pdf me-1"></i>PDF
                </button>
                <button type="button" class="btn btn-sm pivot-action-btn pivot-action-btn--yesil" id="filtreTemizleBtn">
                    <i class="fa-solid fa-broom me-1"></i>Filtreleri Temizle
                </button>
                <button type="button" class="btn btn-sm pivot-action-btn pivot-action-btn--ghost" id="kayitliTablolarBtn">
                    <i class="fa-solid fa-bookmark me-1"></i>Kayıtlı Tablolarım
                </button>
            </div>
        </div>
        <div class="card-body p-3 p-lg-4">
            <div class="row g-3 align-items-start" id="analizCalismaAlani">
                <div class="col-12 col-xl-2">
                    <div class="pivot-panel-card pivot-fields-card">
                        <div class="pivot-panel-card__title-wrap">
                            <div class="pivot-panel-card__title">Alan Listesi</div>
                            <small class="pivot-panel-card__hint">Bir hedef kutu seçin, alanı tıklayın veya sürükleyin.</small>
                        </div>
                        <div class="pivot-field-groups mt-2">
                            <div class="pivot-field-group">
                                <div class="pivot-field-group__label">Boyut Alanları</div>
                                <div class="pivot-field-list" id="dimensionFields"></div>
                            </div>
                            <div class="pivot-field-group mt-3">
                                <div class="pivot-field-group__label">Sayısal Alanlar</div>
                                <div class="pivot-field-list" id="measureFields"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-10">
                    <div class="pivot-panel-card pivot-dropstrip-card mb-3">
                        <div class="pivot-zone-grid">
                            <div class="pivot-zone" data-zone="rows">
                                <div class="pivot-zone__title"><i class="fa-solid fa-list"></i>Satırlar</div>
                                <div class="pivot-zone__drop" id="zone-rows"></div>
                            </div>
                            <div class="pivot-zone" data-zone="columns">
                                <div class="pivot-zone__title"><i class="fa-solid fa-table-columns"></i>Sütunlar</div>
                                <div class="pivot-zone__drop" id="zone-columns"></div>
                            </div>
                            <div class="pivot-zone" data-zone="filters">
                                <div class="pivot-zone__title"><i class="fa-solid fa-filter"></i>Filtreler</div>
                                <div class="pivot-zone__drop" id="zone-filters"></div>
                            </div>
                            <div class="pivot-zone" data-zone="values">
                                <div class="pivot-zone__title"><i class="fa-solid fa-square-poll-vertical"></i>Değerler</div>
                                <div class="pivot-zone__drop" id="zone-values"></div>
                            </div>
                        </div>
                    </div>

                    <div class="pivot-report-wrap" id="pivotReportWrap">
                        <div class="pivot-report-actions">
                            <div id="pivotReportTitle" class="pivot-report-title">
                                <span id="aktifKayitAdiLabel">Görüntülenen tablo: Yeni Rapor Tasarımı</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <div class="dropdown" id="aktifFiltreDropdownWrap" style="display:none;">
                                    <button type="button" class="btn btn-sm pivot-action-btn pivot-action-btn--lila dropdown-toggle" id="aktifFiltreBtn" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fa-solid fa-filter me-1"></i>Filtreler
                                        <span class="badge rounded-pill text-bg-light ms-1" id="aktifFiltreBadge">0</span>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end p-2 pivot-filter-dropdown-menu" aria-labelledby="aktifFiltreBtn">
                                        <div class="pivot-filter-dropdown-grid" id="dynamicFilterInputs"></div>
                                    </div>
                                </div>

                                <div class="dropdown">
                                    <button type="button" class="btn btn-sm pivot-action-btn pivot-action-btn--lila dropdown-toggle" id="grafikGoruntuleBtn" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fa-solid fa-chart-column me-1"></i>Grafiği Görüntüle
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><button type="button" class="dropdown-item pivot-chart-option" data-chart-type="bar">Sütun Grafik</button></li>
                                        <li><button type="button" class="dropdown-item pivot-chart-option" data-chart-type="line">Çizgi Grafik</button></li>
                                        <li><button type="button" class="dropdown-item pivot-chart-option" data-chart-type="pie">Pasta Grafik</button></li>
                                        <li><button type="button" class="dropdown-item pivot-chart-option" data-chart-type="doughnut">Halka Grafik</button></li>
                                        <li><button type="button" class="dropdown-item pivot-chart-option" data-chart-type="radar">Radar Grafik</button></li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="pivot-view-stage" id="pivotViewStage">
                            <div class="pivot-view-panel pivot-view-panel--table is-active" id="pivotTablePanel">
                                <div class="pivot-empty-state" id="pivotEmptyState">
                                    <i class="fa-solid fa-table-cells-large"></i>
                                    <h6>Analize başlamak için alanları kutucuklara yerleştirin</h6>
                                    <p class="mb-0">En az bir Satır, bir Değer ve isteğe bağlı olarak Sütun/Filtre alanı ekleyerek raporu oluşturabilirsiniz.</p>
                                </div>
                                <div class="table-responsive" id="pivotTableHolder" style="display:none;">
                                    <table class="table table-sm align-middle mb-0 pivot-result-table" id="pivotResultTable"></table>
                                </div>
                                <div class="pivot-save-row">
                                    <button type="button" class="pivot-save-mini" id="pivotKaydetBtn" title="Pivot tabloyu kaydet" style="display:none;">
                                        <i class="fa-solid fa-floppy-disk"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="pivot-view-panel pivot-view-panel--chart" id="pivotChartPanel">
                                <div class="pivot-chart-wrap">
                                    <canvas id="pivotChartCanvas"></canvas>
                                </div>
                                <div class="d-flex justify-content-end mt-2">
                                    <button type="button" class="btn btn-sm pivot-action-btn pivot-action-btn--lila" id="tabloyaDonBtn">
                                        <i class="fa-solid fa-table me-1"></i>Tabloya Dön
                                    </button>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="pivot-saved-page" id="kayitliTablolarSayfasi" style="display:none;">
                <div class="pivot-saved-page__header">
                    <div>
                        <h6 class="mb-1 fw-bold">Kayıtlı Pivot Tablolarım</h6>
                    </div>
                    <button type="button" class="btn btn-sm pivot-action-btn pivot-action-btn--lila" id="analizeDonBtn">
                        <i class="fa-solid fa-arrow-left me-1"></i>Analize Dön
                    </button>
                </div>

                <div class="pivot-saved-page__body" id="kayitliTablolarListe"></div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="pivotOzelModal" tabindex="-1" aria-labelledby="pivotOzelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content pivot-modal-content">
            <div class="modal-header pivot-modal-header">
                <h6 class="modal-title fw-bold" id="pivotOzelModalLabel">Görünüm Ayarları</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" role="switch" id="showGrandTotals" checked>
                    <label class="form-check-label" for="showGrandTotals">Genel Toplamları Göster</label>
                </div>
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" role="switch" id="compactRows">
                    <label class="form-check-label" for="compactRows">Sıkı Satır Görünümü</label>
                </div>
                <label for="decimalPlaces" class="form-label">Ondalık Basamak</label>
                <select class="form-select" id="decimalPlaces">
                    <option value="0">0</option>
                    <option value="1">1</option>
                    <option value="2" selected>2</option>
                    <option value="3">3</option>
                </select>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-sm pivot-action-btn pivot-action-btn--yesil" id="applyOzelBtn">Uygula</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .pivot-modul-shell {
            border-radius: 12px;
            border: 1px solid var(--app-border);
            overflow: hidden;
            box-shadow: 0 0.45rem 1.2rem rgba(161, 172, 184, 0.16);
        }

        .pivot-modul-shell .card-header {
            background: linear-gradient(180deg, rgba(var(--app-primary-rgb), 0.14), rgba(var(--app-primary-rgb), 0.06));
            border-bottom: 1px solid var(--app-border);
        }

        .pivot-modul-subtitle {
            color: var(--app-muted);
        }

        .pivot-action-btn {
            border-radius: 10px;
            font-weight: 700;
            border: 1px solid transparent;
            padding-inline: 0.75rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.35rem;
        }

        .pivot-action-btn--lila {
            background: rgba(var(--app-primary-rgb), 0.12);
            color: var(--app-heading);
            border-color: rgba(var(--app-primary-rgb), 0.3);
        }

        .pivot-action-btn--lila:hover {
            background: rgba(var(--app-primary-rgb), 0.22);
            color: var(--app-heading);
        }

        .pivot-action-btn--ghost {
            background: transparent;
            color: var(--app-heading);
            border-color: rgba(var(--app-primary-rgb), 0.35);
        }

        .pivot-action-btn--ghost:hover {
            background: rgba(var(--app-primary-rgb), 0.34);
            color: var(--app-heading);
            border-color: rgba(var(--app-primary-rgb), 0.66);
        }

        .pivot-action-btn--yesil {
            background: #28c76f;
            color: #fff;
            border-color: #28c76f;
        }

        .pivot-action-btn--yesil:hover {
            background: #24b865;
            color: #fff;
        }

        .pivot-action-btn--excel {
            background: transparent;
            color: #1d6f42;
            border-color: #1d6f42;
        }

        .pivot-action-btn--excel:hover {
            background: #1d6f42;
            color: #fff;
        }

        .pivot-action-btn--duzenle {
            background: rgba(var(--app-primary-rgb), 0.10);
            color: var(--app-primary);
            border-color: rgba(var(--app-primary-rgb), 0.4);
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            padding: 0;
        }

        .pivot-action-btn--duzenle:hover {
            background: var(--app-primary);
            color: #fff;
            border-color: var(--app-primary);
        }

        .pivot-action-btn--pdf {
            background: transparent;
            color: #c62828;
            border-color: #c62828;
        }

        .pivot-action-btn--pdf:hover {
            background: #c62828;
            color: #fff;
        }

        .pivot-panel-card {
            border: 1px solid var(--app-border);
            border-radius: 12px;
            background: var(--app-surface);
            padding: 0.9rem;
            box-shadow: 0 0.25rem 0.7rem rgba(161, 172, 184, 0.1);
        }

        :root[data-bs-theme="dark"] .pivot-panel-card {
            box-shadow: 0 0.25rem 0.7rem rgba(0, 0, 0, 0.2);
        }

        .pivot-fields-card {
            padding: 0.65rem;
        }

        .pivot-fields-card .pivot-panel-card__hint {
            font-size: 0.74rem;
        }

        .pivot-filter-compact-card {
            padding: 0.55rem 0.7rem;
        }

        .pivot-filter-compact-card .pivot-panel-card__title-wrap {
            margin-bottom: 0.4rem !important;
        }

        .pivot-filter-compact-card .pivot-panel-card__title {
            font-size: 0.82rem;
        }

        .pivot-filter-compact-card .form-label {
            margin-bottom: 0.18rem !important;
            font-size: 0.72rem;
        }

        .pivot-filter-compact-card .form-select {
            min-height: 30px;
            padding-top: 0.22rem;
            padding-bottom: 0.22rem;
            font-size: 0.79rem;
        }

        .pivot-panel-card__title {
            font-weight: 700;
            color: var(--app-heading);
        }

        .pivot-panel-card__hint {
            color: var(--app-muted);
            font-size: 0.78rem;
        }

        .pivot-field-group__label {
            text-transform: uppercase;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            color: var(--app-primary);
            margin-bottom: 0.5rem;
        }

        .pivot-field-list {
            display: flex;
            flex-wrap: wrap;
            gap: 0.35rem;
            min-height: 42px;
        }

        .pivot-field-item {
            border: 1px solid rgba(var(--app-primary-rgb), 0.26);
            border-radius: 999px;
            padding: 0.22rem 0.52rem;
            background: rgba(var(--app-primary-rgb), 0.08);
            color: var(--app-heading);
            font-size: 0.73rem;
            font-weight: 600;
            cursor: grab;
            user-select: none;
        }

        .pivot-dropstrip-card {
            background: linear-gradient(180deg, rgba(var(--app-primary-rgb), 0.07), rgba(var(--app-primary-rgb), 0.03));
            border-color: rgba(var(--app-primary-rgb), 0.22);
        }

        .pivot-fields-card .pivot-panel-card__title-wrap {
            margin-bottom: 0.3rem;
        }

        .pivot-zone-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 0.55rem;
        }

        .pivot-zone {
            border: 1px solid rgba(var(--app-primary-rgb), 0.24);
            border-radius: 10px;
            background: var(--app-surface-muted);
            min-height: 88px;
            display: flex;
            flex-direction: column;
        }

        :root[data-bs-theme="dark"] .pivot-zone {
            background: rgba(49, 50, 74, 0.8);
            border-color: rgba(156, 140, 252, 0.3);
        }

        .pivot-zone__title {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.5rem 0.65rem;
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--app-heading);
            border-bottom: 1px solid rgba(var(--app-primary-rgb), 0.18);
            background: rgba(var(--app-primary-rgb), 0.08);
            border-top-left-radius: 10px;
            border-top-right-radius: 10px;
        }

        .pivot-zone__drop {
            padding: 0.42rem;
            min-height: 52px;
            display: flex;
            gap: 0.32rem;
            flex-wrap: wrap;
            align-content: flex-start;
        }

        .pivot-zone__drop.is-over {
            background: rgba(var(--app-primary-rgb), 0.12);
        }

        .pivot-tag {
            border: 1px solid rgba(var(--app-primary-rgb), 0.28);
            border-radius: 999px;
            background: var(--app-surface);
            color: var(--app-heading);
            font-size: 0.76rem;
            font-weight: 600;
            line-height: 1.2;
            padding: 0.3rem 0.58rem;
            display: inline-flex;
            align-items: center;
            gap: 0.38rem;
            cursor: grab;
        }

        :root[data-bs-theme="dark"] .pivot-tag {
            border-color: rgba(156, 140, 252, 0.35);
            background: rgba(156, 140, 252, 0.12);
        }

        .pivot-tag__meta {
            font-size: 0.68rem;
            color: var(--app-primary);
            background: rgba(var(--app-primary-rgb), 0.11);
            border-radius: 999px;
            padding: 0.15rem 0.35rem;
        }

        .pivot-tag__remove {
            border: 0;
            background: transparent;
            color: #8a8da8;
            padding: 0;
            line-height: 1;
            font-size: 0.8rem;
        }

        .pivot-report-wrap {
            border: 1px solid var(--app-border);
            border-radius: 12px;
            background: var(--app-surface);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        :root[data-bs-theme="dark"] .pivot-report-wrap {
            border-color: rgba(58, 61, 88, 0.9);
        }

        #analizCalismaAlani.pivot-kayit-odak > .col-12.col-xl-2 {
            display: none;
        }

        #analizCalismaAlani.pivot-kayit-odak > .col-12.col-xl-10 {
            flex: 0 0 100%;
            max-width: 100%;
        }

        #analizCalismaAlani.pivot-kayit-odak .pivot-save-row {
            display: none;
        }

        .pivot-view-stage {
            position: relative;
            overflow: hidden;
        }

        .pivot-view-panel {
            position: absolute;
            inset: 0;
            transition: transform 0.34s ease, opacity 0.34s ease;
            background: var(--app-surface);
        }

        .pivot-view-panel--table {
            position: relative;
        }

        .pivot-view-panel--table {
            transform: translateX(0);
            opacity: 1;
        }

        .pivot-view-panel--chart {
            transform: translateX(100%);
            opacity: 0;
            padding: 0.7rem;
        }

        .pivot-view-stage.is-chart .pivot-view-panel--table {
            transform: translateX(-100%);
            opacity: 0;
        }

        .pivot-view-stage.is-chart .pivot-view-panel--chart {
            transform: translateX(0);
            opacity: 1;
        }

        #pivotTableHolder {
            overflow-x: auto;
            overflow-y: hidden;
            -webkit-overflow-scrolling: touch;
            padding-bottom: 0.2rem;
        }

        .pivot-report-actions {
            padding: 0.58rem 0.7rem;
            border-bottom: 1px solid var(--app-border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: var(--app-surface);
        }

        .pivot-report-actions .pivot-report-title {
            display: flex;
            align-items: center;
            color: #2c3e50;
            font-size: 15px;
            font-weight: 600;
            white-space: nowrap;
            min-width: 0;
        }

        .pivot-report-actions .pivot-report-title span {
            display: inline-block;
            line-height: 1.2;
        }

        .pivot-filter-dropdown-menu {
            min-width: 340px;
            border: 1px solid rgba(var(--app-primary-rgb), 0.2);
            border-radius: 10px;
            background: var(--app-surface);
            box-shadow: 0 0.4rem 1rem rgba(115, 103, 240, 0.12);
        }

        :root[data-bs-theme="dark"] .pivot-filter-dropdown-menu {
            border-color: rgba(156, 140, 252, 0.25);
            box-shadow: 0 0.4rem 1rem rgba(0, 0, 0, 0.3);
        }

        .pivot-filter-dropdown-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 0.45rem;
        }

        .pivot-filter-control label {
            margin-bottom: 0.16rem;
            font-size: 0.72rem;
            font-weight: 700;
            color: var(--app-heading);
        }

        .pivot-filter-search {
            width: 100%;
            min-height: 30px;
            font-size: 0.79rem;
            border-radius: 8px;
            border: 1px solid rgba(var(--app-primary-rgb), 0.22);
            background: rgba(var(--app-primary-rgb), 0.04);
            color: var(--app-heading);
            padding: 0.34rem 0.55rem;
        }

        .pivot-filter-search:focus {
            outline: 0;
            border-color: rgba(var(--app-primary-rgb), 0.48);
            box-shadow: 0 0 0 0.16rem rgba(var(--app-primary-rgb), 0.14);
        }

        .pivot-filter-list {
            max-height: 220px;
            overflow: auto;
            margin-top: 0.35rem;
            border: 1px solid rgba(var(--app-primary-rgb), 0.14);
            border-radius: 10px;
            background: rgba(var(--app-primary-rgb), 0.025);
            padding: 0.2rem;
        }

        .pivot-filter-option {
            display: flex;
            align-items: center;
            gap: 0.42rem;
            padding: 0.28rem 0.34rem;
            border-radius: 8px;
            font-size: 0.78rem;
            color: var(--app-heading);
            line-height: 1.2;
            cursor: pointer;
        }

        .pivot-filter-option:hover {
            background: rgba(var(--app-primary-rgb), 0.12);
        }

        .pivot-filter-option input[type="checkbox"] {
            accent-color: var(--app-primary);
            cursor: pointer;
        }

        .pivot-filter-empty {
            font-size: 0.74rem;
            color: var(--app-muted);
            padding: 0.42rem;
        }

        .pivot-dim-combobox {
            position: fixed;
            z-index: 1085;
            width: 280px;
            max-width: calc(100vw - 24px);
            border: 1px solid rgba(var(--app-primary-rgb), 0.22);
            border-radius: 12px;
            background: var(--app-surface);
            box-shadow: 0 0.55rem 1.2rem rgba(115, 103, 240, 0.18);
            padding: 0.55rem;
        }

        .pivot-dim-combobox__title {
            font-size: 0.78rem;
            font-weight: 700;
            color: var(--app-heading);
            margin-bottom: 0.38rem;
        }

        .pivot-dim-combobox__list {
            max-height: 230px;
            overflow: auto;
            border: 1px solid rgba(var(--app-primary-rgb), 0.14);
