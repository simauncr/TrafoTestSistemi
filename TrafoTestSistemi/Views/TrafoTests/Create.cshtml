@model TrafoTestSistemi.Models.TrafoTest
@{
    ViewData["Title"] = "Yeni Test Kaydı";
    var indexUrl = Url.Action("Index", "TrafoTests") ?? "/";
}

<div class="container-fluid mt-3">
    <div class="app-page-header mb-3">
        <div>
            <span class="app-page-header__eyebrow">Yeni Test Kaydı</span>
        </div>
    </div>

    <div class="card app-card-muted">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold">TRANSFORMATÖR TASARIM VE TEST KARŞILAŞTIRMA FORMU</h6>
            <div class="d-flex align-items-center gap-2">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-3">İptal</a>
                <button type="submit" class="btn btn-sm btn-success px-4 shadow fw-bold" form="trafoForm">Kaydı Tamamla</button>
            </div>
        </div>
        <div class="card-body p-3 p-lg-4">
            <form asp-action="Create" method="post" id="trafoForm" class="trafo-form-shell" novalidate>
                @Html.AntiForgeryToken()

                @await Html.PartialAsync("_TrafoForm", Model)

                <div class="trafo-form-actions mt-4">
                    <div class="trafo-form-actions__meta">Kayıt oluşturulduğunda sonuç ve sapma alanları sunucu tarafında tekrar hesaplanır.</div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            function serializeFormWithoutBlankNumerics($form) {
                const disabled = [];

                // Always exclude calculated output fields (server recalculates anyway)
                const calculatedSelector = "input.out-s-val, input.out-w-sapma, input.out-ht, input.out-gh, input.out-gt";
                $form.find(calculatedSelector).each(function () {
                    const $el = $(this);
                    if (!$el.prop("disabled")) {
                        $el.prop("disabled", true);
                        disabled.push($el);
                    }
                });

                // Exclude blank numeric inputs to prevent binding "" -> double errors
                $form.find("input.numeric-input").each(function () {
                    const $el = $(this);
                    const v = ($el.val() ?? "").toString().trim();
                    if (v === "" && !$el.prop("disabled")) {
                        $el.prop("disabled", true);
                        disabled.push($el);
                    }
                });

                const data = $form.serialize();
                disabled.forEach($el => $el.prop("disabled", false));
                return data;
            }

            $("#trafoForm").on("submit", function (e) {
                e.preventDefault();
                const form = $(this);
                if (!form[0].checkValidity()) { form.addClass('was-validated'); return; }
                $.ajax({
                    url: form.attr("action"),
                    type: "POST",
                    data: serializeFormWithoutBlankNumerics(form),
                    success: function () {
                        Swal.fire({ icon: 'success', title: 'Başarılı!', text: 'Kayıt oluşturuldu.', timer: 1500, showConfirmButton: false })
                        .then(() => window.location.href = "@indexUrl");
                    },
                    error: function () { Swal.fire({ icon: 'error', title: 'Hata!', text: 'Kayıt sırasında hata oluştu.' }); }
                });
            });
        });
    </script>
}