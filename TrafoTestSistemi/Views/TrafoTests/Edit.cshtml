@model TrafoTestSistemi.Models.TrafoTest
@{
    ViewData["Title"] = "Kaydı Düzenle";
    var indexUrl = Url.Action("Index", "TrafoTests") ?? "/";
}

<div class="container-fluid mt-3">
    <div class="app-page-header mb-3">
        <div>
            <span class="app-page-header__eyebrow">Kaydı Düzenle</span>
        </div>
    </div>

    <div class="card app-card-muted">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-3">
            <h6 class="mb-0 fw-bold">TRANSFORMATÖR TASARIM VE TEST DÜZENLEME FORMU</h6>
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <!-- Analiz Dışı Bırak Switch -->
                <div class="d-flex align-items-center gap-2">
                    <label class="form-label mb-0 fw-5" for="switchIsExcluded" style="font-size: 0.9rem;">Analizlerden Muaf Tut</label>
                    <div class="form-check form-switch switch-exclude">
                        <input class="form-check-input" type="checkbox" id="switchIsExcluded" @(Model.IsExcluded ? "checked" : null) style="cursor: pointer;">
                    </div>
                </div>
                <!-- Buttons -->
                <div class="d-flex align-items-center gap-2">
                    <button type="button" id="btnFarkliKaydet" class="btn btn-sm btn-info px-4 shadow fw-bold" form="trafoEditForm">Farklı Kaydet</button>
                    <button type="submit" class="btn btn-sm btn-primary px-5 shadow fw-bold" form="trafoEditForm">Değişiklikleri Kaydet</button>
                    <span class="badge bg-body-tertiary text-body border" style="font-size: 0.7rem;">ID: @Model.Id</span>
                </div>
            </div>
        </div>
        <div class="card-body p-3 p-lg-4">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="trafoEditForm" class="trafo-form-shell" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" id="OriginalId" />
                <input type="hidden" asp-for="IsExcluded" id="IsExcludedHidden" />

                @await Html.PartialAsync("_TrafoForm", Model)
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            function syncIsExcludedHidden() {
                $("#IsExcludedHidden").val($("#switchIsExcluded").is(":checked") ? "true" : "false");
            }

            syncIsExcludedHidden();

            // Handle IsExcluded switch change
            $("#switchIsExcluded").on("change", function () {
                syncIsExcludedHidden();
                if ($(this).is(":checked")) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Dikkat!',
                        text: 'Bu kayıt istatistiksel raporlara dahil edilmeyecektir.',
                        confirmButtonText: 'Tamam',
                        confirmButtonColor: '#7367f0'
                    });
                }
            });

            function serializeFormWithoutBlankNumerics($form) {
                const disabled = [];

                // Always exclude calculated output fields (server recalculates anyway)
                const calculatedSelector = "input.out-s-val, input.out-w-sapma, input.out-ht, input.out-gh, input.out-gt";
                $form.find(calculatedSelector).each(function () {
                    const $el = $(this);
                    if (!$el.prop("disabled")) {
                        $el.prop("disabled", true);
                        disabled.push($el);
                    }
                });

                // Exclude blank numeric inputs to prevent binding "" -> double errors
                $form.find("input.numeric-input").each(function () {
                    const $el = $(this);
                    const v = ($el.val() ?? "").toString().trim();
                    if (v === "" && !$el.prop("disabled")) {
                        $el.prop("disabled", true);
                        disabled.push($el);
                    }
                });

                const data = $form.serialize();
                disabled.forEach($el => $el.prop("disabled", false));
                return data;
            }

            $("#trafoEditForm").on("submit", function (e) {
                e.preventDefault();
                const form = $(this);
                if (!form[0].checkValidity()) { form.addClass('was-validated'); return; }
                $.ajax({
                    url: form.attr("action"),
                    type: "POST",
                    data: serializeFormWithoutBlankNumerics(form),
                    success: function (res) {
                        if (res && res.success) {
                            Swal.fire({ icon: 'success', title: 'Güncellendi!', text: 'Değişiklikler kaydedildi.', timer: 1500, showConfirmButton: false });
                            return;
                        }

                        Swal.fire({ icon: 'error', title: 'Hata!', text: (res && res.message) ? res.message : 'Güncelleme sırasında hata oluştu.' });
                    },
                    error: function (xhr) {
                        let message = 'Güncelleme sırasında hata oluştu.';
                        let details = null;
                        if (xhr && xhr.responseJSON) {
                            if (xhr.responseJSON.message) {
                                message = xhr.responseJSON.message;
                            }

                            if (xhr.responseJSON.errors) {
                                const lines = [];
                                Object.keys(xhr.responseJSON.errors).forEach(function (field) {
                                    const arr = xhr.responseJSON.errors[field] || [];
                                    arr.forEach(function (msg) {
                                        lines.push(field + ': ' + msg);
                                    });
                                });
                                if (lines.length) {
                                    details = lines.join('\n');
                                }
                            }
                        }

                        Swal.fire({ icon: 'error', title: 'Hata!', text: message, footer: details ? ('<pre style="text-align:left; white-space:pre-wrap; margin:0;">' + details + '</pre>') : undefined });
                    }
                });
            });

            $("#btnFarkliKaydet").on("click", function () {
                const currentName = $("#ProjeAdi").val();
                const editForm = $("#trafoEditForm");
                const disabled = [];

                // Always exclude calculated output fields
                const calculatedSelector = "input.out-s-val, input.out-w-sapma, input.out-ht, input.out-gh, input.out-gt";
                editForm.find(calculatedSelector).each(function () {
                    const $el = $(this);
                    if (!$el.prop("disabled")) {
                        $el.prop("disabled", true);
                        disabled.push($el);
                    }
                });

                // Exclude blank numeric inputs
                editForm.find("input.numeric-input").each(function () {
                    const $el = $(this);
                    const v = ($el.val() ?? "").toString().trim();
                    if (v === "" && !$el.prop("disabled")) {
                        $el.prop("disabled", true);
                        disabled.push($el);
                    }
                });

                let formData = editForm.serializeArray();
                disabled.forEach($el => $el.prop("disabled", false));
                formData = formData.filter(item => item.name !== "Id");
                formData.push({ name: "Id", value: 0 }, { name: "YeniProjeAdi", value: currentName });
                $.post("@Url.Action("SaveAs", "TrafoTests")", formData, function() {
                    Swal.fire({ icon: 'success', title: 'Başarılı!', text: 'Yeni kayıt oluşturuldu.', timer: 1000, showConfirmButton: false })
                    .then(() => window.location.href = "@indexUrl");
                });
            });
        });
    </script>
}