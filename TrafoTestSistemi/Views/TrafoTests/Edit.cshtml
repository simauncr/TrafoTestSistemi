@model TrafoTestSistemi.Models.TrafoTest
@{
    ViewData["Title"] = "Kaydı Düzenle";
    var indexUrl = Url.Action("Index", "TrafoTests") ?? "/";
}

<div class="container-fluid mt-3">
    <div class="card shadow border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2">
            <h6 class="mb-0">TRANSFORMATÖR TASARIM VE TEST DÜZENLEME FORMU</h6>
            <span class="badge bg-light text-dark" style="font-size: 0.7rem;">ID: @Model.Id</span>
        </div>
        <div class="card-body bg-light p-2">
            <form asp-action="Edit" method="post" id="trafoEditForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" id="OriginalId" />

                @await Html.PartialAsync("_TrafoForm", Model)

                <div class="mt-4 d-flex justify-content-between pb-5">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-4">Geri Dön</a>
                    <div>
                        <button type="button" id="btnFarkliKaydet" class="btn btn-sm btn-info px-4 shadow fw-bold me-2">Farklı Kaydet</button>
                        <button type="submit" class="btn btn-sm btn-primary px-5 shadow fw-bold">Değişiklikleri Kaydet</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#trafoEditForm").on("submit", function (e) {
                e.preventDefault();
                const form = $(this);
                if (!form[0].checkValidity()) { form.addClass('was-validated'); return; }
                $.ajax({
                    url: form.attr("action"),
                    type: "POST",
                    data: form.serialize(),
                    success: function () {
                        Swal.fire({ icon: 'success', title: 'Güncellendi!', text: 'Değişiklikler kaydedildi.', timer: 1500, showConfirmButton: false });
                    },
                    error: function () { Swal.fire({ icon: 'error', title: 'Hata!', text: 'Güncelleme sırasında hata oluştu.' }); }
                });
            });

            $("#btnFarkliKaydet").on("click", function () {
                const currentName = $("#ProjeAdi").val();
                let formData = $("#trafoEditForm").serializeArray();
                formData = formData.filter(item => item.name !== "Id");
                formData.push({ name: "Id", value: 0 }, { name: "YeniProjeAdi", value: currentName });
                $.post("@Url.Action("SaveAs", "TrafoTests")", formData, function() {
                    Swal.fire({ icon: 'success', title: 'Başarılı!', text: 'Yeni kayıt oluşturuldu.', timer: 1000, showConfirmButton: false })
                    .then(() => window.location.href = "@indexUrl");
                });
            });
        });
    </script>
}