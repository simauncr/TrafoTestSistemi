@model TrafoTestSistemi.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Şifre Değiştir";
    var currentPassword = Model?.CurrentPassword ?? string.Empty;
    var newPassword = Model?.NewPassword ?? string.Empty;
    var confirmPassword = Model?.ConfirmPassword ?? string.Empty;
}

<div class="container mt-4" style="max-width:680px;">
    <div class="app-page-header mb-3">
        <div>
            <span class="app-page-header__eyebrow">Şifre Değiştir</span>
        </div>
    </div>

    @if (TempData["Basari"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["Basari"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="app-form-shell">
        <div class="card app-card-muted">
            <div class="card-header text-center">
                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-key me-2"></i>Şifre Güncelle</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="ChangePassword" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-body-tertiary"><i class="fa-solid fa-lock text-muted"></i></span>
                            <input id="@Html.IdFor(m => m.CurrentPassword)" name="@Html.NameFor(m => m.CurrentPassword)" type="password" value="@currentPassword" class="form-control" autocomplete="off" />
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-body-tertiary"><i class="fa-solid fa-key text-muted"></i></span>
                            <input id="@Html.IdFor(m => m.NewPassword)" name="@Html.NameFor(m => m.NewPassword)" type="password" value="@newPassword" class="form-control" autocomplete="off" />
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-body-tertiary"><i class="fa-solid fa-shield-halved text-muted"></i></span>
                            <input id="@Html.IdFor(m => m.ConfirmPassword)" name="@Html.NameFor(m => m.ConfirmPassword)" type="password" value="@confirmPassword" class="form-control" autocomplete="off" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-controller="TrafoTests" asp-action="Index" class="btn btn-outline-secondary px-4">İptal</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Güncelle
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}