@model TrafoTestSistemi.Models.Kullanici

@{
    ViewData["Title"] = "Kullanıcı Sil";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

<div class="container mt-4" style="max-width:520px;">
    <div class="card shadow border-0">
        <div class="card-header bg-danger text-white text-center py-3">
            <h5 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Kullanıcıyı Sil</h5>
        </div>
        <div class="card-body p-4 text-center">
            <p class="fs-5 mb-1">Aşağıdaki kullanıcıyı silmek istediğinize emin misiniz?</p>
            <p class="text-muted small mb-4">Bu işlem geri alınamaz.</p>

            <div class="bg-light rounded p-3 mb-4 text-start">
                <div class="row mb-2">
                    <div class="col-5 text-muted fw-semibold">Ad Soyad</div>
                    <div class="col-7">@Model.AdSoyad</div>
                </div>
                <div class="row mb-2">
                    <div class="col-5 text-muted fw-semibold">Kullanıcı Adı</div>
                    <div class="col-7">@Model.KullaniciAdi</div>
                </div>
                <div class="row">
                    <div class="col-5 text-muted fw-semibold">E-posta</div>
                    <div class="col-7">@Model.Email</div>
                </div>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-center gap-3">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">İptal</a>
                    <button type="submit" class="btn btn-danger px-4 fw-bold shadow-sm">
                        <i class="fas fa-trash-alt me-1"></i> Evet, Sil
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
