@model TrafoTestSistemi.Models.Kullanici

@{
    ViewData["Title"] = "Yeni Kullanıcı Ekle";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

<div class="container mt-4" style="max-width:600px;">
    <div class="card shadow border-0">
        <div class="card-header bg-dark text-white text-center py-3">
            <h5 class="mb-0"><i class="fas fa-user-plus me-2"></i>Yeni Kullanıcı Ekle</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post" id="kullaniciForm" novalidate>
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="AdSoyad" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fas fa-user text-muted"></i></span>
                        <input asp-for="AdSoyad" class="form-control" placeholder="Ad ve soyadı giriniz" />
                    </div>
                    <span asp-validation-for="AdSoyad" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fas fa-envelope text-muted"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="E-posta adresini giriniz" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="KullaniciAdi" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fas fa-id-badge text-muted"></i></span>
                        <input asp-for="KullaniciAdi" class="form-control" placeholder="Kullanıcı adını giriniz" />
                    </div>
                    <span asp-validation-for="KullaniciAdi" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Sifre" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fas fa-lock text-muted"></i></span>
                        <input asp-for="Sifre" type="password" class="form-control" placeholder="Şifre giriniz" />
                    </div>
                    <span asp-validation-for="Sifre" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">İptal</a>
                    <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                        <i class="fas fa-save me-1"></i> Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <partial name="_ValidationScriptsPartial" />
}
