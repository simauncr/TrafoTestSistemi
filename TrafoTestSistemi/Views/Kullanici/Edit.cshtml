@model TrafoTestSistemi.Models.Kullanici

@{
    ViewData["Title"] = "Kullanıcı Düzenle";
}

<div class="container mt-4" style="max-width:600px;">
    <div class="app-form-shell">
    <div class="card app-card-muted">
        <div class="card-header text-center">
            <h5 class="mb-0 fw-bold"><i class="fa-solid fa-user-pen me-2"></i>Kullanıcı Düzenle</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post" id="editForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="AdSoyad" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-body-tertiary"><i class="fa-solid fa-user text-muted"></i></span>
                        <input asp-for="AdSoyad" class="form-control" />
                    </div>
                    <span asp-validation-for="AdSoyad" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-body-tertiary"><i class="fa-solid fa-envelope text-muted"></i></span>
                        <input asp-for="Email" class="form-control" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="KullaniciAdi" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-body-tertiary"><i class="fa-solid fa-id-badge text-muted"></i></span>
                        <input asp-for="KullaniciAdi" class="form-control" />
                    </div>
                    <span asp-validation-for="KullaniciAdi" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Sifre" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-body-tertiary"><i class="fa-solid fa-lock text-muted"></i></span>
                        <input asp-for="Sifre" type="password" class="form-control" />
                    </div>
                    <span asp-validation-for="Sifre" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">İptal</a>
                    <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Güncelle
                    </button>
                </div>
            </form>
        </div>
    </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
