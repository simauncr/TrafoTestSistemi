@model IEnumerable<TrafoTestSistemi.Models.Kullanici>

@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark fw-bold"><i class="fas fa-users text-primary me-2"></i>Kullanıcı Yönetimi</h2>
        <a asp-action="Create" class="btn btn-primary shadow-sm fw-bold px-4">
            <i class="fas fa-user-plus me-1"></i> Yeni Kullanıcı Ekle
        </a>
    </div>

    @if (TempData["Basari"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Basari"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow border-0 p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-dark text-white">
                    <tr>
                        <th class="ps-4">#</th>
                        <th>Ad Soyad</th>
                        <th>Kullanıcı Adı</th>
                        <th>E-posta</th>
                        <th class="text-center pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kullanici in Model)
                    {
                        <tr>
                            <td class="ps-4 text-muted">@kullanici.Id</td>
                            <td class="fw-semibold">@kullanici.AdSoyad</td>
                            <td>@kullanici.KullaniciAdi</td>
                            <td>@kullanici.Email</td>
                            <td class="text-center pe-4">
                                <a asp-action="Edit" asp-route-id="@kullanici.Id"
                                   class="btn btn-sm btn-outline-primary me-1">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@kullanici.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="fas fa-info-circle me-1"></i> Henüz kayıtlı kullanıcı bulunmamaktadır.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
