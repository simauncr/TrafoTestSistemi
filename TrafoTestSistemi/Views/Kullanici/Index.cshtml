@model IEnumerable<TrafoTestSistemi.Models.Kullanici>

@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

<div class="container-fluid">
    <div class="app-page-header">
        <div>
            <span class="app-page-header__eyebrow">Kullanıcı Yönetimi</span>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm fw-bold px-4">
            <i class="fa-solid fa-user-plus me-1"></i> Yeni Kullanıcı Ekle
        </a>
    </div>

    @if (TempData["Basari"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["Basari"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card app-compact-table">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">#</th>
                        <th>Ad Soyad</th>
                        <th>Kullanıcı Adı</th>
                        <th>E-posta</th>
                        <th class="text-center pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kullanici in Model)
                    {
                        <tr>
                            <td class="ps-4 text-muted">@kullanici.Id</td>
                            <td class="fw-semibold">@kullanici.AdSoyad</td>
                            <td>@kullanici.KullaniciAdi</td>
                            <td>@kullanici.Email</td>
                            <td class="text-center pe-4">
                                <a asp-action="Edit" asp-route-id="@kullanici.Id"
                                   class="btn btn-sm btn-outline-primary me-1">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@kullanici.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    <i class="fa-solid fa-trash-can"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="py-0">
                                <div class="app-empty-state">
                                    <i class="fa-solid fa-circle-info"></i>
                                    <div>Henüz kayıtlı kullanıcı bulunmamaktadır.</div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
