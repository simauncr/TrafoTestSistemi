@model IEnumerable<TrafoTestSistemi.Models.Kullanici>

@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

<div class="container-fluid mt-3">
    @Html.AntiForgeryToken()
    <div class="app-page-header mb-3">
        <div>
            <span class="app-page-header__eyebrow">Kullanıcı Yönetimi</span>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm fw-bold px-4">
            <i class="fa-solid fa-user-plus me-1"></i> Yeni Kullanıcı Ekle
        </a>
    </div>

    @if (TempData["Basari"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["Basari"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card app-compact-table">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="kullaniciTable">
                <thead>
                    <tr>
                        <th class="ps-4">#</th>
                        <th>Ad Soyad</th>
                        <th>Kullanıcı Adı</th>
                        <th>E-posta</th>
                        <th class="text-center pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kullanici in Model)
                    {
                        <tr data-kullanici-row="@kullanici.Id">
                            <td class="ps-4 text-muted">@kullanici.Id</td>
                            <td class="fw-semibold">@kullanici.AdSoyad</td>
                            <td>@kullanici.KullaniciAdi</td>
                            <td>@kullanici.Email</td>
                            <td class="text-center pe-4">
                                <a asp-action="Edit" asp-route-id="@kullanici.Id"
                                   class="btn btn-sm btn-outline-primary me-1">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                <button type="button"
                                   class="btn btn-sm btn-outline-danger js-delete-kullanici"
                                   data-id="@kullanici.Id"
                                   data-name="@kullanici.AdSoyad">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr data-empty-users-row>
                            <td colspan="5" class="py-0">
                                <div class="app-empty-state">
                                    <i class="fa-solid fa-circle-info"></i>
                                    <div>Henüz kayıtlı kullanıcı bulunmamaktadır.</div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const deleteAnimationMs = 230;

            $('.js-delete-kullanici').on('click', async function () {
                const $button = $(this);
                const id = $button.data('id');
                const adSoyad = $button.data('name');
                const token = $('input[name="__RequestVerificationToken"]').first().val();

                const result = await Swal.fire({
                    icon: 'warning',
                    title: 'Kullanıcı silinsin mi?',
                    text: `${adSoyad} kaydı kaldırılacak.`,
                    showCancelButton: true,
                    confirmButtonText: 'Sil',
                    cancelButtonText: 'Vazgeç'
                });

                if (!result.isConfirmed) {
                    return;
                }

                try {
                    const response = await fetch(`/Kullanici/Delete/${id}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                            'RequestVerificationToken': token,
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: `__RequestVerificationToken=${encodeURIComponent(token)}`
                    });

                    const payload = await response.json();
                    if (!response.ok || !payload.success) {
                        throw new Error(payload.message || 'Silme işlemi sırasında hata oluştu.');
                    }

                    const $row = $(`[data-kullanici-row="${id}"]`);
                    $row.addClass('app-row-removing');
                    await new Promise(resolve => setTimeout(resolve, deleteAnimationMs));
                    $row.remove();

                    if ($('#kullaniciTable tbody tr[data-kullanici-row]').length === 0 && $('#kullaniciTable tbody tr[data-empty-users-row]').length === 0) {
                        $('#kullaniciTable tbody').append(`
                            <tr data-empty-users-row>
                                <td colspan="5" class="py-0">
                                    <div class="app-empty-state">
                                        <i class="fa-solid fa-circle-info"></i>
                                        <div>Henüz kayıtlı kullanıcı bulunmamaktadır.</div>
                                    </div>
                                </td>
                            </tr>`);
                    }

                    await Swal.fire({
                        icon: 'success',
                        title: 'Silindi',
                        text: payload.message,
                        timer: 1400,
                        showConfirmButton: false
                    });
                } catch (error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Hata',
                        text: error.message || 'Silme işlemi sırasında hata oluştu.'
                    });
                }
            });
        });
    </script>
}
