@{
    var title = (ViewData["Title"]?.ToString() ?? "").Trim();
    var aktifKullanici = Context.Session.GetString("User");
    var userText = string.IsNullOrEmpty(aktifKullanici) ? "Ziyaretçi" : aktifKullanici;
}

<header class="app-topbar border-bottom bg-body">
    <div class="container-fluid px-3 px-lg-4">
        <div class="d-flex align-items-center justify-content-between py-2 py-lg-3">
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-outline-secondary d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar" aria-controls="mobileSidebar" aria-label="Menüyü Aç">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <div class="d-flex flex-column">
                    <div class="app-topbar__title fw-semibold text-dark">@(string.IsNullOrEmpty(title) ? "Trafo Test Sistemi" : title)</div>
                    <div class="app-topbar__subtitle text-muted small">Trafo test analiz ve takip</div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small d-none d-sm-inline-flex align-items-center gap-2">
                    <i class="fa-solid fa-circle-user"></i>
                    <span>@userText</span>
                </span>
                <a class="btn btn-sm btn-outline-danger" asp-controller="Account" asp-action="Logout">Güvenli Çıkış</a>
            </div>
        </div>
    </div>
</header>
